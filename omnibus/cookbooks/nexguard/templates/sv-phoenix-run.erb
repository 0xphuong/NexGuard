#!/bin/sh
exec 2>&1

export PATH=<%= node['nexguard']['install_directory'] %>/embedded/bin:$PATH
export LD_LIBRARY_PATH=<%= node['nexguard']['install_directory'] %>/embedded/lib
export DIR=<%= node['nexguard']['app_directory'] %>
export HOME=$DIR
<%= "export OPENSSL_FIPS=1" if node['nexguard']['fips_enabled'] == true %>
<%= NexGuard::Config.locale_variables %>

cd $DIR

exec <%= node['runit']['chpst_bin'] %> \
  -e <%= node['nexguard']['install_directory'] %>/sv/phoenix/env \
  -P \
  -U <%= node['nexguard']['user'] %>:<%= node['nexguard']['group'] %> \
  -u <%= node['nexguard']['user'] %>:<%= node['nexguard']['group'] %> \
  bin/nexguard start <%= '> /dev/null 2>&1' unless node['nexguard']['logging']['enabled'] %>
