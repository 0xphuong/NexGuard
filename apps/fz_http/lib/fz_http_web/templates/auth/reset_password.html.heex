<div class="auth-card">
  <div class="auth-card-header">
    <div class="auth-icon-badge">
      <span class="mdi mdi-email-fast-outline"></span>
    </div>
    <h1 class="auth-title">Reset Password</h1>
    <p class="auth-subtitle">We'll send a magic link to your inbox</p>
  </div>
  <div class="auth-card-body">
    <%= link to: ~p"/", class: "auth-back-link" do %>
      <span class="mdi mdi-arrow-left"></span> Back to sign in
    <% end %>

    <%= form_tag ~p"/auth/magic_link", method: "post", class: "auth-form" do %>
      <div class="auth-field">
        <label for="email" class="auth-label">Email address</label>
        <div class="auth-input-wrap">
          <span class="mdi mdi-email-outline auth-input-icon"></span>
          <input
            class="auth-input"
            type="email"
            name="email"
            id="email"
            required
            autocomplete="email"
            placeholder="admin@company.com"
          />
        </div>
        <p class="auth-hint">A single-use magic link will be sent to this address.</p>
      </div>

      <div class="auth-form-actions">
        <%= submit "Send Magic Link", class: "auth-submit-btn" %>
      </div>
    <% end %>
  </div>
</div>
