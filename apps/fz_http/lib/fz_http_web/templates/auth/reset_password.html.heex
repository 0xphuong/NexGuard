<%= link("← Back", to: ~p"/", class: "ng-back") %>

<h1 class="ng-auth-title">Reset Password</h1>
<p class="ng-auth-subtitle">Enter your email and we'll send a single-use magic link to sign in.</p>

<%= form_tag ~p"/auth/magic_link", method: "post" do %>
  <div class="ng-field">
    <label for="email" class="ng-label">Email address</label>
    <input
      class="ng-input"
      type="email"
      name="email"
      id="email"
      required
      autocomplete="email"
      placeholder="you@example.com"
    />
  </div>

  <div class="ng-btn-wrap">
    <%= submit("Send Magic Link", class: "ng-btn ng-btn-primary") %>
  </div>
<% end %>
