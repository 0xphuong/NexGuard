<div class="auth-card">
  <div class="auth-card-header">
    <div class="auth-icon-badge">
      <span class="mdi mdi-email-lock"></span>
    </div>
    <h1 class="auth-title">Sign In</h1>
    <p class="auth-subtitle">Enter your credentials to continue</p>
  </div>
  <div class="auth-card-body">
    <%= link to: ~p"/", class: "auth-back-link" do %>
      <span class="mdi mdi-arrow-left"></span> All sign-in methods
    <% end %>

    <%= form_tag @callback_path, method: "post", class: "auth-form" do %>
      <div class="auth-field">
        <label for="email" class="auth-label">Email address</label>
        <div class="auth-input-wrap">
          <span class="mdi mdi-email-outline auth-input-icon"></span>
          <input
            class="auth-input"
            type="email"
            name="email"
            id="email"
            required
            autocomplete="email"
            placeholder="admin@company.com"
            value={@conn.params["email"]}
          />
        </div>
      </div>

      <div class="auth-field">
        <label for="password" class="auth-label">Password</label>
        <div class="auth-input-wrap">
          <span class="mdi mdi-lock-outline auth-input-icon"></span>
          <input
            class="auth-input"
            type="password"
            name="password"
            id="password"
            required
            autocomplete="current-password"
            placeholder="••••••••"
          />
        </div>
      </div>

      <div class="auth-form-actions">
        <%= submit "Sign In", class: "auth-submit-btn" %>
        <%= link "Forgot password?", to: ~p"/auth/reset_password", class: "auth-link" %>
      </div>
    <% end %>
  </div>
</div>
