<!DOCTYPE html>
<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%= csrf_meta_tag() %>
    <.live_title>
      <%= assigns[:page_title] || "NexGuard" %>
    </.live_title>
    <link phx-track-static rel="stylesheet" href={static_path("/dist/root.css")} />
    <script defer phx-track-static type="text/javascript" src={static_path("/dist/root.js")}>
    </script>
    <%= render(FzHttpWeb.SharedView, "head.html", assigns) %>
    <style>
      /* ── NexGuard Auth Layout 2026 ── */
      :root {
        --ng-bg:         #060d1a;
        --ng-card-bg:    rgba(10, 22, 46, 0.82);
        --ng-accent:     #38bdf8;
        --ng-accent-dim: rgba(56, 189, 248, .10);
        --ng-border:     rgba(56, 189, 248, .11);
        --ng-text:       #f1f5f9;
        --ng-muted:      #64748b;
        --ng-subtle:     #94a3b8;
        --ng-radius:     10px;
      }

      *, *::before, *::after { box-sizing: border-box; }

      body.ng-auth {
        margin: 0;
        min-height: 100vh;
        font-family: "Fira Sans", "Inter", system-ui, sans-serif;
        background: var(--ng-bg);
        color: var(--ng-text);
      }

      /* Background grid + center glow */
      .ng-bg {
        position: fixed;
        inset: 0;
        background: var(--ng-bg);
        background-image:
          linear-gradient(rgba(56,189,248,.03) 1px, transparent 1px),
          linear-gradient(90deg, rgba(56,189,248,.03) 1px, transparent 1px);
        background-size: 52px 52px;
        z-index: 0;
      }

      .ng-bg::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 900px;
        height: 600px;
        background: radial-gradient(ellipse at center, rgba(56,189,248,.07) 0%, transparent 65%);
        pointer-events: none;
      }

      /* Centering shell */
      .ng-main {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 2rem 1rem;
      }

      /* Glassmorphism card — logo lives inside */
      .ng-card {
        width: 100%;
        max-width: 432px;
        background: var(--ng-card-bg);
        backdrop-filter: blur(28px);
        -webkit-backdrop-filter: blur(28px);
        border: 1px solid var(--ng-border);
        border-radius: 18px;
        padding: 2.5rem;
        box-shadow:
          0 28px 80px rgba(0,0,0,.55),
          inset 0 1px 0 rgba(255,255,255,.04);
        overflow: hidden;
      }

      /* Logo header — bleeds to card edges, white strip */
      .ng-card-logo {
        margin: -2.5rem -2.5rem 2rem;
        padding: 1.25rem 2rem;
        background: #ffffff;
        border-bottom: 1px solid rgba(56, 189, 248, .12);
        text-align: center;
      }

      .ng-card-logo img {
        display: block;
        margin: 0 auto;
        max-height: 90px;
        width: auto;
      }

      /* Flash overrides for dark bg */
      body.ng-auth .block.flash-squeeze { margin-bottom: 1.25rem; }

      body.ng-auth .notification {
        border-radius: var(--ng-radius);
        padding: .75rem 1rem;
        font-size: .875rem;
        line-height: 1.5;
        position: relative;
      }

      body.ng-auth .notification.is-info {
        background: rgba(56,189,248,.1);
        border: 1px solid rgba(56,189,248,.25);
        color: #7dd3fc;
      }

      body.ng-auth .notification.is-danger {
        background: rgba(220,38,38,.12);
        border: 1px solid rgba(220,38,38,.28);
        color: #fca5a5;
      }

      body.ng-auth .notification .delete {
        position: absolute;
        top: .6rem;
        right: .6rem;
        background: rgba(255,255,255,.1);
        border-radius: 50%;
        width: 20px;
        height: 20px;
        min-width: unset;
        min-height: unset;
      }

      body.ng-auth .notification .delete::before,
      body.ng-auth .notification .delete::after {
        background: rgba(255,255,255,.5);
      }

      /* Typography */
      .ng-auth-title {
        font-size: 1.375rem;
        font-weight: 700;
        color: var(--ng-text);
        margin: 0 0 .4rem;
        letter-spacing: -.022em;
        line-height: 1.3;
      }

      .ng-auth-subtitle {
        font-size: .875rem;
        color: var(--ng-subtle);
        margin: 0 0 1.875rem;
        line-height: 1.5;
      }

      /* Form fields */
      .ng-field { margin-bottom: 1.125rem; }

      /* #94a3b8 on dark bg ≈ 7:1 — passes AA/AAA */
      .ng-label {
        display: block;
        font-size: .775rem;
        font-weight: 600;
        color: var(--ng-subtle);
        margin-bottom: .4rem;
        letter-spacing: .06em;
        text-transform: uppercase;
      }

      .ng-input {
        width: 100%;
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(148,163,184,.15);
        border-radius: var(--ng-radius);
        color: var(--ng-text);
        font-size: .9375rem;
        padding: .6875rem .9375rem;
        outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
        font-family: inherit;
        -webkit-appearance: none;
      }

      .ng-input::placeholder { color: #475569; }

      .ng-input:focus {
        border-color: rgba(56,189,248,.55);
        box-shadow: 0 0 0 3px rgba(56,189,248,.1);
      }

      /* Buttons */
      .ng-btn {
        display: block;
        width: 100%;
        text-align: center;
        padding: .75rem 1rem;
        border-radius: var(--ng-radius);
        font-size: .9375rem;
        font-weight: 500;
        font-family: inherit;
        cursor: pointer;
        transition: opacity .15s ease, transform .12s ease, box-shadow .15s ease;
        text-decoration: none;
        border: none;
        line-height: 1.4;
        -webkit-appearance: none;
      }

      .ng-btn:hover { opacity: .87; transform: translateY(-1px); }
      .ng-btn:active { transform: translateY(0); opacity: 1; }

      .ng-btn-primary {
        background: var(--ng-accent);
        color: #060d1a;
        font-weight: 700;
        letter-spacing: .01em;
        box-shadow: 0 4px 20px rgba(56,189,248,.22);
      }

      .ng-btn-primary:hover { box-shadow: 0 6px 28px rgba(56,189,248,.36); }

      .ng-btn-outline {
        background: rgba(255,255,255,.04);
        color: var(--ng-subtle);
        border: 1px solid rgba(148,163,184,.18);
        margin-bottom: .625rem;
      }

      .ng-btn-outline:hover {
        background: rgba(255,255,255,.07);
        border-color: rgba(148,163,184,.3);
        color: #cbd5e1;
      }

      /* Divider — #64748b ≈ 3.5:1, legible */
      .ng-divider {
        display: flex;
        align-items: center;
        gap: .875rem;
        margin: 1.375rem 0;
        color: var(--ng-muted);
        font-size: .75rem;
        letter-spacing: .08em;
        text-transform: uppercase;
      }

      .ng-divider::before,
      .ng-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: rgba(148,163,184,.12);
      }

      /* Form actions: submit full-width, forgot link centered below */
      .ng-form-actions {
        margin-top: 1.375rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .875rem;
      }

      .ng-form-actions .ng-btn { width: 100%; }

      /* Spacer variant for single-button pages */
      .ng-btn-wrap { margin-top: 1.375rem; }

      .ng-link {
        color: var(--ng-accent);
        text-decoration: none;
        font-size: .8125rem;
        white-space: nowrap;
        transition: opacity .15s;
      }

      .ng-link:hover { opacity: .7; }

      /* Back link — #94a3b8 ≈ 7:1, readable */
      .ng-back {
        display: inline-flex;
        align-items: center;
        gap: .375rem;
        color: var(--ng-subtle);
        font-size: .8125rem;
        text-decoration: none;
        margin-bottom: 1.5rem;
        transition: color .15s;
      }

      .ng-back:hover { color: var(--ng-text); }

      /* Footer */
      .ng-footer {
        margin-top: 1.75rem;
        font-size: .75rem;
        color: var(--ng-muted);
        letter-spacing: .01em;
        text-align: center;
      }

      @media (max-width: 480px) {
        .ng-card { padding: 2rem 1.5rem; }
        .ng-card-logo { margin: -2rem -1.5rem 1.75rem; padding: 1rem 1.5rem; }
      }
    </style>
  </head>
  <body class="ng-auth">
    <div class="ng-bg"></div>
    <main class="ng-main">
      <div class="ng-card">
        <div class="ng-card-logo">
          <%= FzHttpWeb.LogoComponent.render(FzHttp.Config.fetch_config!(:logo)) %>
        </div>
        <%= @inner_content %>
      </div>
      <footer class="ng-footer">© 2026 NexGuard · v<%= application_version() %></footer>
    </main>
  </body>
</html>
