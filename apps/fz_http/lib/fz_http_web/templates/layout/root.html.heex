<!DOCTYPE html>
<html lang="en">
  <head>
    <%= csrf_meta_tag() %>
    <.live_title>
      <%= assigns[:page_title] || "NexGuard" %>
    </.live_title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link phx-track-static rel="stylesheet" href={static_path("/dist/root.css")} />
    <script defer phx-track-static type="text/javascript" src={static_path("/dist/root.js")}>
    </script>
    <%= render(FzHttpWeb.SharedView, "head.html", assigns) %>
    <%= csrf_meta_tag() %>
  </head>
  <body class="auth-body">
    <div class="auth-page">
      <div class="auth-branding">
        <%= FzHttpWeb.LogoComponent.render(FzHttp.Config.fetch_config!(:logo)) %>
      </div>
      <%= @inner_content %>
      <footer class="auth-footer">
        <span class="mdi mdi-shield-check"></span>
        Secured by NexGuard · Next-Gen Zero-Trust VPN
      </footer>
    </div>
  </body>
</html>
