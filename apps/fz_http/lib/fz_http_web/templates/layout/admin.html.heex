<!DOCTYPE html>
<html
  lang="en"
  class="has-aside-left has-aside-mobile-transition has-navbar-fixed-top has-aside-expanded"
>
  <head>
    <.live_title prefix="NexGuard • ">
      <%= assigns[:page_title] %>
    </.live_title>
    <link phx-track-static rel="stylesheet" href={static_path("/dist/admin.css")} />
    <script defer phx-track-static type="text/javascript" src={static_path("/dist/admin.js")}>
    </script>
    <%= render(FzHttpWeb.SharedView, "head.html", assigns) %>
    <%= render(FzHttpWeb.SharedView, "socket_token_headers.html",
      conn: @conn,
      current_user: @current_user
    ) %>
  </head>
  <body>
    <div id="app">
      <nav id="navbar-main" class="navbar is-fixed-top ng-topnav">
        <div class="navbar-brand">
          <a class="navbar-item is-hidden-desktop jb-aside-mobile-toggle ng-topnav-icon-btn">
            <span class="icon"><i class="mdi mdi-forwardburger mdi-24px"></i></span>
          </a>
        </div>
        <div class="navbar-brand is-right">
          <a class="navbar-item is-hidden-desktop jb-navbar-menu-toggle ng-topnav-icon-btn" data-target="navbar-menu">
            <span class="icon"><i class="mdi mdi-dots-vertical"></i></span>
          </a>
        </div>
        <div class="navbar-menu fadeIn animated faster" id="navbar-menu">
          <div class="navbar-end">

            <%# ── Ops signals (UI-6): live service health dots + ⌘K search ── %>
            <%# Three service dots polled by HealthMonitor every 10s.
            %# Click any → diagnostics page. Each dot is green when OK,
            %# amber when degraded, red on outage. Tooltip carries the
            %# last-known latency for forensic context. %>
            <% health = service_health() %>

            <%= for {service, label, link} <- [
                  {:db,      "DB",      ~p"/diagnostics/connectivity_checks"},
                  {:coredns, "DNS",     ~p"/diagnostics/connectivity_checks"},
                  {:proxy,   "Proxy",   ~p"/diagnostics/connectivity_checks"}
                ] do %>
              <% state = Map.get(health, service, :unknown) %>
              <a
                href={link}
                class={["ng-topnav-health", "navbar-item", "ng-topnav-icon-btn",
                        "ng-topnav-health--#{state}"]}
                title={health_tooltip(service, state, health)}
              >
                <span class="ng-status-dot"></span>
                <span class="ng-topnav-status-label"><%= label %></span>
              </a>
            <% end %>

            <%# ⌘K search trigger — keyboard shortcut handled by the
            %# CmdKShortcut hook; the visible chip doubles as a click
            %# target for trackpad / mobile users. %>
            <button
              id="cmd-k-trigger"
              phx-hook="CmdKShortcut"
              class="ng-topnav-search-trigger navbar-item ng-topnav-icon-btn"
              title="Search anything (⌘K)"
              aria-label="Open search (Command-K)"
              type="button"
            >
              <i class="mdi mdi-magnify"></i>
              <span class="ng-topnav-search-shortcut">⌘K</span>
            </button>

            <%# ── WebSocket status ── %>
            <a
              id="web-ui-connect-success"
              href="#"
              title="Secure websocket connected."
              class="navbar-item has-divider is-desktop-icon-only ng-topnav-icon-btn ng-topnav-ws-ok"
            >
              <span class="icon"><i class="mdi mdi-shield-check-outline"></i></span>
            </a>
            <a
              id="web-ui-connect-error"
              href="#"
              title="Secure websocket not connected! Check docs.nexguard.binhphuong.io.vn/administer/troubleshoot for help."
              class="is-hidden navbar-item has-divider is-desktop-icon-only ng-topnav-icon-btn ng-topnav-ws-err"
            >
              <span class="icon"><i class="mdi mdi-shield-alert-outline"></i></span>
            </a>

            <%# ── Documentation ── %>
            <a
              target="_blank"
              href="https://docs.nexguard.binhphuong.io.vn/?utm_source=product"
              title="Documentation"
              class="navbar-item has-divider is-desktop-icon-only ng-topnav-icon-btn"
            >
              <span class="icon"><i class="mdi mdi-help-circle-outline"></i></span>
            </a>

            <%# ── Notifications badge ── %>
            <%= Phoenix.Component.live_render(@conn, FzHttpWeb.NotificationsLive.Badge,
              router: FzHttpWeb.Router
            ) %>

            <%# ── Search modal (⌘K) — separate LiveView so the search
            %# state survives navigation between admin pages. Rendered
            %# hidden by default; CmdKShortcut hook toggles visibility. %>
            <%= Phoenix.Component.live_render(@conn, FzHttpWeb.SearchLive,
              router: FzHttpWeb.Router,
              id: "global-search"
            ) %>

            <%# ── User dropdown ── %>
            <div class="navbar-item has-dropdown has-dropdown-with-icons has-divider is-hoverable ng-topnav-user">
              <a class="navbar-link is-arrowless ng-topnav-user-trigger">
                <div class="ng-topnav-avatar">
                  <%= @current_user.email |> String.first() |> String.upcase() %>
                </div>
                <span class="ng-topnav-email"><%= @current_user.email %></span>
                <span class="icon"><i class="mdi mdi-chevron-down"></i></span>
              </a>
              <div class="navbar-dropdown is-right ng-topnav-dropdown">
                <%= link(to: ~p"/settings/account", class: "navbar-item ng-topnav-menu-item") do %>
                  <span class="icon"><i class="mdi mdi-account-cog-outline"></i></span>
                  <span>Account Settings</span>
                <% end %>
                <hr class="navbar-divider" />
                <%= link(to: ~p"/sign_out", method: :delete, class: "navbar-item ng-topnav-menu-item ng-topnav-signout") do %>
                  <span class="icon"><i class="mdi mdi-logout-variant"></i></span>
                  <span>Sign Out</span>
                <% end %>
              </div>
            </div>

          </div>
        </div>
      </nav>

      <%= @inner_content %>

      <footer class="ng-admin-footer">
        <div class="ng-admin-footer-inner">
          <span class="ng-footer-copyright">
            © 2026 NexGuard &mdash; Identity-Driven Network Security &amp; Access Control.
          </span>
          <a
            href={"https://github.com/0xphuong/nexguard/tree/refs/tags/#{application_version()}"}
            class="ng-footer-version"
            target="_blank"
          >
            <i class="mdi mdi-tag-outline"></i>
            v<%= application_version() %>
          </a>
        </div>
      </footer>
    </div>
  </body>
</html>
