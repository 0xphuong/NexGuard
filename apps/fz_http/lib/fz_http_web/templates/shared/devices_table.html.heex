<%# `@bulk_enabled` is opt-in — when set, the table grows a checkbox
%# column with select-all in the header. Other callers (user show
%# page, unprivileged device list) leave it unset and render the
%# original table shape.
%#
%# v3.0.9 (D-Idx-A): Status + Last Handshake collapsed into a single
%# Connection column (pending overrides connection state). Public
%# Key and Created columns dropped — public key is on the device
%# show page, created timestamp is rarely scanned daily and clutter
%# was hiding the security-meaningful signals. %>
<% bulk = assigns[:bulk_enabled] || false %>
<% selected = assigns[:selected] || MapSet.new() %>
<% all_selected = assigns[:all_selected] || false %>
<table class="ng-table">
  <thead>
    <tr>
      <%= if bulk do %>
        <th class="ng-bulk-checkbox-th">
          <input
            type="checkbox"
            class="ng-bulk-checkbox"
            phx-click="toggle_select_all"
            checked={all_selected}
            aria-label="Select all visible devices"
          />
        </th>
      <% end %>
      <th>Device</th>
      <%= if @show_user do %>
        <th>User</th>
      <% end %>
      <th>Connection</th>
      <th>Client</th>
      <th>Tunnel IPs</th>
      <th>Remote IP</th>
      <th>Transfer</th>
    </tr>
  </thead>
  <tbody>
    <%= for device <- @devices do %>
      <% state = FzHttp.Devices.connection_state(device) %>
      <tr class={[bulk and MapSet.member?(selected, device.id) and "is-row-selected",
                  state == :pending and "ng-row--pending",
                  state == :stale and "ng-row--stale"]}>
        <%= if bulk do %>
          <td class="ng-bulk-checkbox-td">
            <input
              type="checkbox"
              class="ng-bulk-checkbox"
              checked={MapSet.member?(selected, device.id)}
              phx-click="toggle_select"
              phx-value-id={device.id}
              aria-label={"Select #{device.name}"}
            />
          </td>
        <% end %>
        <td>
          <.link navigate={~p"/devices/#{device}"} class="ng-user-email">
            <i class="mdi mdi-laptop ng-device-icon"></i>
            <%= device.name %>
          </.link>
        </td>
        <%= if @show_user do %>
          <td>
            <%= live_redirect(device.user.email,
              to: ~p"/users/#{device.user}",
              class: "ng-user-email"
            ) %>
          </td>
        <% end %>
        <td>
          <span class={["ng-conn-cell", FzHttp.Devices.connection_class(state)]}>
            <i class={["mdi", FzHttp.Devices.connection_icon(state)]}></i>
            <strong><%= FzHttp.Devices.connection_label(state) %></strong>
            <%= case FzHttp.Devices.relative_handshake(device.latest_handshake) do
                  nil -> ""
                  s   -> " · " <> s
                end %>
          </span>
        </td>
        <td class="ng-td-muted">
          <div>
            <%= case {device.client_platform, device.client_version} do
                  {nil, _}       -> "—"
                  {plat, nil}    -> plat
                  {plat, ver}    -> "#{plat} · #{ver}"
                end %>
          </div>
          <% os_line =
               [
                 case {device.client_os_name, device.client_os_version} do
                   {nil, _}    -> nil
                   {name, nil} -> name
                   {name, ver} -> "#{name} #{ver}"
                 end,
                 device.client_arch
               ]
               |> Enum.reject(&is_nil/1)
               |> Enum.join(" · ") %>
          <%= if os_line != "" do %>
            <div class="ng-td-os"><%= os_line %></div>
          <% end %>
        </td>
        <td class="ng-td-mono">
          <div><%= device.ipv4 %></div>
          <div class="ng-td-muted"><%= device.ipv6 %></div>
        </td>
        <td class="ng-td-mono ng-td-muted">
          <%= device.remote_ip || "—" %>
        </td>
        <td class="ng-td-mono">
          <div class="ng-transfer-row">
            <i class="mdi mdi-arrow-down-bold ng-transfer-rx"></i>
            <%= to_human_bytes(device.rx_bytes) %>
          </div>
          <div class="ng-transfer-row">
            <i class="mdi mdi-arrow-up-bold ng-transfer-tx"></i>
            <%= to_human_bytes(device.tx_bytes) %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
