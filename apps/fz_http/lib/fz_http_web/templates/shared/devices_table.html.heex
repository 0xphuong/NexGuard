<table class="ng-table">
  <thead>
    <tr>
      <th>Device</th>
      <%= if @show_user do %>
        <th>User</th>
      <% end %>
      <th>Status</th>
      <th>Tunnel IPs</th>
      <th>Remote IP</th>
      <th>Last Handshake</th>
      <th>Transfer</th>
      <th>Public Key</th>
      <th>Created</th>
    </tr>
  </thead>
  <tbody>
    <%= for device <- @devices do %>
      <tr>
        <td>
          <.link navigate={~p"/devices/#{device}"} class="ng-user-email">
            <i class="mdi mdi-laptop ng-device-icon"></i>
            <%= device.name %>
          </.link>
        </td>
        <%= if @show_user do %>
          <td>
            <%= live_redirect(device.user.email,
              to: ~p"/users/#{device.user}",
              class: "ng-user-email"
            ) %>
          </td>
        <% end %>
        <td>
          <%= if device.status == "pending" do %>
            <span class="ng-status-badge ng-status-badge--inactive" style="background:#fef3c7;color:#92400e">
              <i class="mdi mdi-clock-outline ng-status-dot"></i> Pending
            </span>
          <% else %>
            <span class="ng-status-badge ng-status-badge--active">
              <i class="mdi mdi-check-circle ng-status-dot"></i> Approved
            </span>
          <% end %>
        </td>
        <td class="ng-td-mono">
          <div><%= device.ipv4 %></div>
          <div class="ng-td-muted"><%= device.ipv6 %></div>
        </td>
        <td class="ng-td-mono ng-td-muted"><%= device.remote_ip %></td>
        <td
          id={"device-#{device.id}-latest-handshake"}
          data-timestamp={device.latest_handshake}
          phx-hook="FormatTimestamp"
          class="ng-td-muted"
        >
          …
        </td>
        <td class="ng-td-mono">
          <div class="ng-transfer-row">
            <i class="mdi mdi-arrow-down-bold ng-transfer-rx"></i>
            <%= to_human_bytes(device.rx_bytes) %>
          </div>
          <div class="ng-transfer-row">
            <i class="mdi mdi-arrow-up-bold ng-transfer-tx"></i>
            <%= to_human_bytes(device.tx_bytes) %>
          </div>
        </td>
        <td class="ng-pubkey" title={device.public_key}>
          <%= device.public_key %>
        </td>
        <td
          id={"device-#{device.id}-inserted-at"}
          data-timestamp={device.inserted_at}
          phx-hook="FormatTimestamp"
          class="ng-td-muted"
        >
          …
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
