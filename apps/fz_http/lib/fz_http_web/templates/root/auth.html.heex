<h1 class="ng-auth-title">Secure Access</h1>
<p class="ng-auth-subtitle">Sign in to NexGuard Network</p>

<%= for provider <- @openid_connect_providers do %>
  <%= link(
    "Sign in with #{provider.label}",
    to: ~p"/auth/oidc/#{provider.id}",
    class: "ng-btn ng-btn-outline"
  ) %>
<% end %>

<%= for provider <- @saml_identity_providers do %>
  <%= link(
    "Sign in with #{provider.label}",
    to: "/auth/saml/auth/signin/#{provider.id}/",
    class: "ng-btn ng-btn-outline"
  ) %>
<% end %>

<%= if (@openid_connect_providers != [] or @saml_identity_providers != []) and @local_enabled do %>
  <div class="ng-divider">or</div>
<% end %>

<%= if @local_enabled do %>
  <%= link(
    "Sign in with Email",
    to: ~p"/auth/identity",
    class: "ng-btn ng-btn-primary"
  ) %>
<% end %>
