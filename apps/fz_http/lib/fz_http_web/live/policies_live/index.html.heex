<%= if @live_action == :new do %>
  <%= live_modal(
    FzHttpWeb.PoliciesLive.FormComponent,
    return_to: ~p"/policies",
    title: "New Policy",
    id: "policy-form-component",
    policy: nil,
    subject: @subject,
    remote_ip: @remote_ip,
    action: @live_action,
    form: "policy-form",
    button_text: "Create Policy"
  ) %>
<% end %>

<%# ── Delete Confirmation Modal ─────────────────────────────────── %>
<%= if @delete_confirm do %>
  <div class="modal is-active" phx-window-keydown="cancel_delete" phx-key="escape">
    <div class="modal-background" phx-click="cancel_delete"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">
          <i class="mdi mdi-alert-octagon ng-modal-title-icon"></i>
          Delete Policy
        </p>
        <button class="ng-modal-close" aria-label="Close" phx-click="cancel_delete">
          <i class="mdi mdi-close"></i>
        </button>
      </header>
      <section class="modal-card-body">
        <p class="ng-modal-intro">You are about to permanently delete:</p>
        <div class="ng-modal-entity"><%= @delete_confirm.name %></div>
        <p class="ng-modal-cons">This will also:</p>
        <ul class="ng-modal-list">
          <li>Remove <%= @delete_confirm.rule_count %> rule<%= if @delete_confirm.rule_count != 1, do: "s" %> inside this policy</li>
          <%= if @delete_confirm.applies_to_all_users do %>
            <li>Detach the policy from <strong>every user</strong> (global scope)</li>
          <% else %>
            <li>Un-assign <%= @delete_confirm.user_count %> user<%= if @delete_confirm.user_count != 1, do: "s" %></li>
          <% end %>
          <li>Immediately update the nftables rule set for affected users</li>
        </ul>
        <p class="ng-modal-warn">This action cannot be undone.</p>
      </section>
      <footer class="modal-card-foot">
        <button class="ng-secondary-btn" phx-click="cancel_delete">Cancel</button>
        <button class="ng-danger-btn ng-danger-btn--filled" phx-click="delete">
          <i class="mdi mdi-delete"></i> Delete Policy
        </button>
      </footer>
    </div>
  </div>
<% end %>

<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div>
      <h1 class="ng-page-title">Policies</h1>
      <p class="ng-page-subtitle">
        Named egress policies. Add rules once, assign users, and let the merged
        rule set land in nftables via the existing per-user chains.
      </p>
    </div>
    <.link replace={true} patch={~p"/policies/new"} class="ng-primary-btn">
      <i class="mdi mdi-shield-plus"></i> New Policy
    </.link>
  </div>
</div>

<section class="section is-main-section">
  <%= render(FzHttpWeb.SharedView, "flash.html", assigns) %>

  <%# ── Default Policy card ────────────────────────────────────────
  %# The catch-all rule that fires at the END of the effective-rules
  %# stream. One per install. `deny` here reproduces Firezone's
  %# legacy `Denylist 0.0.0.0/0` end-of-chain behaviour; `accept`
  %# makes the policy engine allow-list-only (fallthrough passes
  %# anything not explicitly dropped). %>
  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header">
        <i class="mdi mdi-earth"></i> Default policy
        <span class="ng-section-badge">catch-all</span>
      </span>
    </div>
    <div class="ng-detail-card-body">
      <p class="ng-form-hint" style="margin-bottom: 0.75rem;">
        Applies to <strong>every user</strong> for <strong>every destination
        (IPv4 + IPv6)</strong> that no rule in a regular policy has matched.
        Sits at the tail of the effective-rules stream.
      </p>

      <.form
        :let={_}
        for={%{}}
        as={:default}
        phx-submit="save_default"
        class="ng-form-inline"
      >
        <div class="ng-field ng-field--grow">
          <label class="ng-label">Verdict</label>
          <select name="default[action]" class="ng-input">
            <option value="drop" selected={
              @default_policy && @default_policy.default_action == :drop
            }>Deny (drop) — recommended, then layer explicit allows above</option>
            <option value="accept" selected={
              @default_policy && @default_policy.default_action == :accept
            }>Allow (accept) — allow-list-only, explicit denies still block</option>
          </select>
        </div>
        <button type="submit" class="ng-primary-btn ng-form-inline-btn">
          <i class="mdi mdi-content-save"></i>
          <%= if @default_policy, do: "Save", else: "Set default" %>
        </button>
        <%= if @default_policy do %>
          <button
            type="button"
            class="ng-secondary-btn ng-form-inline-btn"
            phx-click="confirm_clear_default"
            title="Remove the default policy -- chain fall-through returns to nftables policy accept."
          >
            <i class="mdi mdi-close"></i> Clear
          </button>
        <% end %>
      </.form>

      <p class="ng-field-hint" style="margin-top: 0.75rem;">
        <%= if @default_policy do %>
          Current: <strong class={"ng-source-badge ng-source-badge--#{@default_policy.default_action}"}><%= @default_policy.default_action %></strong>
          for both IPv4 and IPv6. Rule updates take effect immediately.
        <% else %>
          <strong>No default policy set</strong> — traffic not matched by any
          regular-policy rule falls through to nftables' <code>policy accept</code>.
          Set a default to explicitly deny or allow.
        <% end %>
      </p>
    </div>
  </div>

  <%= if @clear_default_confirm do %>
    <div class="modal is-active" phx-window-keydown="cancel_clear_default" phx-key="escape">
      <div class="modal-background" phx-click="cancel_clear_default"></div>
      <div class="modal-card">
        <header class="modal-card-head">
          <p class="modal-card-title">
            <i class="mdi mdi-alert-octagon ng-modal-title-icon"></i>
            Clear default policy
          </p>
          <button class="ng-modal-close" aria-label="Close" phx-click="cancel_clear_default">
            <i class="mdi mdi-close"></i>
          </button>
        </header>
        <section class="modal-card-body">
          <p class="ng-modal-intro">Remove the catch-all rule?</p>
          <p class="ng-modal-desc">
            Traffic not matched by any regular-policy rule will fall through to
            nftables' <code>policy accept</code> — effectively an "allow all"
            for unmatched packets. Only clear if you want no catch-all behaviour
            (rare).
          </p>
        </section>
        <footer class="modal-card-foot">
          <button class="ng-secondary-btn" phx-click="cancel_clear_default">Cancel</button>
          <button class="ng-danger-btn ng-danger-btn--filled" phx-click="clear_default">
            <i class="mdi mdi-close"></i> Clear default
          </button>
        </footer>
      </div>
    </div>
  <% end %>

  <%= if @all_policies == [] do %>
    <div class="ng-empty-state">
      <i class="mdi mdi-shield-outline ng-empty-state-icon"></i>
      <p class="ng-empty-state-title">No policies yet</p>
      <p class="ng-empty-state-hint">
        Create a policy to group rules by team or role, then assign users.
        Legacy per-user rules keep working alongside.
      </p>
      <.link replace={true} patch={~p"/policies/new"} class="ng-primary-btn ng-empty-state-cta">
        <i class="mdi mdi-shield-plus"></i> Create first policy
      </.link>
    </div>
  <% else %>
    <%# ── Stats strip ────────────────────────────────────────────── %>
    <div class="ng-stat-strip">
      <div class="ng-stat-tile">
        <div class="ng-stat-tile-value"><%= length(@all_policies) %></div>
        <div class="ng-stat-tile-label">Policies</div>
      </div>
      <div class="ng-stat-tile">
        <div class="ng-stat-tile-value">
          <%= Enum.sum(Enum.map(@all_policies, & &1.rule_count)) %>
        </div>
        <div class="ng-stat-tile-label">Rules</div>
      </div>
      <div class="ng-stat-tile">
        <div class="ng-stat-tile-value">
          <%= Enum.sum(Enum.map(@all_policies, & &1.user_count)) %>
        </div>
        <div class="ng-stat-tile-label">Assignments</div>
      </div>
    </div>

    <%# ── Filter bar (name/desc substring only) ─────────────────── %>
    <.form
      :let={_f}
      for={%{}}
      as={:filters}
      phx-change="filter"
      class="ng-user-filterbar"
    >
      <div class="ng-user-filterbar-search">
        <i class="mdi mdi-magnify"></i>
        <input
          type="text"
          name="filters[search]"
          value={@filters["search"]}
          placeholder="Search by name or description…"
          class="ng-user-filterbar-input"
          phx-debounce="200"
          autocomplete="off"
        />
      </div>

      <%= if FzHttpWeb.PoliciesLive.Index.filters_active?(@filters) do %>
        <button type="button" phx-click="reset_filters" class="ng-user-filterbar-reset">
          <i class="mdi mdi-close"></i> Reset
        </button>
      <% end %>

      <span class="ng-user-filterbar-count">
        <%= length(@policies) %> of <%= length(@all_policies) %>
      </span>
    </.form>

    <%# ── Table ─────────────────────────────────────────────────── %>
    <%= if @policies == [] do %>
      <div class="ng-empty-state ng-empty-state--inline">
        <p class="ng-empty-state-hint">
          No policies match the current filters.
          <button type="button" phx-click="reset_filters" class="ng-inline-link">Reset filters</button>
        </p>
      </div>
    <% else %>
    <div class="ng-table-wrap">
      <table class="ng-table">
        <thead>
          <tr>
            <th>Policy</th>
            <th class="ng-th-center">Rules</th>
            <th class="ng-th-center">Users</th>
            <th>Created</th>
            <th class="ng-th-center ng-th-narrow"></th>
          </tr>
        </thead>
        <tbody>
          <%= for policy <- @policies do %>
            <tr id={"policy-#{policy.id}"}>
              <td>
                <div class="ng-user-cell">
                  <div class="ng-avatar ng-avatar--group">
                    <i class="mdi mdi-shield-check-outline"></i>
                  </div>
                  <div class="ng-user-info">
                    <.link navigate={~p"/policies/#{policy}"} class="ng-user-email">
                      <%= policy.name %>
                    </.link>
                    <%= if policy.applies_to_all_users do %>
                      <span class="ng-td-muted ng-td-meta">
                        <i class="mdi mdi-earth"></i> global — applies to all users
                      </span>
                    <% end %>
                    <%= if policy.description && policy.description != "" do %>
                      <span class="ng-td-muted ng-td-meta"><%= policy.description %></span>
                    <% end %>
                  </div>
                </div>
              </td>
              <td class="ng-td-center">
                <span class="ng-device-count">
                  <i class="mdi mdi-format-list-checks"></i> <%= policy.rule_count %>
                </span>
              </td>
              <td class="ng-td-center">
                <%= if policy.applies_to_all_users do %>
                  <span class="ng-device-count ng-td-muted" title="Global policy — applies to every user">
                    <i class="mdi mdi-earth"></i> all
                  </span>
                <% else %>
                  <span class="ng-device-count">
                    <i class="mdi mdi-account"></i> <%= policy.user_count %>
                  </span>
                <% end %>
              </td>
              <td
                id={"policy-#{policy.id}-inserted-at"}
                data-timestamp={policy.inserted_at}
                phx-hook="FormatTimestamp"
                class="ng-td-muted"
              >
                …
              </td>
              <td class="ng-td-center">
                <button
                  class="ng-dismiss-btn"
                  aria-label={"Delete policy #{policy.name}"}
                  phx-click="confirm_delete"
                  phx-value-id={policy.id}
                >
                  <i class="mdi mdi-trash-can-outline"></i>
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% end %>
  <% end %>
</section>
