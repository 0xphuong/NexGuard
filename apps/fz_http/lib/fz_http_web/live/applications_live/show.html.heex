<%# ── Edit modal ─────────────────────────────────────────────────── %>
<%= if @live_action == :edit do %>
  <%= live_modal(
    FzHttpWeb.ApplicationsLive.FormComponent,
    return_to: ~p"/applications/#{@application}",
    title: "Edit Application",
    id: "application-form-component",
    application: @application,
    subject: @subject,
    remote_ip: @remote_ip,
    action: @live_action,
    form: "application-form",
    button_text: "Save changes"
  ) %>
<% end %>

<%# ── Remove Allowed Group Confirmation Modal ──────────────────── %>
<%= if @remove_group_confirm do %>
  <div class="modal is-active" phx-window-keydown="cancel_remove_group" phx-key="escape">
    <div class="modal-background" phx-click="cancel_remove_group"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">
          <i class="mdi mdi-account-minus-outline ng-modal-title-icon"></i>
          Remove Allowed Group
        </p>
        <button class="ng-modal-close" aria-label="Close" phx-click="cancel_remove_group">
          <i class="mdi mdi-close"></i>
        </button>
      </header>
      <section class="modal-card-body">
        <p class="ng-modal-intro">Remove this group's access to:</p>
        <div class="ng-modal-entity"><%= @application.name %></div>
        <p class="ng-modal-desc">
          Members of <strong><%= @remove_group_confirm.name %></strong> will
          lose access to <em><%= @application.hostname %></em> unless they
          belong to another allowed group (or have
          <code>access_scope = :all</code>).
        </p>
      </section>
      <footer class="modal-card-foot">
        <button class="ng-secondary-btn" phx-click="cancel_remove_group">Cancel</button>
        <button class="ng-danger-btn ng-danger-btn--filled" phx-click="remove_allowed_group">
          <i class="mdi mdi-account-minus-outline"></i> Remove group
        </button>
      </footer>
    </div>
  </div>
<% end %>

<%# ── Delete Confirmation Modal ────────────────────────────────── %>
<%= if @delete_confirm do %>
  <div class="modal is-active" phx-window-keydown="cancel_delete" phx-key="escape">
    <div class="modal-background" phx-click="cancel_delete"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">
          <i class="mdi mdi-alert-octagon ng-modal-title-icon"></i>
          Delete Application
        </p>
        <button class="ng-modal-close" aria-label="Close" phx-click="cancel_delete">
          <i class="mdi mdi-close"></i>
        </button>
      </header>
      <section class="modal-card-body">
        <p class="ng-modal-intro">You are about to permanently delete:</p>
        <div class="ng-modal-entity"><%= @application.name %></div>
        <p class="ng-modal-cons">This will also:</p>
        <ul class="ng-modal-list">
          <li>Release the virtual IP
            <code><%= FzHttpWeb.ApplicationsLive.Index.vip_to_string(@application.virtual_ip) %></code></li>
          <li>Detach every access group from the allowed-groups list</li>
          <li>Stop CoreDNS from resolving <code><%= @application.hostname %></code></li>
        </ul>
        <p class="ng-modal-warn">This action cannot be undone.</p>
      </section>
      <footer class="modal-card-foot">
        <button class="ng-secondary-btn" phx-click="cancel_delete">Cancel</button>
        <button class="ng-danger-btn ng-danger-btn--filled" phx-click="delete">
          <i class="mdi mdi-delete"></i> Delete Application
        </button>
      </footer>
    </div>
  </div>
<% end %>

<%# ── Hero ─────────────────────────────────────────────────────── %>
<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div class="ng-app-hero">
      <div class="ng-avatar ng-avatar--lg ng-avatar--app">
        <i class="mdi mdi-application-cog-outline"></i>
      </div>
      <div class="ng-app-hero-meta">
        <div class="ng-app-hero-breadcrumb">
          <.link navigate={~p"/applications"} class="ng-breadcrumb">Applications</.link>
          <span class="ng-breadcrumb-sep">/</span>
          <h1 class="ng-page-title"><%= @application.name %></h1>
        </div>
        <div class="ng-app-hero-status">
          <%= if @application.enabled do %>
            <span class="ng-source-badge ng-source-badge--idp_sync">
              <i class="mdi mdi-check-circle-outline"></i> Enabled
            </span>
          <% else %>
            <span class="ng-source-badge ng-source-badge--manual">
              <i class="mdi mdi-pencil-outline"></i> Draft
            </span>
          <% end %>
          <span class="ng-td-muted"><code><%= @application.hostname %></code></span>
        </div>
      </div>
    </div>
    <div class="ng-app-hero-action">
      <.link patch={~p"/applications/#{@application}/edit"} replace={true} class="ng-secondary-btn">
        <i class="mdi mdi-pencil"></i> Edit
      </.link>
    </div>
  </div>
</div>

<%# ── Tab navigation ─────────────────────────────────────────── %>
<%# Four tabs split what used to be a 500-line scroll into focused
%# views: Overview (4-zone summary), Policy (L7 rules editor),
%# Groups (allowed-groups picker), Danger (enable/disable + delete).
%# Each tab is URL-addressable + bookmarkable; the live_action atom
%# carries which tab is active. %>
<nav class="ng-tab-nav">
  <.link patch={~p"/applications/#{@application}"}
         replace={true}
         class={["ng-tab", @tab == :overview && "is-active"]}>
    <i class="mdi mdi-information-outline"></i>
    <span>Overview</span>
  </.link>
  <.link patch={~p"/applications/#{@application}/policy"}
         replace={true}
         class={["ng-tab", @tab == :policy && "is-active"]}>
    <i class="mdi mdi-filter-variant"></i>
    <span>Policy</span>
    <span class="ng-tab-count"><%= length(@application.l7_rules) %></span>
  </.link>
  <.link patch={~p"/applications/#{@application}/groups"}
         replace={true}
         class={["ng-tab", @tab == :groups && "is-active"]}>
    <i class="mdi mdi-account-multiple-check-outline"></i>
    <span>Groups</span>
    <span class="ng-tab-count"><%= length(@allowed_groups) %></span>
  </.link>
  <.link patch={~p"/applications/#{@application}/danger"}
         replace={true}
         class={["ng-tab ng-tab--danger", @tab == :danger && "is-active"]}>
    <i class="mdi mdi-alert-octagon-outline"></i>
    <span>Danger zone</span>
  </.link>
</nav>

<section class="section is-main-section">
  <%= render(FzHttpWeb.SharedView, "flash.html", assigns) %>

<%= if @tab == :overview do %>
  <%# ── 4-zone Overview card (App-Show-B) ──────────────────────
  %# Replaces a 5-row stand-alone Routing card with a 2×2 grid
  %# covering everything an admin scans first: where it lives
  %# (Routing), how it's gated (Policy + Access), and how it
  %# terminates TLS (Cert / TLS). Each zone uses the same dense
  %# `.ng-user-overview-list` dt/dd grid as the user show page. %>
  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header">
        <i class="mdi mdi-application-cog-outline"></i> Application overview
      </span>
    </div>
    <div class="ng-user-overview-grid">
      <%# ── Routing zone ── %>
      <div class="ng-user-overview-zone">
        <div class="ng-user-overview-zone-title">
          <i class="mdi mdi-router-network"></i> Routing
        </div>
        <dl class="ng-user-overview-list">
          <div><dt>Hostname</dt>
            <dd><code><%= @application.hostname %></code></dd></div>
          <div><dt>Virtual IP</dt>
            <dd><code><%= FzHttpWeb.ApplicationsLive.Index.vip_to_string(@application.virtual_ip) %></code></dd></div>
          <div><dt>Backend</dt>
            <dd><code><%= @application.backend %></code></dd></div>
          <div><dt>TLS mode</dt>
            <dd><%= @application.tls_mode %></dd></div>
        </dl>
      </div>

      <%# ── Policy zone ── %>
      <div class="ng-user-overview-zone">
        <div class="ng-user-overview-zone-title">
          <i class="mdi mdi-filter-variant"></i> Policy
        </div>
        <dl class="ng-user-overview-list">
          <div><dt>L7 rules</dt>
            <dd>
              <%= length(@application.l7_rules) %>
              <.link patch={~p"/applications/#{@application}/policy"}
                     replace={true}
                     class="ng-overview-link">Edit →</.link>
            </dd></div>
          <div><dt>Default</dt>
            <dd>
              <span class="ng-rule-action-badge ng-rule-action-badge--deny">deny</span>
              <span class="ng-td-muted"> (implicit)</span>
            </dd></div>
          <div><dt>Status</dt>
            <dd>
              <%= if @application.enabled do %>
                <span class="ng-source-badge ng-source-badge--idp_sync">Enabled</span>
              <% else %>
                <span class="ng-source-badge ng-source-badge--manual">Draft</span>
              <% end %>
            </dd></div>
        </dl>
      </div>

      <%# ── Access zone ── %>
      <div class="ng-user-overview-zone">
        <div class="ng-user-overview-zone-title">
          <i class="mdi mdi-account-multiple-check-outline"></i> Access
        </div>
        <dl class="ng-user-overview-list">
          <div><dt>Allowed groups</dt>
            <dd>
              <%= length(@allowed_groups) %>
              <.link patch={~p"/applications/#{@application}/groups"}
                     replace={true}
                     class="ng-overview-link">Manage →</.link>
            </dd></div>
          <div><dt>Visibility</dt>
            <dd>
              <%= if @allowed_groups == [] do %>
                <span class="ng-td-muted">No one (gate is fail-closed)</span>
              <% else %>
                <span class="ng-td-muted">Members of the allowed groups, plus break-glass users</span>
              <% end %>
            </dd></div>
        </dl>
      </div>

      <%# ── Cert / TLS zone ── %>
      <div class="ng-user-overview-zone">
        <div class="ng-user-overview-zone-title">
          <i class="mdi mdi-certificate-outline"></i> Cert / TLS
        </div>
        <dl class="ng-user-overview-list">
          <div><dt>Cert source</dt>
            <dd>
              <%= case @application.cert_source do %>
                <% :library -> %><i class="mdi mdi-certificate-outline"></i> Shared library
                <% :step_ca -> %><i class="mdi mdi-shield-key-outline"></i> Internal CA (step-ca)
                <% :upload  -> %><i class="mdi mdi-cloud-upload-outline"></i> Per-app upload
                <% other     -> %><%= other %>
              <% end %>
            </dd></div>
          <%= if @application.cert_source == :library and not is_nil(@application.tls_auto_match) do %>
            <div><dt>Auto-match</dt>
              <dd>
                <%= if @application.tls_auto_match do %>
                  <span class="ng-source-badge ng-source-badge--idp_sync">on</span>
                <% else %>
                  <span class="ng-source-badge ng-source-badge--manual">off — pinned</span>
                <% end %>
              </dd></div>
          <% end %>
        </dl>
      </div>
    </div>
  </div>
<% end %>

<%= if @tab == :policy do %>
  <%# ── L7 Rules editor ─────────────────────────────────────────── %>
  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header">
        <i class="mdi mdi-filter-variant"></i> L7 Rules
        <span class="ng-section-badge"><%= length(@application.l7_rules) %></span>
      </span>
    </div>

    <div class="ng-detail-card-body">
      <p class="ng-form-hint ng-form-hint--lead">
        Rules evaluate <strong>first-match wins</strong>; an implicit
        <code>deny</code> applies if no rule matches. Each rule can
        narrow on HTTP method, path prefix, required groups (beyond
        the app's Allowed Groups), and MFA freshness.
      </p>

      <%# ── Add-rule form ───────────────────────────────────────── %>
      <form id="add-rule-form" phx-submit="add_rule" autocomplete="off" class="ng-rule-form">
        <div class="ng-rule-form-grid">
          <div class="ng-field">
            <label class="ng-label">Action</label>
            <div class="ng-radio-row">
              <label class="ng-radio-inline">
                <input type="radio" name="action" value="allow" checked />
                <span class="ng-rule-action-badge ng-rule-action-badge--allow">allow</span>
              </label>
              <label class="ng-radio-inline">
                <input type="radio" name="action" value="deny" />
                <span class="ng-rule-action-badge ng-rule-action-badge--deny">deny</span>
              </label>
            </div>
          </div>

          <div class="ng-field">
            <label class="ng-label">Methods <span class="ng-td-muted">(empty = any)</span></label>
            <div class="ng-method-pills">
              <%= for m <- ~w[GET POST PUT DELETE PATCH] do %>
                <label class="ng-method-pill">
                  <input type="checkbox" name={"method_#{m}"} value="1" />
                  <span><%= m %></span>
                </label>
              <% end %>
            </div>
          </div>

          <div class="ng-field">
            <label class="ng-label">Path prefix <span class="ng-td-muted">(optional)</span></label>
            <input type="text" name="path_prefix" class="ng-input"
                   placeholder="/api/ or /admin/" autocomplete="off" />
          </div>

          <div class="ng-field">
            <label class="ng-label">Require groups <span class="ng-td-muted">(any of)</span></label>
            <%= if @allowed_groups == [] do %>
              <p class="ng-form-hint">Add allowed groups first to pick from.</p>
            <% else %>
              <div class="ng-checkbox-row">
                <%= for g <- @allowed_groups do %>
                  <label class="ng-method-pill">
                    <input type="checkbox" name={"rg_#{g.id}"} value={g.name} />
                    <span><%= g.name %></span>
                  </label>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="ng-field">
            <label class="ng-label">MFA fresh-within (seconds) <span class="ng-td-muted">(optional)</span></label>
            <input type="number" name="require_mfa_age_seconds" class="ng-input"
                   min="1" placeholder="300" />
          </div>
        </div>

        <div class="ng-form-actions ng-form-actions--spaced">
          <button type="submit" class="ng-primary-btn">
            <i class="mdi mdi-plus"></i> Add Rule
          </button>
        </div>
      </form>
    </div>

    <%# ── Existing rules table ──────────────────────────────────── %>
    <%= if @application.l7_rules == [] do %>
      <div class="ng-detail-card-body--bottom">
        <div class="ng-empty-state ng-empty-state--inline">
          <p class="ng-empty-state-hint">
            No rules yet. With zero rules the implicit default
            <code>deny</code> applies — every request to this app is
            rejected. Add at least one <code>allow</code> rule for the
            app to be reachable.
          </p>
        </div>
      </div>
    <% else %>
      <div class="ng-table-wrap ng-table-wrap--flush">
        <table class="ng-table">
          <thead>
            <tr>
              <th class="ng-th-narrow">#</th>
              <th>Action</th>
              <th>Method</th>
              <th>Path prefix</th>
              <th>Require groups</th>
              <th>MFA age (s)</th>
              <th class="ng-th-center ng-th-actions">Order</th>
              <th class="ng-th-center ng-th-narrow"></th>
            </tr>
          </thead>
          <tbody>
            <%= for {rule, idx} <- Enum.with_index(@application.l7_rules) do %>
              <tr id={"l7-rule-#{idx}"}>
                <td class="ng-td-muted"><%= idx + 1 %></td>
                <td>
                  <%= case rule["action"] do %>
                    <% "allow" -> %>
                      <span class="ng-rule-action-badge ng-rule-action-badge--allow">allow</span>
                    <% _ -> %>
                      <span class="ng-rule-action-badge ng-rule-action-badge--deny">deny</span>
                  <% end %>
                </td>
                <td>
                  <%= case rule["method"] do %>
                    <% list when is_list(list) and list != [] -> %>
                      <span class="ng-td-muted"><%= Enum.join(list, ", ") %></span>
                    <% _ -> %>
                      <span class="ng-td-muted">any</span>
                  <% end %>
                </td>
                <td class="ng-td-muted">
                  <%= if rule["path_prefix"] && rule["path_prefix"] != "", do: rule["path_prefix"], else: "—" %>
                </td>
                <td class="ng-td-muted">
                  <%= case rule["require_groups"] do %>
                    <% list when is_list(list) and list != [] -> %>
                      <%= Enum.join(list, ", ") %>
                    <% _ -> %>
                      —
                  <% end %>
                </td>
                <td class="ng-td-muted">
                  <%= rule["require_mfa_age_seconds"] || "—" %>
                </td>
                <td class="ng-td-center">
                  <button
                    class="ng-dismiss-btn"
                    title="Move up"
                    phx-click="move_rule_up"
                    phx-value-index={idx}
                    disabled={idx == 0}
                  >
                    <i class="mdi mdi-arrow-up"></i>
                  </button>
                  <button
                    class="ng-dismiss-btn"
                    title="Move down"
                    phx-click="move_rule_down"
                    phx-value-index={idx}
                    disabled={idx == length(@application.l7_rules) - 1}
                  >
                    <i class="mdi mdi-arrow-down"></i>
                  </button>
                </td>
                <td class="ng-td-center">
                  <button
                    class="ng-dismiss-btn"
                    title="Delete rule"
                    phx-click="delete_rule"
                    phx-value-index={idx}
                  >
                    <i class="mdi mdi-trash-can-outline"></i>
                  </button>
                </td>
              </tr>
            <% end %>
            <%# Implicit default-deny — visible so admin knows what
                happens past the last rule. Not editable. %>
            <tr class="ng-rule-implicit">
              <td class="ng-td-muted">∞</td>
              <td>
                <span class="ng-rule-action-badge ng-rule-action-badge--deny">deny</span>
              </td>
              <td class="ng-td-muted" colspan="4">
                <em>Implicit default deny — applied if no rule above matched.</em>
              </td>
              <td class="ng-td-center ng-td-muted">—</td>
              <td class="ng-td-center ng-td-muted">—</td>
            </tr>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
<% end %>

<%= if @tab == :groups do %>
  <%# ── Allowed Groups ───────────────────────────────────────────── %>
  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header">
        <i class="mdi mdi-account-group-outline"></i> Allowed Groups
        <span class="ng-section-badge"><%= length(@allowed_groups) %></span>
      </span>
    </div>

    <div class="ng-detail-card-body">
      <%= if @available_groups != [] do %>
        <form id="add-allowed-group-form" phx-submit="add_allowed_group"
              class="ng-form-inline" autocomplete="off">
          <div class="ng-field ng-field--grow">
            <label class="ng-label">Allow a group</label>
            <select name="group_id" class="ng-input" required>
              <option value="">Select a group…</option>
              <%= for g <- @available_groups do %>
                <option value={g.id}><%= g.name %></option>
              <% end %>
            </select>
          </div>
          <button type="submit" class="ng-primary-btn ng-form-inline-btn">
            <i class="mdi mdi-plus"></i> Add
          </button>
        </form>
      <% else %>
        <p class="ng-form-hint">
          <%= if @allowed_groups == [] do %>
            <i class="mdi mdi-information-outline"></i>
            No access groups defined yet.
            <.link navigate={~p"/access-groups"} class="ng-inline-link">Create one</.link>
            first to gate this app.
          <% else %>
            Every existing group is already allowed for this app.
          <% end %>
        </p>
      <% end %>
    </div>

    <%= if @allowed_groups == [] do %>
      <div class="ng-detail-card-body--bottom">
        <div class="ng-empty-state ng-empty-state--inline">
          <p class="ng-empty-state-hint">
            No groups allowed. With zero allowed groups the policy bundle
            denies every signed-in user past the app gate (unless they have
            <code>access_scope = :all</code>). Add at least one group to make
            this app reachable.
          </p>
        </div>
      </div>
    <% else %>
      <div class="ng-table-wrap ng-table-wrap--flush">
        <table class="ng-table">
          <thead>
            <tr>
              <th>Group</th>
              <th>Source</th>
              <th>Description</th>
              <th class="ng-th-center ng-th-narrow"></th>
            </tr>
          </thead>
          <tbody>
            <%= for g <- @allowed_groups do %>
              <tr id={"allowed-group-#{g.id}"}>
                <td>
                  <div class="ng-user-cell">
                    <div class="ng-avatar ng-avatar--group">
                      <i class="mdi mdi-account-group-outline"></i>
                    </div>
                    <div class="ng-user-info">
                      <.link navigate={~p"/access-groups/#{g.id}"} class="ng-user-email">
                        <%= g.name %>
                      </.link>
                    </div>
                  </div>
                </td>
                <td>
                  <span class={"ng-source-badge ng-source-badge--#{g.source}"}>
                    <%= g.source %>
                  </span>
                </td>
                <td class="ng-td-muted"><%= g.description || "—" %></td>
                <td class="ng-td-center">
                  <button
                    class="ng-dismiss-btn"
                    title="Remove from allowed list"
                    phx-click="confirm_remove_group"
                    phx-value-group_id={g.id}
                  >
                    <i class="mdi mdi-account-minus-outline"></i>
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
<% end %>

<%= if @tab == :danger do %>
  <%# ── Danger zone ─────────────────────────────────────────────── %>
  <div class="ng-danger-zone">
    <div class="ng-danger-zone-header">
      <i class="mdi mdi-alert-octagon"></i>
      <span>Danger zone</span>
    </div>
    <div class="ng-danger-zone-body">
      <div class="ng-danger-zone-item">
        <div>
          <div class="ng-danger-zone-label">
            <%= if @application.enabled, do: "Disable this application", else: "Enable this application" %>
          </div>
          <p class="ng-danger-zone-desc">
            <%= if @application.enabled do %>
              Removes this app from the next policy bundle — the proxy stops
              routing traffic to its backend and CoreDNS releases the hostname.
            <% else %>
              Adds this app to the next policy bundle. Requires at least one
              L7 rule before the toggle will succeed.
            <% end %>
          </p>
        </div>
        <button class="ng-secondary-btn" phx-click="toggle_enabled">
          <%= if @application.enabled do %>
            <i class="mdi mdi-pause-circle-outline"></i> Disable
          <% else %>
            <i class="mdi mdi-play-circle-outline"></i> Enable
          <% end %>
        </button>
      </div>
      <hr class="ng-danger-zone-divider" />
      <div class="ng-danger-zone-item">
        <div>
          <div class="ng-danger-zone-label">Delete this application</div>
          <p class="ng-danger-zone-desc">
            Releases the virtual IP, detaches every access group, and removes
            the hostname from CoreDNS. Member groups themselves are not deleted.
          </p>
        </div>
        <button class="ng-danger-btn" phx-click="confirm_delete">
          <i class="mdi mdi-trash-can-outline"></i> Delete Application
        </button>
      </div>
    </div>
  </div>
<% end %>
</section>
