<%# ── New Application modal ─────────────────────────────────────── %>
<%= if @live_action == :new do %>
  <%= live_modal(
    FzHttpWeb.ApplicationsLive.FormComponent,
    return_to: ~p"/applications",
    title: "New Application",
    id: "application-form-component",
    application: nil,
    subject: @subject,
    remote_ip: @remote_ip,
    action: @live_action,
    form: "application-form",
    button_text: "Create Application"
  ) %>
<% end %>

<%# ── Delete Confirmation Modal ─────────────────────────────────── %>
<%= if @delete_confirm do %>
  <div class="modal is-active" phx-window-keydown="cancel_delete" phx-key="escape">
    <div class="modal-background" phx-click="cancel_delete"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">
          <i class="mdi mdi-alert-octagon ng-modal-title-icon"></i>
          Delete Application
        </p>
        <button class="ng-modal-close" aria-label="Close" phx-click="cancel_delete">
          <i class="mdi mdi-close"></i>
        </button>
      </header>
      <section class="modal-card-body">
        <p class="ng-modal-intro">You are about to permanently delete:</p>
        <div class="ng-modal-entity"><%= @delete_confirm.name %></div>
        <p class="ng-modal-cons">This will also:</p>
        <ul class="ng-modal-list">
          <li>Release the virtual IP
            <code><%= FzHttpWeb.ApplicationsLive.Index.vip_to_string(@delete_confirm.virtual_ip) %></code>
            so it can be re-allocated to a new application</li>
          <li>Detach every access group from this app's allowed-groups list</li>
          <li>Stop CoreDNS from resolving <code><%= @delete_confirm.hostname %></code> to its VIP
            once the policy bundle reloads</li>
        </ul>
        <p class="ng-modal-warn">This action cannot be undone.</p>
      </section>
      <footer class="modal-card-foot">
        <button class="ng-secondary-btn" phx-click="cancel_delete">Cancel</button>
        <button class="ng-danger-btn ng-danger-btn--filled" phx-click="delete">
          <i class="mdi mdi-delete"></i> Delete Application
        </button>
      </footer>
    </div>
  </div>
<% end %>

<%# ── Page header ───────────────────────────────────────────────── %>
<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div>
      <h1 class="ng-page-title">Applications</h1>
      <p class="ng-page-subtitle">
        Internal-domain apps that route through the L7 transparent proxy.
        Public traffic bypasses this list and is filtered only by Rules.
      </p>
    </div>
    <.link replace={true} patch={~p"/applications/new"} class="ng-primary-btn">
      <i class="mdi mdi-plus"></i> New Application
    </.link>
  </div>
</div>

<section class="section is-main-section">
  <%= render(FzHttpWeb.SharedView, "flash.html", assigns) %>

  <%= if @all_applications == [] do %>
    <div class="ng-empty-state">
      <i class="mdi mdi-application-cog-outline ng-empty-state-icon"></i>
      <p class="ng-empty-state-title">No applications yet</p>
      <p class="ng-empty-state-hint">
        Declare an application here to put it behind the L7 proxy. Each app gets
        a virtual IP in <code>10.99.0.0/16</code> and is reachable via its
        declared hostname once CoreDNS picks up the change.
      </p>
      <.link replace={true} patch={~p"/applications/new"} class="ng-primary-btn ng-empty-state-cta">
        <i class="mdi mdi-plus"></i> Declare first application
      </.link>
    </div>
  <% else %>
    <%# Stats strip — org-wide pulse for declared apps. State tiles
    %# (Total / Enabled / Draft) always render; cert-source tiles
    %# only render when count > 0 so the strip doesn't carry a dead
    %# "step-ca: 0" tile after ADR-015 made :library the default.
    %# Counts are derived from the unfiltered `@all_applications` so
    %# the strip pulses the whole org regardless of the active filter. %>
    <% library_count = Enum.count(@all_applications, &(&1.cert_source == :library)) %>
    <% upload_count  = Enum.count(@all_applications, &(&1.cert_source == :upload))  %>
    <% step_ca_count = Enum.count(@all_applications, &(&1.cert_source == :step_ca)) %>
    <div class="ng-stat-strip">
      <div class="ng-stat-tile">
        <div class="ng-stat-tile-value"><%= length(@all_applications) %></div>
        <div class="ng-stat-tile-label">Total apps</div>
      </div>
      <div class="ng-stat-tile">
        <div class="ng-stat-tile-value">
          <%= Enum.count(@all_applications, & &1.enabled) %>
        </div>
        <div class="ng-stat-tile-label">Enabled</div>
      </div>
      <div class="ng-stat-tile">
        <div class="ng-stat-tile-value">
          <%= Enum.count(@all_applications, &(!&1.enabled)) %>
        </div>
        <div class="ng-stat-tile-label">Draft</div>
      </div>
      <%= if library_count > 0 do %>
        <div class="ng-stat-tile" title="Apps using the shared TLS certificate library (ADR-015)">
          <div class="ng-stat-tile-value"><%= library_count %></div>
          <div class="ng-stat-tile-label">
            <i class="mdi mdi-certificate-outline"></i> Library
          </div>
        </div>
      <% end %>
      <%= if upload_count > 0 do %>
        <div class="ng-stat-tile" title="Apps still using per-app cert upload — consider migrating to the cert library">
          <div class="ng-stat-tile-value"><%= upload_count %></div>
          <div class="ng-stat-tile-label">
            <i class="mdi mdi-cloud-upload-outline"></i> Upload
          </div>
        </div>
      <% end %>
      <%= if step_ca_count > 0 do %>
        <div class="ng-stat-tile" title="Apps using the internal smallstep CA (ADR-011, pipeline pending)">
          <div class="ng-stat-tile-value"><%= step_ca_count %></div>
          <div class="ng-stat-tile-label">
            <i class="mdi mdi-shield-key-outline"></i> step-ca
          </div>
        </div>
      <% end %>
    </div>

    <%# ── Filter bar (App-Idx-A) — search + status chip ────── %>
    <.form
      :let={_f}
      for={%{}}
      as={:filters}
      phx-change="filter"
      class="ng-user-filterbar"
    >
      <div class="ng-user-filterbar-search">
        <i class="mdi mdi-magnify"></i>
        <input
          type="text"
          name="filters[search]"
          value={@filters["search"]}
          placeholder="Search by name or hostname…"
          class="ng-user-filterbar-input"
          phx-debounce="200"
          autocomplete="off"
        />
      </div>

      <select name="filters[status]" class="ng-user-filterbar-select">
        <%= for {label, value} <- @status_options do %>
          <option value={value} selected={value == @filters["status"]}><%= label %></option>
        <% end %>
      </select>

      <%= if FzHttpWeb.ApplicationsLive.Index.filters_active?(@filters) do %>
        <button type="button" phx-click="reset_filters" class="ng-user-filterbar-reset">
          <i class="mdi mdi-close"></i> Reset
        </button>
      <% end %>

      <span class="ng-user-filterbar-count">
        <%= length(@applications) %> of <%= length(@all_applications) %>
      </span>
    </.form>

    <%= if @applications == [] do %>
      <div class="ng-empty-state ng-empty-state--inline">
        <p class="ng-empty-state-hint">
          No applications match the current filters.
          <button type="button" phx-click="reset_filters" class="ng-inline-link">Reset filters</button>
        </p>
      </div>
    <% else %>
    <div class="ng-table-wrap">
      <table class="ng-table">
        <thead>
          <tr>
            <th>Application</th>
            <th>Hostname</th>
            <th>Virtual IP</th>
            <th class="ng-th-center">Groups</th>
            <th>Status</th>
            <th>Created</th>
            <th class="ng-th-center ng-th-narrow"></th>
          </tr>
        </thead>
        <tbody>
          <%= for app <- @applications do %>
            <tr id={"application-#{app.id}"}>
              <td>
                <div class="ng-user-cell">
                  <div class="ng-avatar ng-avatar--group">
                    <i class="mdi mdi-application-cog-outline"></i>
                  </div>
                  <div class="ng-user-info">
                    <.link navigate={~p"/applications/#{app}"} class="ng-user-email">
                      <%= app.name %>
                    </.link>
                    <%= if app.description && app.description != "" do %>
                      <span class="ng-td-muted ng-td-meta"><%= app.description %></span>
                    <% end %>
                  </div>
                </div>
              </td>
              <td class="ng-td-muted">
                <code><%= app.hostname %></code>
              </td>
              <td class="ng-td-muted">
                <code><%= FzHttpWeb.ApplicationsLive.Index.vip_to_string(app.virtual_ip) %></code>
              </td>
              <td class="ng-td-center">
                <span class="ng-device-count">
                  <i class="mdi mdi-account-group"></i> <%= app.allowed_group_count || 0 %>
                </span>
              </td>
              <td>
                <%= if app.enabled do %>
                  <span class="ng-source-badge ng-source-badge--idp_sync">
                    <i class="mdi mdi-check-circle-outline"></i> Enabled
                  </span>
                <% else %>
                  <span class="ng-source-badge ng-source-badge--manual">
                    <i class="mdi mdi-pencil-outline"></i> Draft
                  </span>
                <% end %>
              </td>
              <td
                id={"application-#{app.id}-inserted-at"}
                data-timestamp={app.inserted_at}
                phx-hook="FormatTimestamp"
                class="ng-td-muted"
              >
                …
              </td>
              <td class="ng-td-center">
                <button
                  class="ng-dismiss-btn"
                  title="Delete application"
                  phx-click="confirm_delete"
                  phx-value-id={app.id}
                >
                  <i class="mdi mdi-trash-can-outline"></i>
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% end %>
  <% end %>
</section>
