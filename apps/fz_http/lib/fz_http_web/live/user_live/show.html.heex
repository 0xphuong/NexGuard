<%= if @live_action == :edit do %>
  <%= live_modal(
    FzHttpWeb.UserLive.FormComponent,
    return_to: ~p"/users/#{@user}",
    title: "Edit #{@user.email}",
    id: "user-form-component",
    user: @user,
    current_user: @current_user,
    subject: @subject,
    remote_ip: @remote_ip,
    action: @live_action,
    form: "user-form",
    button_text: "Save changes"
  ) %>
<% end %>
<%= if @live_action == :new_device do %>
  <%= live_modal(
    FzHttpWeb.DeviceLive.NewFormComponent,
    return_to: ~p"/users/#{@user}",
    title: "Add Device",
    wide: true,
    current_user: @current_user,
    subject: @subject,
    remote_ip: @remote_ip,
    user: @user,
    id: "create-device-component",
    form: "create-device",
    button_text: "Generate Configuration"
  ) %>
<% end %>

<%# ── Delete Confirmation Modal ────────────────────────────────────────────── %>
<%= if @show_delete_confirm do %>
  <div class="modal is-active"
       phx-window-keydown="cancel_delete"
       phx-key="escape">
    <div class="modal-background" phx-click="cancel_delete"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">
          <i class="mdi mdi-alert-octagon ng-modal-title-icon"></i>
          Delete User
        </p>
        <button class="ng-modal-close" aria-label="Close" phx-click="cancel_delete">
          <i class="mdi mdi-close"></i>
        </button>
      </header>
      <section class="modal-card-body">
        <p class="ng-modal-intro">You are about to permanently delete:</p>
        <div class="ng-modal-entity"><%= @user.email %></div>
        <p class="ng-modal-cons">This will also:</p>
        <ul class="ng-modal-list">
          <li>Delete all associated devices</li>
          <li>Instantly drop any active VPN sessions</li>
        </ul>
        <p class="ng-modal-warn">This action cannot be undone.</p>
      </section>
      <footer class="modal-card-foot">
        <button class="ng-secondary-btn" phx-click="cancel_delete">Cancel</button>
        <button
          class="ng-danger-btn ng-danger-btn--filled"
          phx-click="delete_user"
          phx-value-user_id={@user.id}
        >
          <i class="mdi mdi-delete"></i> Delete User
        </button>
      </footer>
    </div>
  </div>
<% end %>

<%# ── Promote / Demote Confirmation Modal ─────────────────────────────────── %>
<%= if @show_mote_confirm do %>
  <div class="modal is-active"
       phx-window-keydown="cancel_mote"
       phx-key="escape">
    <div class="modal-background" phx-click="cancel_mote"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">
          <i class={"mdi #{mote_icon(@user)} ng-modal-title-icon"}></i>
          <%= mote(@user) %> User
        </p>
        <button class="ng-modal-close" aria-label="Close" phx-click="cancel_mote">
          <i class="mdi mdi-close"></i>
        </button>
      </header>
      <section class="modal-card-body">
        <p class="ng-modal-intro">You are about to change the role for:</p>
        <div class="ng-modal-entity"><%= @user.email %></div>
        <div class="ng-mote-transition">
          <span class="ng-mote-badge"><%= @user.role %></span>
          <i class="mdi mdi-arrow-right ng-mote-arrow"></i>
          <span class="ng-mote-badge ng-mote-badge--target"><%= mote_target_role(@user) %></span>
        </div>
        <p class="ng-modal-desc"><%= mote_message(@user) %></p>
      </section>
      <footer class="modal-card-foot">
        <button class="ng-secondary-btn" phx-click="cancel_mote">Cancel</button>
        <button
          class="ng-danger-btn ng-danger-btn--filled"
          phx-click="confirm_mote"
          phx-value-user_id={@user.id}
        >
          <i class={"mdi #{mote_icon(@user)}"}></i> <%= mote(@user) %> User
        </button>
      </footer>
    </div>
  </div>
<% end %>

<%# ── Remove-from-Group Confirmation Modal ────────────────────────────────── %>
<%= if @remove_group_confirm do %>
  <div class="modal is-active" phx-window-keydown="cancel_remove_from_group" phx-key="escape">
    <div class="modal-background" phx-click="cancel_remove_from_group"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">
          <i class="mdi mdi-account-minus-outline ng-modal-title-icon"></i>
          Remove from Group
        </p>
        <button class="ng-modal-close" aria-label="Close" phx-click="cancel_remove_from_group">
          <i class="mdi mdi-close"></i>
        </button>
      </header>
      <section class="modal-card-body">
        <p class="ng-modal-intro">Remove this user from the group:</p>
        <div class="ng-modal-entity"><%= @remove_group_confirm.name %></div>
        <p class="ng-modal-desc">
          <strong><%= @user.email %></strong> will lose access to any L7-managed
          application that requires <em><%= @remove_group_confirm.name %></em>.
          You can re-add them later.
        </p>
      </section>
      <footer class="modal-card-foot">
        <button class="ng-secondary-btn" phx-click="cancel_remove_from_group">Cancel</button>
        <button class="ng-danger-btn ng-danger-btn--filled" phx-click="remove_from_group">
          <i class="mdi mdi-account-minus-outline"></i> Remove from group
        </button>
      </footer>
    </div>
  </div>
<% end %>

<%# ── Access-Scope Change Confirmation Modal ──────────────────────────────── %>
<%= if @scope_change_confirm do %>
  <div class="modal is-active" phx-window-keydown="cancel_set_access_scope" phx-key="escape">
    <div class="modal-background" phx-click="cancel_set_access_scope"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">
          <%= if @scope_change_confirm == :all do %>
            <i class="mdi mdi-key-variant ng-modal-title-icon"></i>
            Grant L7 Access Bypass
          <% else %>
            <i class="mdi mdi-shield-check-outline ng-modal-title-icon"></i>
            Revert to LIMITED Scope
          <% end %>
        </p>
        <button class="ng-modal-close" aria-label="Close" phx-click="cancel_set_access_scope">
          <i class="mdi mdi-close"></i>
        </button>
      </header>
      <section class="modal-card-body">
        <p class="ng-modal-intro">You are about to change L7 access scope for:</p>
        <div class="ng-modal-entity"><%= @user.email %></div>

        <div class="ng-mote-transition" style="margin: 1rem 0;">
          <span class={"ng-scope-badge ng-scope-badge--#{@user.access_scope}"}>
            <%= @user.access_scope %>
          </span>
          <i class="mdi mdi-arrow-right ng-mote-arrow"></i>
          <span class={"ng-scope-badge ng-scope-badge--#{@scope_change_confirm}"}>
            <%= @scope_change_confirm %>
          </span>
        </div>

        <%= if @scope_change_confirm == :all do %>
          <p class="ng-modal-cons">This is a <strong>break-glass</strong> action:</p>
          <ul class="ng-modal-list">
            <li>User will reach <strong>every</strong> L7-managed application without group checks</li>
            <li>Group membership becomes irrelevant for this user</li>
            <li>Every flip is audited as <code>user.access_scope.change</code></li>
          </ul>
          <p class="ng-modal-warn">
            Use only for incident response, founders / leads, or audit accounts.
            Revert as soon as the reason ends.
          </p>
        <% else %>
          <p class="ng-modal-desc">
            Group-intersection enforcement will resume. The user will lose access
            to any L7-managed application they are not in a required group for.
          </p>
        <% end %>
      </section>
      <footer class="modal-card-foot">
        <button class="ng-secondary-btn" phx-click="cancel_set_access_scope">Cancel</button>
        <%= if @scope_change_confirm == :all do %>
          <button class="ng-danger-btn ng-danger-btn--filled" phx-click="set_access_scope">
            <i class="mdi mdi-key-variant"></i> Grant bypass
          </button>
        <% else %>
          <button class="ng-primary-btn" phx-click="set_access_scope">
            <i class="mdi mdi-shield-check-outline"></i> Revert to LIMITED
          </button>
        <% end %>
      </footer>
    </div>
  </div>
<% end %>

<%# ── Page Header — enriched (Phase U-Show-A) ─────────────────────────────── %>
<%# Hero answers "is this user OK?" in one glance. Line 1: identity
%# (avatar + email + role + scope badges + active dot). Line 2:
%# security signals (MFA state · auth source). Line 3: activity
%# counts (devices · groups · last VPN). %>
<%
  dsbl?    = FzHttpWeb.UserLive.Show.disabled?(@user)
  mfa_st   = FzHttpWeb.UserLive.Show.mfa_state(@user)
  last_act = FzHttpWeb.UserLive.Show.last_activity(@user)
%>
<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div class="ng-user-cell">
      <div class={"ng-avatar ng-avatar--lg ng-avatar--#{@user.role}"}>
        <%= @user.email |> String.first() |> String.upcase() %>
      </div>
      <div class="ng-user-info">
        <div class="ng-user-hero-title">
          <.link navigate={~p"/users"} class="ng-breadcrumb">Users</.link>
          <span class="ng-breadcrumb-sep">/</span>
          <h1 class="ng-page-title" style="margin:0">
            <%= @user.email %>
          </h1>
          <span class={["ng-user-dot",
                        if(dsbl?, do: "ng-user-dot--disabled",
                                  else: "ng-user-dot--active")]}
                title={if(dsbl?, do: "Disabled", else: "Active")}></span>
        </div>

        <div class="ng-user-hero-badges">
          <span class={"ng-role-badge ng-role-badge--#{@user.role}"}><%= @user.role %></span>
          <%= if @user.access_scope == :all do %>
            <span class="ng-user-scope-tag" title="Break-glass — bypasses L7 group gating">
              break-glass
            </span>
          <% end %>
          <%= if dsbl? do %>
            <span class="ng-user-disabled-tag">Disabled</span>
          <% end %>
        </div>

        <%# Sub-line 1 — Security signals %>
        <div class={["ng-user-hero-sub",
                     FzHttpWeb.UserLive.Show.mfa_state_class(mfa_st)]}>
          <span class="ng-user-hero-mfa">
            <i class={["mdi", FzHttpWeb.UserLive.Show.mfa_state_icon(mfa_st)]}></i>
            <%= FzHttpWeb.UserLive.Show.mfa_state_label(mfa_st, @user.mfa_last_used) %>
          </span>
          <span class="ng-user-hero-sep">·</span>
          <span>
            via <%= @user.last_signed_in_method || "—" %>
            <%= if @user.last_signed_in_at do %>
              <span class="ng-td-muted">(<%= FzHttpWeb.UserLive.Show.relative_label(@user.last_signed_in_at) %>)</span>
            <% end %>
          </span>
        </div>

        <%# Sub-line 2 — Activity counts %>
        <div class="ng-user-hero-sub ng-user-hero-sub--muted">
          <span><%= @user.device_count || length(@devices) %> device<%= if (@user.device_count || length(@devices)) != 1, do: "s" %></span>
          <span class="ng-user-hero-sep">·</span>
          <span><%= length(@user_groups) %> group<%= if length(@user_groups) != 1, do: "s" %></span>
          <span class="ng-user-hero-sep">·</span>
          <span>
            <%= if @user.last_handshake do %>
              Last VPN <%= FzHttpWeb.UserLive.Show.relative_label(@user.last_handshake) %>
            <% else %>
              No VPN handshake yet
            <% end %>
          </span>
        </div>
      </div>
    </div>
    <.link patch={~p"/users/#{@user}/edit"} replace={true} class="ng-secondary-btn">
      <i class="mdi mdi-pencil"></i> Edit
    </.link>
  </div>
</div>

<%# ── Tab navigation (Phase U-Show-B) ─────────────────────────────────────── %>
<%# Six URL-addressable tabs. Each is a soft `<.link patch>` so swap
%# is a re-render, not a remount — modals open via `:edit` /
%# `:new_device` keep the underlying tab. Active tab matches
%# `@tab` (derived from live_action in `handle_params/3`). %>
<nav class="ng-tab-nav">
  <.link patch={~p"/users/#{@user}"}
         replace={true}
         class={["ng-tab", @tab == :overview && "is-active"]}>
    <i class="mdi mdi-account-outline"></i>
    <span>Overview</span>
  </.link>
  <.link patch={~p"/users/#{@user}/devices"}
         replace={true}
         class={["ng-tab", @tab == :devices && "is-active"]}>
    <i class="mdi mdi-laptop"></i>
    <span>Devices</span>
    <span class="ng-tab-count"><%= length(@devices) %></span>
  </.link>
  <.link patch={~p"/users/#{@user}/groups"}
         replace={true}
         class={["ng-tab", @tab == :groups && "is-active"]}>
    <i class="mdi mdi-account-multiple-check-outline"></i>
    <span>Groups</span>
    <span class="ng-tab-count"><%= length(@user_groups) %></span>
  </.link>
  <.link patch={~p"/users/#{@user}/access"}
         replace={true}
         class={["ng-tab", @tab == :access && "is-active"]}>
    <i class="mdi mdi-shield-key-outline"></i>
    <span>Access</span>
  </.link>
  <.link patch={~p"/users/#{@user}/connections"}
         replace={true}
         class={["ng-tab", @tab == :connections && "is-active"]}>
    <i class="mdi mdi-link-variant"></i>
    <span>Connections</span>
    <span class="ng-tab-count"><%= length(@connections) %></span>
  </.link>
  <.link patch={~p"/users/#{@user}/danger"}
         replace={true}
         class={["ng-tab ng-tab--danger", @tab == :danger && "is-active"]}>
    <i class="mdi mdi-alert-octagon-outline"></i>
    <span>Danger zone</span>
  </.link>
</nav>

<section class="section is-main-section">
  <%= render(FzHttpWeb.SharedView, "flash.html", assigns) %>

<%= if @tab == :overview do %>
  <%# ── Overview — compact 4-zone summary (Phase U-Show-A) ──────────────────── %>
  <%# Replaces the old `user_details.html.heex` partial (which still
  %# lives in the codebase — Account pages reuse it). 4 zones: Identity
  %# (who this user is) / Security (MFA, scope) / Activity (timestamps)
  %# / Access (devices, groups). Dense scan instead of <dl> scroll. %>
  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header" style="margin:0">
        <i class="mdi mdi-account-outline"></i> Overview
      </span>
    </div>

    <div class="ng-user-overview-grid">
      <%# Identity %>
      <div class="ng-user-overview-zone">
        <div class="ng-user-overview-zone-title">
          <i class="mdi mdi-card-account-details-outline"></i> Identity
        </div>
        <dl class="ng-user-overview-list">
          <div>
            <dt>Email</dt>
            <dd><%= @user.email %></dd>
          </div>
          <div>
            <dt>Role</dt>
            <dd><span class={"ng-role-badge ng-role-badge--#{@user.role}"}><%= @user.role %></span></dd>
          </div>
          <div>
            <dt>Source</dt>
            <dd>
              <%= if length(@connections) > 0 do %>
                OIDC (<%= hd(@connections).provider %>)
              <% else %>
                Local
              <% end %>
            </dd>
          </div>
          <div>
            <dt>Joined</dt>
            <dd class="ng-td-muted">
              <%= FzHttpWeb.UserLive.Show.relative_label(@user.inserted_at) %>
            </dd>
          </div>
        </dl>
      </div>

      <%# Security %>
      <div class="ng-user-overview-zone">
        <div class="ng-user-overview-zone-title">
          <i class="mdi mdi-shield-lock-outline"></i> Security
        </div>
        <dl class="ng-user-overview-list">
          <div>
            <dt>MFA</dt>
            <dd class={FzHttpWeb.UserLive.Show.mfa_state_class(mfa_st)}>
              <i class={["mdi", FzHttpWeb.UserLive.Show.mfa_state_icon(mfa_st)]}></i>
              <%= case mfa_st do
                    :none       -> "Not enrolled"
                    :unverified -> "Enrolled, never verified"
                    :fresh      -> "Fresh (#{FzHttpWeb.UserLive.Show.relative_label(@user.mfa_last_used)})"
                    :stale      -> "Stale (#{FzHttpWeb.UserLive.Show.relative_label(@user.mfa_last_used)})"
                  end %>
              <%= if @user.mfa_count && @user.mfa_count > 0 do %>
                <span class="ng-td-muted">· <%= @user.mfa_count %> method<%= if @user.mfa_count != 1, do: "s" %></span>
              <% end %>
            </dd>
          </div>
          <div>
            <dt>L7 scope</dt>
            <dd>
              <span class={"ng-scope-badge ng-scope-badge--#{@user.access_scope}"}>
                <%= @user.access_scope %>
              </span>
            </dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>
              <%= if dsbl? do %>
                <span class="ng-user-disabled-tag">Disabled</span>
                <span class="ng-td-muted">
                  <%= FzHttpWeb.UserLive.Show.relative_label(@user.disabled_at) %>
                </span>
              <% else %>
                Active
              <% end %>
            </dd>
          </div>
        </dl>
      </div>

      <%# Activity %>
      <div class="ng-user-overview-zone">
        <div class="ng-user-overview-zone-title">
          <i class="mdi mdi-pulse"></i> Activity
        </div>
        <dl class="ng-user-overview-list">
          <div>
            <dt>Last sign-in</dt>
            <dd class="ng-td-muted">
              <%= FzHttpWeb.UserLive.Show.relative_label(@user.last_signed_in_at) %>
            </dd>
          </div>
          <div>
            <dt>Auth method</dt>
            <dd class="ng-td-muted"><%= @user.last_signed_in_method || "—" %></dd>
          </div>
          <div>
            <dt>Last VPN</dt>
            <dd class="ng-td-muted">
              <%= FzHttpWeb.UserLive.Show.relative_label(@user.last_handshake) %>
            </dd>
          </div>
          <div>
            <dt>Last activity</dt>
            <dd class="ng-td-muted">
              <%= FzHttpWeb.UserLive.Show.relative_label(last_act) %>
            </dd>
          </div>
        </dl>
      </div>

      <%# Access %>
      <div class="ng-user-overview-zone">
        <div class="ng-user-overview-zone-title">
          <i class="mdi mdi-key-outline"></i> Access
        </div>
        <dl class="ng-user-overview-list">
          <div>
            <dt>Devices</dt>
            <dd>
              <%= length(@devices) %>
              <%= if length(@devices) > 0 do %>
                <span class="ng-td-muted">·
                  <%= Enum.count(@devices, &(&1.status == "approved")) %> approved
                </span>
              <% end %>
            </dd>
          </div>
          <div>
            <dt>Groups</dt>
            <dd>
              <%= length(@user_groups) %>
              <%= if length(@user_groups) > 0 do %>
                <span class="ng-td-muted">·
                  <%= @user_groups
                      |> Enum.map(& &1.name)
                      |> Enum.take(2)
                      |> Enum.join(", ") %><%= if length(@user_groups) > 2, do: " +#{length(@user_groups) - 2}" %>
                </span>
              <% end %>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>

<% end %>

<%= if @tab == :groups do %>
  <%# ── L7 Group Memberships ────────────────────────────────────────────────── %>
  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header" style="margin:0">
        <i class="mdi mdi-account-group-outline"></i> Group Memberships
        <span class="ng-section-badge"><%= length(@user_groups) %></span>
      </span>
    </div>

    <div class="ng-detail-card-body">
      <%= if @available_groups != [] do %>
        <form id="add-to-group-form" phx-submit="add_to_group" class="ng-form-inline" autocomplete="off">
          <div class="ng-field" style="flex: 1; margin: 0;">
            <label class="ng-label">Add to group</label>
            <select name="group_id" class="ng-input" required>
              <option value="">Select a group…</option>
              <%= for g <- @available_groups do %>
                <option value={g.id}><%= g.name %></option>
              <% end %>
            </select>
          </div>
          <button type="submit" class="ng-primary-btn" style="align-self: flex-end;">
            <i class="mdi mdi-plus"></i> Add
          </button>
        </form>
      <% else %>
        <p class="ng-form-hint">
          <%= if @user_groups == [] do %>
            <i class="mdi mdi-information-outline"></i>
            No access groups defined yet.
            <.link navigate={~p"/access-groups"}>Create one</.link> to start gating L7 apps.
          <% else %>
            This user is in every existing group.
          <% end %>
        </p>
      <% end %>
    </div>

    <%= if @user_groups == [] do %>
      <div class="ng-detail-card-body--bottom">
        <div class="ng-empty-state ng-empty-state--inline">
          <p class="ng-empty-state-hint">
            Not in any groups. Without membership, this user cannot reach any
            L7-managed application that requires a group (unless
            <code>access_scope</code> on the Access tab is set to <strong>all</strong>).
          </p>
        </div>
      </div>
    <% else %>
      <div class="ng-table-wrap" style="border-top: 1px solid #e2e8f0;">
        <table class="ng-table">
          <thead>
            <tr>
              <th>Group</th>
              <th>Source</th>
              <th>Description</th>
              <th class="ng-th-center" style="width: 3rem;"></th>
            </tr>
          </thead>
          <tbody>
            <%= for g <- @user_groups do %>
              <tr id={"user-group-#{g.id}"}>
                <td>
                  <div class="ng-user-cell">
                    <div class="ng-avatar ng-avatar--group">
                      <i class="mdi mdi-account-group-outline"></i>
                    </div>
                    <div class="ng-user-info">
                      <.link navigate={~p"/access-groups/#{g.id}"} class="ng-user-email">
                        <%= g.name %>
                      </.link>
                    </div>
                  </div>
                </td>
                <td>
                  <span class={"ng-source-badge ng-source-badge--#{g.source}"}>
                    <%= g.source %>
                  </span>
                </td>
                <td class="ng-td-muted">
                  <%= g.description || "—" %>
                </td>
                <td class="ng-td-center">
                  <button
                    class="ng-dismiss-btn"
                    title="Remove from group"
                    phx-click="confirm_remove_from_group"
                    phx-value-group_id={g.id}
                  >
                    <i class="mdi mdi-account-minus-outline"></i>
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

<% end %>

<%= if @tab == :access do %>
  <%# ── L7 Access Scope ─────────────────────────────────────────────────────── %>
  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header" style="margin:0">
        <i class="mdi mdi-shield-key-outline"></i> L7 Access Scope
      </span>
      <span class={"ng-scope-badge ng-scope-badge--#{@user.access_scope}"}>
        <%= @user.access_scope %>
      </span>
    </div>
    <div class="ng-detail-card-body">
      <p class="ng-form-hint">
        Controls whether L7-managed apps enforce group membership for this user.
        <strong>Limited</strong> is the default — normal group-intersection check applies.
        <strong>All</strong> is a break-glass bypass that lets the user reach every
        managed app without group membership. Use sparingly; every change is audited.
      </p>

      <div class="ng-form-inline" style="margin-top:1rem">
        <%= if @user.access_scope == :limited do %>
          <button
            class="ng-danger-btn"
            phx-click="confirm_set_access_scope"
            phx-value-scope="all"
          >
            <i class="mdi mdi-key-variant"></i> Grant bypass (set to ALL)
          </button>
        <% else %>
          <button
            class="ng-secondary-btn"
            phx-click="confirm_set_access_scope"
            phx-value-scope="limited"
          >
            <i class="mdi mdi-shield-check-outline"></i> Revert to LIMITED
          </button>
        <% end %>
      </div>
    </div>
  </div>

<% end %>

<%= if @tab == :connections do %>
  <%# ── OIDC Connections ────────────────────────────────────────────────────── %>
  <%= if length(@connections) > 0 do %>
    <.live_component
      id="connections-table"
      module={FzHttpWeb.OIDCLive.ConnectionsTableComponent}
      connections={@connections}
      user={@user}
    />
  <% else %>
    <div class="ng-detail-card">
      <div class="ng-detail-card-header">
        <span class="ng-section-header" style="margin:0">
          <i class="mdi mdi-link-variant"></i> OIDC connections
        </span>
      </div>
      <div class="ng-detail-card-body">
        <p class="ng-form-hint">
          <i class="mdi mdi-information-outline"></i>
          Not linked to any OIDC provider — this user signs in
          locally. To enable SSO sign-in, configure an OIDC
          provider in <.link navigate={~p"/settings/security"}>Security settings</.link>
          and have the user sign in via the SSO flow once; the
          connection appears here automatically.
        </p>
      </div>
    </div>
  <% end %>
<% end %>

<%= if @tab == :devices do %>
  <%# ── Devices ─────────────────────────────────────────────────────────────── %>
  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header" style="margin:0">
        <i class="mdi mdi-laptop"></i> Devices
        <span class="ng-section-badge"><%= length(@devices) %></span>
      </span>
      <.link
        patch={~p"/users/#{@user}/new_device"}
        replace={true}
        class="ng-secondary-btn ng-btn--sm"
      >
        <i class="mdi mdi-plus"></i> Add Device
      </.link>
    </div>
    <%= if length(@devices) > 0 do %>
      <%= render(FzHttpWeb.SharedView, "devices_table.html",
        devices: @devices,
        show_user: false,
        socket: @socket
      ) %>
    <% else %>
      <div class="ng-empty-state" style="padding:2.5rem 1.5rem">
        <i class="mdi mdi-laptop ng-empty-state-icon"></i>
        <p class="ng-empty-state-title">No devices yet</p>
        <p class="ng-empty-state-hint">Add a device to enroll a NexGuard Connect client.</p>
      </div>
    <% end %>
  </div>

<% end %>

<%= if @tab == :danger do %>
  <%# ── Danger Zone ─────────────────────────────────────────────────────────── %>
  <div class="ng-danger-zone">
    <div class="ng-danger-zone-header">
      <i class="mdi mdi-alert-octagon"></i> Danger Zone
    </div>
    <div class="ng-danger-zone-body">
      <div class="ng-danger-zone-item">
        <div>
          <div class="ng-danger-zone-label">VPN Connection</div>
          <p class="ng-danger-zone-desc">Enable or disable this user's VPN connection. Applies to all their devices.</p>
        </div>
        <.live_component
          id="allowed-to-connect"
          module={FzHttpWeb.UserLive.VPNConnectionComponent}
          user={@user}
          current_user={@current_user}
          remote_ip={@remote_ip}
        />
      </div>
      <hr style="border:none;border-top:1px solid #fee2e2;margin:1.25rem 0" />
      <div class="ng-danger-zone-item">
        <div>
          <div class="ng-danger-zone-label">Promote or Demote User</div>
          <p class="ng-danger-zone-desc">Promote to admin or demote to unprivileged role.</p>
        </div>
        <button class="ng-danger-btn" phx-click="open_mote_confirm">
          <i class={"mdi #{mote_icon(@user)}"}></i>
          <%= mote(@user) %> User
        </button>
      </div>
      <hr style="border:none;border-top:1px solid #fee2e2;margin:1.25rem 0" />
      <div class="ng-danger-zone-item">
        <div>
          <div class="ng-danger-zone-label">Delete User</div>
          <p class="ng-danger-zone-desc">Permanently delete this user and all their devices. This action cannot be undone.</p>
        </div>
        <button class="ng-danger-btn" phx-click="confirm_delete">
          <i class="mdi mdi-delete"></i> Delete User
        </button>
      </div>
    </div>
  </div>
<% end %>
</section>
