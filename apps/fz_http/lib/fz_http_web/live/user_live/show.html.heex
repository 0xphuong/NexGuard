<%= if @live_action == :edit do %>
  <%= live_modal(
    FzHttpWeb.UserLive.FormComponent,
    return_to: ~p"/users/#{@user}",
    title: "Edit #{@user.email}",
    id: "user-form-component",
    user: @user,
    current_user: @current_user,
    subject: @subject,
    remote_ip: @remote_ip,
    action: @live_action,
    form: "user-form"
  ) %>
<% end %>
<%= if @live_action == :new_device do %>
  <%= live_modal(
    FzHttpWeb.DeviceLive.NewFormComponent,
    return_to: ~p"/users/#{@user}",
    title: "Add Device",
    wide: true,
    current_user: @current_user,
    subject: @subject,
    remote_ip: @remote_ip,
    user: @user,
    id: "create-device-component",
    form: "create-device",
    button_text: "Generate Configuration"
  ) %>
<% end %>

<%# ── Delete Confirmation Modal ────────────────────────────────────────────── %>
<%= if @show_delete_confirm do %>
  <div class="modal is-active"
       phx-window-keydown="cancel_delete"
       phx-key="escape">
    <div class="modal-background" phx-click="cancel_delete"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">
          <i class="mdi mdi-alert-octagon ng-modal-title-icon"></i>
          Delete User
        </p>
        <button class="ng-modal-close" aria-label="Close" phx-click="cancel_delete">
          <i class="mdi mdi-close"></i>
        </button>
      </header>
      <section class="modal-card-body">
        <p class="ng-modal-intro">You are about to permanently delete:</p>
        <div class="ng-modal-entity"><%= @user.email %></div>
        <p class="ng-modal-cons">This will also:</p>
        <ul class="ng-modal-list">
          <li>Delete all associated devices</li>
          <li>Instantly drop any active VPN sessions</li>
        </ul>
        <p class="ng-modal-warn">This action cannot be undone.</p>
      </section>
      <footer class="modal-card-foot">
        <button class="ng-secondary-btn" phx-click="cancel_delete">Cancel</button>
        <button
          class="ng-danger-btn ng-danger-btn--filled"
          phx-click="delete_user"
          phx-value-user_id={@user.id}
        >
          <i class="mdi mdi-delete"></i> Delete User
        </button>
      </footer>
    </div>
  </div>
<% end %>

<%# ── Promote / Demote Confirmation Modal ─────────────────────────────────── %>
<%= if @show_mote_confirm do %>
  <div class="modal is-active"
       phx-window-keydown="cancel_mote"
       phx-key="escape">
    <div class="modal-background" phx-click="cancel_mote"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">
          <i class={"mdi #{mote_icon(@user)} ng-modal-title-icon"}></i>
          <%= mote(@user) %> User
        </p>
        <button class="ng-modal-close" aria-label="Close" phx-click="cancel_mote">
          <i class="mdi mdi-close"></i>
        </button>
      </header>
      <section class="modal-card-body">
        <p class="ng-modal-intro">You are about to change the role for:</p>
        <div class="ng-modal-entity"><%= @user.email %></div>
        <div class="ng-mote-transition">
          <span class="ng-mote-badge"><%= @user.role %></span>
          <i class="mdi mdi-arrow-right ng-mote-arrow"></i>
          <span class="ng-mote-badge ng-mote-badge--target"><%= mote_target_role(@user) %></span>
        </div>
        <p class="ng-modal-desc"><%= mote_message(@user) %></p>
      </section>
      <footer class="modal-card-foot">
        <button class="ng-secondary-btn" phx-click="cancel_mote">Cancel</button>
        <button
          class="ng-danger-btn ng-danger-btn--filled"
          phx-click="confirm_mote"
          phx-value-user_id={@user.id}
        >
          <i class={"mdi #{mote_icon(@user)}"}></i> <%= mote(@user) %> User
        </button>
      </footer>
    </div>
  </div>
<% end %>

<%# ── Page Header ──────────────────────────────────────────────────────────── %>
<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div class="ng-user-cell">
      <div class={"ng-avatar ng-avatar--lg ng-avatar--#{@user.role}"}>
        <%= @user.email |> String.first() |> String.upcase() %>
      </div>
      <div class="ng-user-info">
        <div style="display:flex;align-items:center;gap:0.3rem;flex-wrap:wrap">
          <.link navigate={~p"/users"} class="ng-breadcrumb">Users</.link>
          <span class="ng-breadcrumb-sep">/</span>
          <h1 class="ng-page-title" style="margin:0"><%= @user.email %></h1>
        </div>
        <div style="display:flex;align-items:center;gap:0.5rem;margin-top:0.25rem">
          <span class={"ng-role-badge ng-role-badge--#{@user.role}"}><%= @user.role %></span>
          <FzHttpWeb.UserLive.VPNStatusComponent.status
            user={@user}
            expired={vpn_expired?(@user)}
          />
        </div>
      </div>
    </div>
    <.link patch={~p"/users/#{@user}/edit"} replace={true} class="ng-secondary-btn">
      <i class="mdi mdi-pencil"></i> Edit
    </.link>
  </div>
</div>

<section class="section is-main-section">
  <%= render(FzHttpWeb.SharedView, "flash.html", assigns) %>

  <%# ── Profile ─────────────────────────────────────────────────────────────── %>
  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header" style="margin:0">
        <i class="mdi mdi-account-outline"></i> Profile
      </span>
    </div>
    <%= render(FzHttpWeb.SharedView, "user_details.html",
      user: @user,
      rules_path: @rules_path,
      subject: @subject
    ) %>
  </div>

  <%# ── L7 Group Memberships ────────────────────────────────────────────────── %>
  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header" style="margin:0">
        <i class="mdi mdi-account-group-outline"></i> Group Memberships
        <span class="ng-section-badge"><%= length(@user_groups) %></span>
      </span>
    </div>

    <div style="padding: 1.25rem 1.5rem;">
      <%= if @available_groups != [] do %>
        <form id="add-to-group-form" phx-submit="add_to_group" class="ng-form-inline" autocomplete="off">
          <div class="ng-field" style="flex: 1; margin: 0;">
            <label class="ng-label">Add to group</label>
            <select name="group_id" class="ng-input" required>
              <option value="">Select a group…</option>
              <%= for g <- @available_groups do %>
                <option value={g.id}><%= g.name %></option>
              <% end %>
            </select>
          </div>
          <button type="submit" class="ng-primary-btn" style="align-self: flex-end;">
            <i class="mdi mdi-plus"></i> Add
          </button>
        </form>
      <% else %>
        <p class="ng-td-muted" style="margin-bottom:1rem">
          <%= if @user_groups == [] do %>
            <i class="mdi mdi-information-outline"></i>
            No access groups defined yet.
            <.link navigate={~p"/access-groups"}>Create one</.link> to start gating L7 apps.
          <% else %>
            This user is in every existing group.
          <% end %>
        </p>
      <% end %>
    </div>

    <%= if @user_groups == [] do %>
      <div style="padding: 0 1.5rem 1.5rem;">
        <div class="ng-empty-state ng-empty-state--inline">
          <p class="ng-empty-state-hint">
            Not in any groups. Without membership, this user cannot reach any
            L7-managed application that requires a group (unless
            <code>access_scope</code> below is set to <strong>all</strong>).
          </p>
        </div>
      </div>
    <% else %>
      <div class="ng-table-wrap" style="border-top: 1px solid #e2e8f0;">
        <table class="ng-table">
          <thead>
            <tr>
              <th>Group</th>
              <th>Source</th>
              <th>Description</th>
              <th class="ng-th-center" style="width: 3rem;"></th>
            </tr>
          </thead>
          <tbody>
            <%= for g <- @user_groups do %>
              <tr id={"user-group-#{g.id}"}>
                <td>
                  <div class="ng-user-cell">
                    <div class="ng-avatar ng-avatar--group">
                      <i class="mdi mdi-account-group-outline"></i>
                    </div>
                    <div class="ng-user-info">
                      <.link navigate={~p"/access-groups/#{g.id}"} class="ng-user-email">
                        <%= g.name %>
                      </.link>
                    </div>
                  </div>
                </td>
                <td>
                  <span class={"ng-source-badge ng-source-badge--#{g.source}"}>
                    <%= g.source %>
                  </span>
                </td>
                <td class="ng-td-muted">
                  <%= g.description || "—" %>
                </td>
                <td class="ng-td-center">
                  <button
                    class="ng-dismiss-btn"
                    title="Remove from group"
                    phx-click="remove_from_group"
                    phx-value-group_id={g.id}
                    data-confirm={"Remove #{@user.email} from #{g.name}?"}
                  >
                    <i class="mdi mdi-account-minus-outline"></i>
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <%# ── L7 Access Scope ─────────────────────────────────────────────────────── %>
  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header" style="margin:0">
        <i class="mdi mdi-shield-key-outline"></i> L7 Access Scope
      </span>
      <span class={"ng-scope-badge ng-scope-badge--#{@user.access_scope}"}>
        <%= @user.access_scope %>
      </span>
    </div>
    <div style="padding: 1.25rem 1.5rem;">
      <p class="ng-form-hint" style="margin-top:0">
        Controls whether L7-managed apps enforce group membership for this user.
        <strong>Limited</strong> is the default — normal group-intersection check applies.
        <strong>All</strong> is a break-glass bypass that lets the user reach every
        managed app without group membership. Use sparingly; every change is audited.
      </p>

      <div class="ng-form-inline" style="margin-top:1rem">
        <%= if @user.access_scope == :limited do %>
          <button
            class="ng-danger-btn"
            phx-click="set_access_scope"
            phx-value-scope="all"
            data-confirm={"Grant ALL-apps bypass to #{@user.email}? This is a break-glass action and will be audited."}
          >
            <i class="mdi mdi-key-variant"></i> Grant bypass (set to ALL)
          </button>
        <% else %>
          <button
            class="ng-secondary-btn"
            phx-click="set_access_scope"
            phx-value-scope="limited"
            data-confirm={"Revert #{@user.email} to LIMITED scope? Group-intersection will be enforced again."}
          >
            <i class="mdi mdi-shield-check-outline"></i> Revert to LIMITED
          </button>
        <% end %>
      </div>
    </div>
  </div>

  <%# ── OIDC Connections ────────────────────────────────────────────────────── %>
  <%= if length(@connections) > 0 do %>
    <.live_component
      id="connections-table"
      module={FzHttpWeb.OIDCLive.ConnectionsTableComponent}
      connections={@connections}
      user={@user}
    />
  <% end %>

  <%# ── Devices ─────────────────────────────────────────────────────────────── %>
  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header" style="margin:0">
        <i class="mdi mdi-laptop"></i> Devices
        <span class="ng-section-badge"><%= length(@devices) %></span>
      </span>
      <.link
        patch={~p"/users/#{@user}/new_device"}
        replace={true}
        class="ng-secondary-btn ng-btn--sm"
      >
        <i class="mdi mdi-plus"></i> Add Device
      </.link>
    </div>
    <%= if length(@devices) > 0 do %>
      <%= render(FzHttpWeb.SharedView, "devices_table.html",
        devices: @devices,
        show_user: false,
        socket: @socket
      ) %>
    <% else %>
      <div class="ng-empty-state" style="padding:2.5rem 1.5rem">
        <i class="mdi mdi-laptop ng-empty-state-icon"></i>
        <p class="ng-empty-state-title">No devices yet</p>
        <p class="ng-empty-state-hint">Add a device to generate a WireGuard config.</p>
      </div>
    <% end %>
  </div>

  <%# ── Danger Zone ─────────────────────────────────────────────────────────── %>
  <div class="ng-danger-zone">
    <div class="ng-danger-zone-header">
      <i class="mdi mdi-alert-octagon"></i> Danger Zone
    </div>
    <div class="ng-danger-zone-body">
      <div class="ng-danger-zone-item">
        <div>
          <div class="ng-danger-zone-label">VPN Connection</div>
          <p class="ng-danger-zone-desc">Enable or disable this user's VPN connection. Applies to all their devices.</p>
        </div>
        <.live_component
          id="allowed-to-connect"
          module={FzHttpWeb.UserLive.VPNConnectionComponent}
          user={@user}
          current_user={@current_user}
          remote_ip={@remote_ip}
        />
      </div>
      <hr style="border:none;border-top:1px solid #fee2e2;margin:1.25rem 0" />
      <div class="ng-danger-zone-item">
        <div>
          <div class="ng-danger-zone-label">Promote or Demote User</div>
          <p class="ng-danger-zone-desc">Promote to admin or demote to unprivileged role.</p>
        </div>
        <button class="ng-danger-btn" phx-click="open_mote_confirm">
          <i class={"mdi #{mote_icon(@user)}"}></i>
          <%= mote(@user) %> User
        </button>
      </div>
      <hr style="border:none;border-top:1px solid #fee2e2;margin:1.25rem 0" />
      <div class="ng-danger-zone-item">
        <div>
          <div class="ng-danger-zone-label">Delete User</div>
          <p class="ng-danger-zone-desc">Permanently delete this user and all their devices. This action cannot be undone.</p>
        </div>
        <button class="ng-danger-btn" phx-click="confirm_delete">
          <i class="mdi mdi-delete"></i> Delete User
        </button>
      </div>
    </div>
  </div>
</section>
