<%= if @live_action == :edit do %>
  <%= live_modal(
    FzHttpWeb.UserLive.FormComponent,
    return_to: ~p"/users/#{@user}",
    title: "Edit #{@user.email}",
    id: "user-form-component",
    user: @user,
    current_user: @current_user,
    subject: @subject,
    action: @live_action,
    form: "user-form"
  ) %>
<% end %>
<%= if @live_action == :new_device do %>
  <%= live_modal(
    FzHttpWeb.DeviceLive.NewFormComponent,
    return_to: ~p"/users/#{@user}",
    title: "Add Device",
    current_user: @current_user,
    subject: @subject,
    user: @user,
    id: "create-device-component",
    form: "create-device",
    button_text: "Generate Configuration"
  ) %>
<% end %>

<%# ── Delete Confirmation Modal ────────────────────────────────────────────── %>
<%= if @show_delete_confirm do %>
  <div class="modal is-active"
       phx-window-keydown="cancel_delete"
       phx-key="escape">
    <div class="modal-background" phx-click="cancel_delete"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">
          <i class="mdi mdi-alert-octagon" style="color:#dc2626;margin-right:0.4rem"></i>
          Delete User
        </p>
        <button class="ng-modal-close" aria-label="Close" phx-click="cancel_delete">
          <i class="mdi mdi-close"></i>
        </button>
      </header>
      <section class="modal-card-body">
        <p style="color:#1e293b;margin-bottom:0.875rem">
          You are about to permanently delete:
        </p>
        <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:6px;
                    padding:0.625rem 0.875rem;margin-bottom:1.125rem;
                    font-family:'Fira Mono',monospace;font-size:0.9375rem;color:#991b1b">
          <%= @user.email %>
        </div>
        <p style="color:#475569;font-size:0.875rem;margin-bottom:0.5rem">
          This will also:
        </p>
        <ul style="color:#475569;font-size:0.875rem;padding-left:1.25rem;margin-bottom:1rem;line-height:1.75">
          <li>Delete all associated devices</li>
          <li>Instantly drop any active VPN sessions</li>
        </ul>
        <p style="color:#dc2626;font-size:0.8125rem;font-weight:600">
          This action cannot be undone.
        </p>
      </section>
      <footer class="modal-card-foot">
        <button class="ng-secondary-btn" phx-click="cancel_delete">
          Cancel
        </button>
        <button
          class="ng-danger-btn"
          phx-click="delete_user"
          phx-value-user_id={@user.id}
          style="background:#dc2626;color:#fff"
        >
          <i class="mdi mdi-delete"></i> Delete User
        </button>
      </footer>
    </div>
  </div>
<% end %>

<%# ── Promote / Demote Confirmation Modal ─────────────────────────────────── %>
<%= if @show_mote_confirm do %>
  <div class="modal is-active"
       phx-window-keydown="cancel_mote"
       phx-key="escape">
    <div class="modal-background" phx-click="cancel_mote"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">
          <i class={"mdi #{mote_icon(@user)}"} style="color:#dc2626;margin-right:0.4rem"></i>
          <%= mote(@user) %> User
        </p>
        <button class="ng-modal-close" aria-label="Close" phx-click="cancel_mote">
          <i class="mdi mdi-close"></i>
        </button>
      </header>
      <section class="modal-card-body">
        <p style="color:#1e293b;margin-bottom:0.875rem">
          You are about to change the role for:
        </p>
        <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:6px;
                    padding:0.625rem 0.875rem;margin-bottom:1.125rem;
                    font-family:'Fira Mono',monospace;font-size:0.9375rem;color:#991b1b">
          <%= @user.email %>
        </div>
        <div style="display:flex;align-items:center;gap:0.625rem;margin-bottom:1rem;font-size:0.875rem">
          <span style="background:#f1f5f9;border:1px solid #e2e8f0;border-radius:5px;
                       padding:0.25rem 0.625rem;color:#475569;font-weight:600">
            <%= @user.role %>
          </span>
          <i class="mdi mdi-arrow-right" style="color:#94a3b8"></i>
          <span style="background:#f1f5f9;border:1px solid #e2e8f0;border-radius:5px;
                       padding:0.25rem 0.625rem;color:#1e293b;font-weight:600">
            <%= mote_target_role(@user) %>
          </span>
        </div>
        <p style="color:#475569;font-size:0.875rem;line-height:1.6">
          <%= mote_message(@user) %>
        </p>
      </section>
      <footer class="modal-card-foot">
        <button class="ng-secondary-btn" phx-click="cancel_mote">
          Cancel
        </button>
        <button
          class="ng-danger-btn"
          phx-click="confirm_mote"
          phx-value-user_id={@user.id}
          style="background:#dc2626;color:#fff"
        >
          <i class={"mdi #{mote_icon(@user)}"}></i> <%= mote(@user) %> User
        </button>
      </footer>
    </div>
  </div>
<% end %>

<%# ── Page Header ──────────────────────────────────────────────────────────── %>
<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div class="ng-user-cell">
      <div class={"ng-avatar ng-avatar--lg ng-avatar--#{@user.role}"}>
        <%= @user.email |> String.first() |> String.upcase() %>
      </div>
      <div class="ng-user-info">
        <div style="display:flex;align-items:center;gap:0.3rem;flex-wrap:wrap">
          <.link navigate={~p"/users"} class="ng-breadcrumb">Users</.link>
          <span class="ng-breadcrumb-sep">/</span>
          <h1 class="ng-page-title" style="margin:0"><%= @user.email %></h1>
        </div>
        <div style="display:flex;align-items:center;gap:0.5rem;margin-top:0.25rem">
          <span class={"ng-role-badge ng-role-badge--#{@user.role}"}><%= @user.role %></span>
          <FzHttpWeb.UserLive.VPNStatusComponent.status
            user={@user}
            expired={vpn_expired?(@user)}
          />
        </div>
      </div>
    </div>
    <.link patch={~p"/users/#{@user}/edit"} replace={true} class="ng-secondary-btn">
      <i class="mdi mdi-pencil"></i> Edit
    </.link>
  </div>
</div>

<section class="section is-main-section">
  <%= render(FzHttpWeb.SharedView, "flash.html", assigns) %>

  <%# ── Profile ─────────────────────────────────────────────────────────────── %>
  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header" style="margin:0">
        <i class="mdi mdi-account-outline"></i> Profile
      </span>
    </div>
    <%= render(FzHttpWeb.SharedView, "user_details.html",
      user: @user,
      rules_path: @rules_path,
      subject: @subject
    ) %>
  </div>

  <%# ── OIDC Connections ────────────────────────────────────────────────────── %>
  <%= if length(@connections) > 0 do %>
    <.live_component
      id="connections-table"
      module={FzHttpWeb.OIDCLive.ConnectionsTableComponent}
      connections={@connections}
      user={@user}
    />
  <% end %>

  <%# ── Devices ─────────────────────────────────────────────────────────────── %>
  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header" style="margin:0">
        <i class="mdi mdi-laptop"></i> Devices
        <span class="ng-section-badge"><%= length(@devices) %></span>
      </span>
      <.link
        patch={~p"/users/#{@user}/new_device"}
        replace={true}
        class="ng-secondary-btn"
        style="font-size:0.8rem;padding:0.35rem 0.875rem"
      >
        <i class="mdi mdi-plus"></i> Add Device
      </.link>
    </div>
    <%= if length(@devices) > 0 do %>
      <%= render(FzHttpWeb.SharedView, "devices_table.html",
        devices: @devices,
        show_user: false,
        socket: @socket
      ) %>
    <% else %>
      <div class="ng-empty-state" style="padding:2.5rem 1.5rem">
        <i class="mdi mdi-laptop ng-empty-state-icon"></i>
        <p class="ng-empty-state-title">No devices yet</p>
        <p class="ng-empty-state-hint">Add a device to generate a WireGuard config.</p>
      </div>
    <% end %>
  </div>

  <%# ── Danger Zone ─────────────────────────────────────────────────────────── %>
  <div class="ng-danger-zone">
    <div class="ng-danger-zone-header">
      <i class="mdi mdi-alert-octagon"></i> Danger Zone
    </div>
    <div class="ng-danger-zone-body">
      <div class="ng-danger-zone-item">
        <div>
          <div class="ng-danger-zone-label">VPN Connection</div>
          <p class="ng-danger-zone-desc">Enable or disable this user's VPN connection. Applies to all their devices.</p>
        </div>
        <.live_component
          id="allowed-to-connect"
          module={FzHttpWeb.UserLive.VPNConnectionComponent}
          user={@user}
        />
      </div>
      <hr style="border:none;border-top:1px solid #fee2e2;margin:1.25rem 0" />
      <div class="ng-danger-zone-item">
        <div>
          <div class="ng-danger-zone-label">Promote or Demote User</div>
          <p class="ng-danger-zone-desc">Promote to admin or demote to unprivileged role.</p>
        </div>
        <button class="ng-danger-btn" phx-click="open_mote_confirm">
          <i class={"mdi #{mote_icon(@user)}"}></i>
          <%= mote(@user) %> User
        </button>
      </div>
      <hr style="border:none;border-top:1px solid #fee2e2;margin:1.25rem 0" />
      <div class="ng-danger-zone-item">
        <div>
          <div class="ng-danger-zone-label">Delete User</div>
          <p class="ng-danger-zone-desc">Permanently delete this user and all their devices. This action cannot be undone.</p>
        </div>
        <button class="ng-danger-btn" phx-click="confirm_delete">
          <i class="mdi mdi-delete"></i> Delete User
        </button>
      </div>
    </div>
  </div>
</section>
