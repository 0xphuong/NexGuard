<%= if @live_action == :new do %>
  <%= live_modal(
    FzHttpWeb.UserLive.FormComponent,
    return_to: ~p"/users",
    title: "Add User",
    id: "user-form-component",
    user: nil,
    current_user: @current_user,
    subject: @subject,
    remote_ip: @remote_ip,
    action: @live_action,
    form: "user-form"
  ) %>
<% end %>

<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div>
      <h1 class="ng-page-title">Users</h1>
      <p class="ng-page-subtitle"><%= length(@users) %> user<%= if length(@users) != 1, do: "s" %></p>
    </div>
    <.link replace={true} patch={~p"/users/new"} class="ng-primary-btn">
      <i class="mdi mdi-account-plus"></i> Add User
    </.link>
  </div>
</div>

<section class="section is-main-section">
  <%= render(FzHttpWeb.SharedView, "flash.html", assigns) %>

  <%= if @users == [] do %>
    <div class="ng-empty-state">
      <i class="mdi mdi-account-group ng-empty-state-icon"></i>
      <p class="ng-empty-state-title">No users yet</p>
      <p class="ng-empty-state-hint">Add a user to get started.</p>
    </div>
  <% else %>
    <div class="ng-table-wrap">
      <table class="ng-table">
        <thead>
          <tr>
            <th>User</th>
            <th class="ng-th-center">Devices</th>
            <th class="ng-th-center">VPN Status</th>
            <th>Last Sign In</th>
            <th>Auth Method</th>
            <th>Created</th>
          </tr>
        </thead>
        <tbody>
          <%= for user <- @users do %>
            <tr>
              <td>
                <div class="ng-user-cell">
                  <div class={"ng-avatar ng-avatar--#{user.role}"}>
                    <%= user.email |> String.first() |> String.upcase() %>
                  </div>
                  <div class="ng-user-info">
                    <.link navigate={~p"/users/#{user}"} class="ng-user-email">
                      <%= user.email %>
                    </.link>
                    <span class={"ng-role-badge ng-role-badge--#{user.role}"}>
                      <%= user.role %>
                    </span>
                  </div>
                </div>
              </td>
              <td class="ng-td-center" id={"user-#{user.id}-device-count"}>
                <span class="ng-device-count">
                  <i class="mdi mdi-laptop"></i> <%= user.device_count %>
                </span>
              </td>
              <td class="ng-td-center" id={"user-#{user.id}-vpn-status"}>
                <FzHttpWeb.UserLive.VPNStatusComponent.status
                  user={user}
                  expired={vpn_expired?(user)}
                />
              </td>
              <td
                id={"user-#{user.id}-timestamp"}
                data-timestamp={user.last_signed_in_at}
                phx-hook="FormatTimestamp"
                class="ng-td-muted"
              >
                …
              </td>
              <td class="ng-td-muted"><%= user.last_signed_in_method %></td>
              <td
                id={"user-#{user.id}-inserted-at"}
                data-timestamp={user.inserted_at}
                phx-hook="FormatTimestamp"
                class="ng-td-muted"
              >
                …
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
