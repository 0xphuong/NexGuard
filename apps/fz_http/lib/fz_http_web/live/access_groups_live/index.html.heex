<%= if @live_action == :new do %>
  <%= live_modal(
    FzHttpWeb.AccessGroupsLive.FormComponent,
    return_to: ~p"/access-groups",
    title: "New Access Group",
    id: "access-group-form-component",
    group: nil,
    subject: @subject,
    remote_ip: @remote_ip,
    action: @live_action,
    form: "access-group-form",
    button_text: "Create Group"
  ) %>
<% end %>

<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div>
      <h1 class="ng-page-title">Access Groups</h1>
      <p class="ng-page-subtitle">
        Group membership decides which users reach each L7-managed application.
      </p>
    </div>
    <.link replace={true} patch={~p"/access-groups/new"} class="ng-primary-btn">
      <i class="mdi mdi-account-multiple-plus"></i> New Group
    </.link>
  </div>
</div>

<section class="section is-main-section">
  <%= render(FzHttpWeb.SharedView, "flash.html", assigns) %>

  <%= if @all_groups == [] do %>
    <div class="ng-empty-state">
      <i class="mdi mdi-account-group ng-empty-state-icon"></i>
      <p class="ng-empty-state-title">No access groups yet</p>
      <p class="ng-empty-state-hint">
        Create a group to start gating which users reach your L7 apps.
      </p>
      <.link replace={true} patch={~p"/access-groups/new"} class="ng-primary-btn ng-empty-state-cta">
        <i class="mdi mdi-account-multiple-plus"></i> Create first group
      </.link>
    </div>
  <% else %>
    <%# ── Stats strip (org-wide pulse, derived from unfiltered list) %>
    <div class="ng-stat-strip">
      <div class="ng-stat-tile">
        <div class="ng-stat-tile-value"><%= length(@all_groups) %></div>
        <div class="ng-stat-tile-label">Groups</div>
      </div>
      <div class="ng-stat-tile">
        <div class="ng-stat-tile-value">
          <%= Enum.sum(Enum.map(@all_groups, & &1.member_count || 0)) %>
        </div>
        <div class="ng-stat-tile-label">Memberships</div>
      </div>
      <div class="ng-stat-tile">
        <div class="ng-stat-tile-value">
          <%= Enum.count(@all_groups, & &1.source == :manual) %>
        </div>
        <div class="ng-stat-tile-label">Manual</div>
      </div>
      <div class="ng-stat-tile">
        <div class="ng-stat-tile-value">
          <%= Enum.count(@all_groups, & &1.source == :idp_sync) %>
        </div>
        <div class="ng-stat-tile-label">IdP-synced</div>
      </div>
    </div>

    <%# ── Filter bar — search + source chip ─────────────────────── %>
    <.form
      :let={_f}
      for={%{}}
      as={:filters}
      phx-change="filter"
      class="ng-user-filterbar"
    >
      <div class="ng-user-filterbar-search">
        <i class="mdi mdi-magnify"></i>
        <input
          type="text"
          name="filters[search]"
          value={@filters["search"]}
          placeholder="Search by name or description…"
          class="ng-user-filterbar-input"
          phx-debounce="200"
          autocomplete="off"
        />
      </div>

      <select name="filters[source]" class="ng-user-filterbar-select">
        <%= for {label, value} <- @source_options do %>
          <option value={value} selected={value == @filters["source"]}><%= label %></option>
        <% end %>
      </select>

      <%= if FzHttpWeb.AccessGroupsLive.Index.filters_active?(@filters) do %>
        <button type="button" phx-click="reset_filters" class="ng-user-filterbar-reset">
          <i class="mdi mdi-close"></i> Reset
        </button>
      <% end %>

      <span class="ng-user-filterbar-count">
        <%= length(@groups) %> of <%= length(@all_groups) %>
      </span>
    </.form>

    <%# ── Groups list ──────────────────────────────────────────── %>
    <%= if @groups == [] do %>
      <div class="ng-empty-state ng-empty-state--inline">
        <p class="ng-empty-state-hint">
          No groups match the current filters.
          <button type="button" phx-click="reset_filters" class="ng-inline-link">Reset filters</button>
        </p>
      </div>
    <% else %>
    <div class="ng-table-wrap">
      <table class="ng-table">
        <thead>
          <tr>
            <th>Group</th>
            <th class="ng-th-center">Members</th>
            <th>Source</th>
            <th>Created</th>
            <th class="ng-th-center ng-th-narrow"></th>
          </tr>
        </thead>
        <tbody>
          <%= for group <- @groups do %>
            <tr id={"access-group-#{group.id}"}>
              <td>
                <div class="ng-user-cell">
                  <div class="ng-avatar ng-avatar--group">
                    <i class="mdi mdi-account-group-outline"></i>
                  </div>
                  <div class="ng-user-info">
                    <.link navigate={~p"/access-groups/#{group}"} class="ng-user-email">
                      <%= group.name %>
                    </.link>
                    <%= if group.description && group.description != "" do %>
                      <span class="ng-td-muted ng-td-meta"><%= group.description %></span>
                    <% end %>
                  </div>
                </div>
              </td>
              <td class="ng-td-center">
                <span class="ng-device-count">
                  <i class="mdi mdi-account"></i> <%= group.member_count || 0 %>
                </span>
              </td>
              <td>
                <span class={"ng-source-badge ng-source-badge--#{group.source}"}>
                  <%= group.source %>
                </span>
              </td>
              <td
                id={"access-group-#{group.id}-inserted-at"}
                data-timestamp={group.inserted_at}
                phx-hook="FormatTimestamp"
                class="ng-td-muted"
              >
                …
              </td>
              <td class="ng-td-center">
                <button
                  class="ng-dismiss-btn"
                  aria-label={"Delete group #{group.name}"}
                  phx-click="delete"
                  phx-value-id={group.id}
                  data-confirm={"Delete \"#{group.name}\"? Member assignments and any application reference to this group will also be removed."}
                >
                  <i class="mdi mdi-trash-can-outline"></i>
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% end %>
  <% end %>
</section>
