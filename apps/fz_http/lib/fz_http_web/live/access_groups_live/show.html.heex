<% writable? = FzHttpWeb.AccessGroupsLive.Show.writable?(@group) %>

<%# ── Delete Confirmation Modal ────────────────────────────────────────── %>
<%= if @show_delete_confirm do %>
  <div class="modal is-active" phx-window-keydown="cancel_delete" phx-key="escape">
    <div class="modal-background" phx-click="cancel_delete"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">
          <i class="mdi mdi-alert-octagon ng-modal-title-icon"></i>
          Delete Access Group
        </p>
        <button class="ng-modal-close" aria-label="Close" phx-click="cancel_delete">
          <i class="mdi mdi-close"></i>
        </button>
      </header>
      <section class="modal-card-body">
        <p class="ng-modal-intro">You are about to permanently delete:</p>
        <div class="ng-modal-entity"><%= @group.name %></div>
        <p class="ng-modal-cons">This will also:</p>
        <ul class="ng-modal-list">
          <li>Remove <%= length(@members) %> member assignment<%= if length(@members) != 1, do: "s" %></li>
          <li>Detach this group from every application that requires it</li>
        </ul>
        <p class="ng-modal-warn">This action cannot be undone.</p>
      </section>
      <footer class="modal-card-foot">
        <button class="ng-secondary-btn" phx-click="cancel_delete">Cancel</button>
        <button class="ng-danger-btn ng-danger-btn--filled" phx-click="delete_group">
          <i class="mdi mdi-delete"></i> Delete Group
        </button>
      </footer>
    </div>
  </div>
<% end %>

<%# ── Remove-Member Confirmation Modal ──────────────────────────────────── %>
<%= if @remove_member_confirm do %>
  <div class="modal is-active" phx-window-keydown="cancel_remove_member" phx-key="escape">
    <div class="modal-background" phx-click="cancel_remove_member"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">
          <i class="mdi mdi-account-minus-outline ng-modal-title-icon"></i>
          Remove Member
        </p>
        <button class="ng-modal-close" aria-label="Close" phx-click="cancel_remove_member">
          <i class="mdi mdi-close"></i>
        </button>
      </header>
      <section class="modal-card-body">
        <p class="ng-modal-intro">Remove this user from the group:</p>
        <div class="ng-modal-entity"><%= @remove_member_confirm.email %></div>
        <p class="ng-modal-desc">
          <strong><%= @remove_member_confirm.email %></strong> will lose access to any
          L7-managed application that requires <em><%= @group.name %></em>.
          You can re-add them later.
        </p>
      </section>
      <footer class="modal-card-foot">
        <button class="ng-secondary-btn" phx-click="cancel_remove_member">Cancel</button>
        <button class="ng-danger-btn ng-danger-btn--filled" phx-click="remove_member">
          <i class="mdi mdi-account-minus-outline"></i> Remove from group
        </button>
      </footer>
    </div>
  </div>
<% end %>

<%# ── Hero ──────────────────────────────────────────────────────────────── %>
<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div class="ng-app-hero">
      <div class="ng-avatar ng-avatar--lg ng-avatar--group">
        <i class="mdi mdi-account-group-outline"></i>
      </div>
      <div class="ng-app-hero-meta">
        <div class="ng-app-hero-breadcrumb">
          <.link navigate={~p"/access-groups"} class="ng-breadcrumb">Access Groups</.link>
          <span class="ng-breadcrumb-sep">/</span>
          <h1 class="ng-page-title"><%= @group.name %></h1>
        </div>
        <div class="ng-app-hero-status">
          <span class={"ng-source-badge ng-source-badge--#{@group.source}"}>
            <%= @group.source %>
          </span>
          <span class="ng-td-muted">·</span>
          <span class="ng-device-count">
            <i class="mdi mdi-account"></i>
            <%= length(@members) %> member<%= if length(@members) != 1, do: "s" %>
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<%# ── Tab navigation ───────────────────────────────────────────────────── %>
<nav class="ng-tab-nav">
  <.link patch={~p"/access-groups/#{@group}"}
         replace={true}
         class={["ng-tab", @tab == :overview && "is-active"]}>
    <i class="mdi mdi-information-outline"></i>
    <span>Overview</span>
  </.link>
  <.link patch={~p"/access-groups/#{@group}/members"}
         replace={true}
         class={["ng-tab", @tab == :members && "is-active"]}>
    <i class="mdi mdi-account-multiple"></i>
    <span>Members</span>
    <span class="ng-tab-count"><%= length(@members) %></span>
  </.link>
  <.link patch={~p"/access-groups/#{@group}/danger"}
         replace={true}
         class={["ng-tab ng-tab--danger", @tab == :danger && "is-active"]}>
    <i class="mdi mdi-alert-octagon-outline"></i>
    <span>Danger zone</span>
  </.link>
</nav>

<section class="section is-main-section">
  <%= render(FzHttpWeb.SharedView, "flash.html", assigns) %>

<%= if @tab == :overview do %>
  <%# ── 4-zone Overview card ─────────────────────────────────────
  %# Matches the pattern shipped for /users/:id and /applications/:id.
  %# Read-only summary; edit form sits below for manual groups. %>
  <% admin_count = Enum.count(@members, &(&1.user.role == :admin)) %>
  <% unpriv_count = length(@members) - admin_count %>

  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header">
        <i class="mdi mdi-account-group-outline"></i> Group overview
      </span>
    </div>
    <div class="ng-user-overview-grid">
      <%# ── Identity zone ── %>
      <div class="ng-user-overview-zone">
        <div class="ng-user-overview-zone-title">
          <i class="mdi mdi-account-group-outline"></i> Identity
        </div>
        <dl class="ng-user-overview-list">
          <div><dt>Name</dt><dd><%= @group.name %></dd></div>
          <div><dt>Description</dt>
            <dd>
              <%= if @group.description && @group.description != "" do %>
                <%= @group.description %>
              <% else %>
                <span class="ng-td-muted">—</span>
              <% end %>
            </dd></div>
          <div><dt>Created</dt>
            <dd
              id={"group-#{@group.id}-inserted-at"}
              data-timestamp={@group.inserted_at}
              phx-hook="FormatTimestamp"
            >…</dd></div>
        </dl>
      </div>

      <%# ── Source zone ── %>
      <div class="ng-user-overview-zone">
        <div class="ng-user-overview-zone-title">
          <i class="mdi mdi-source-branch"></i> Source
        </div>
        <dl class="ng-user-overview-list">
          <div><dt>Type</dt>
            <dd>
              <span class={"ng-source-badge ng-source-badge--#{@group.source}"}>
                <%= @group.source %>
              </span>
            </dd></div>
          <div><dt>Editable</dt>
            <dd>
              <%= if writable? do %>
                <span class="ng-rule-action-badge ng-rule-action-badge--allow">yes</span>
              <% else %>
                <span class="ng-rule-action-badge ng-rule-action-badge--deny">no</span>
              <% end %>
            </dd></div>
        </dl>
        <p class="ng-form-hint">
          <%= FzHttpWeb.AccessGroupsLive.Show.source_explanation(@group.source) %>
        </p>
      </div>

      <%# ── Membership zone ── %>
      <div class="ng-user-overview-zone">
        <div class="ng-user-overview-zone-title">
          <i class="mdi mdi-account-multiple"></i> Membership
        </div>
        <dl class="ng-user-overview-list">
          <div><dt>Total</dt>
            <dd>
              <%= length(@members) %>
              <.link patch={~p"/access-groups/#{@group}/members"}
                     replace={true}
                     class="ng-overview-link">View →</.link>
            </dd></div>
          <div><dt>Admin</dt>
            <dd><%= admin_count %></dd></div>
          <div><dt>Unprivileged</dt>
            <dd><%= unpriv_count %></dd></div>
        </dl>
      </div>

      <%# ── Visibility / L7 gate zone ── %>
      <div class="ng-user-overview-zone">
        <div class="ng-user-overview-zone-title">
          <i class="mdi mdi-shield-account-outline"></i> L7 gate
        </div>
        <p class="ng-form-hint">
          Applications that list this group in their <strong>Allowed groups</strong>
          tab will accept signed-in members of this group. The L7 proxy
          enforces the gate per request — no VPN traffic is granted by group
          membership alone.
        </p>
      </div>
    </div>
  </div>

  <%# ── Inline edit form — manual groups only ──────────────────── %>
  <%= if writable? do %>
    <div class="ng-detail-card">
      <div class="ng-detail-card-header">
        <span class="ng-section-header">
          <i class="mdi mdi-pencil-outline"></i> Edit
        </span>
      </div>
      <div class="ng-detail-card-body">
        <.form
          :let={f}
          for={@changeset}
          as={:group}
          id="group-edit-form"
          phx-change="validate"
          phx-submit="update"
        >
          <div class="ng-field">
            <%= label(f, :name, "Name", class: "ng-label") %>
            <%= text_input(f, :name,
                  class: "ng-input #{input_error_class(f, :name)}",
                  phx_debounce: "300",
                  required: true) %>
            <p class="ng-field-error"><%= error_tag(f, :name) %></p>
          </div>

          <div class="ng-field">
            <%= label(f, :description, "Description", class: "ng-label") %>
            <%= textarea(f, :description,
                  class: "ng-input #{input_error_class(f, :description)}",
                  rows: 3,
                  placeholder: "Optional context — what this group is for, who owns it.") %>
            <p class="ng-field-error"><%= error_tag(f, :description) %></p>
          </div>

          <div class="ng-form-actions">
            <%= submit("Save changes",
                  class: "ng-primary-btn",
                  phx_disable_with: "Saving…",
                  disabled: map_size(@changeset.changes) == 0) %>
          </div>
        </.form>
      </div>
    </div>
  <% else %>
    <div class="ng-modal-callout ng-modal-callout--warning">
      <i class="mdi mdi-lock-outline"></i>
      <span>
        <strong>Name and description managed externally.</strong>
        This group's metadata is owned by the
        <code><%= @group.source %></code> source — changes here would be
        overwritten on the next sync. Update at the source instead.
      </span>
    </div>
  <% end %>
<% end %>

<%= if @tab == :members do %>
  <%# ── IdP-sync constraint disclosure (App-Show-C precedent) ───
  %# Surface upfront for non-manual groups so admin doesn't try to
  %# add/remove and have it fail (or silently get overwritten on
  %# next sync). Mirror of the kernel-5.6.9 inline notice pattern. %>
  <%= if not writable? do %>
    <div class="ng-modal-callout ng-modal-callout--warning">
      <i class="mdi mdi-lock-outline"></i>
      <span>
        <strong>Members managed externally.</strong>
        <%= FzHttpWeb.AccessGroupsLive.Show.source_explanation(@group.source) %>
      </span>
    </div>
  <% end %>

  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header">
        <i class="mdi mdi-account-multiple"></i> Members
        <span class="ng-section-badge"><%= length(@members) %></span>
      </span>
    </div>

    <%# ── Add-member form — only for manual groups ──────────── %>
    <%= if writable? do %>
      <div class="ng-detail-card-body">
        <%= if @available_users == [] do %>
          <p class="ng-form-hint">
            <i class="mdi mdi-information-outline"></i>
            <%= if @members == [] do %>
              No users in the system yet. <.link navigate={~p"/users"} class="ng-inline-link">Create a user</.link> first to add as a member.
            <% else %>
              Every existing user is already a member of this group.
            <% end %>
          </p>
        <% else %>
          <form id="add-member-form" phx-submit="add_member" class="ng-form-inline" autocomplete="off">
            <div class="ng-field ng-field--grow">
              <label class="ng-label">Add member</label>
              <select name="user_id" class="ng-input" required>
                <option value="">Select a user…</option>
                <%= for user <- @available_users do %>
                  <option value={user.id}>
                    <%= user.email %><%= if user.role && user.role != :unprivileged, do: " · #{user.role}" %>
                  </option>
                <% end %>
              </select>
            </div>
            <button type="submit" class="ng-primary-btn ng-form-inline-btn">
              <i class="mdi mdi-account-plus"></i> Add
            </button>
          </form>
          <p class="ng-field-hint">
            <%= length(@available_users) %> user<%= if length(@available_users) != 1, do: "s" %> available (not yet a member).
          </p>
        <% end %>
      </div>
    <% end %>

    <%# ── Members table ──────────────────────────────────────── %>
    <%= if @members == [] do %>
      <div class="ng-detail-card-body--bottom">
        <div class="ng-empty-state ng-empty-state--inline">
          <p class="ng-empty-state-hint">
            <%= if writable? do %>
              No members yet. Add one via the picker above. They'll keep
              their VPN access unchanged — group membership only affects
              L7-managed apps.
            <% else %>
              No members synced yet from the upstream
              <code><%= @group.source %></code> source.
            <% end %>
          </p>
        </div>
      </div>
    <% else %>
      <div class="ng-table-wrap ng-table-wrap--flush">
        <table class="ng-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Source</th>
              <th>Added by</th>
              <th>Added</th>
              <%= if writable? do %>
                <th class="ng-th-center ng-th-narrow"></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <%= for m <- @members do %>
              <tr id={"member-#{m.user_id}"}>
                <td>
                  <div class="ng-user-cell">
                    <div class={"ng-avatar ng-avatar--#{m.user.role}"}>
                      <%= m.user.email |> String.first() |> String.upcase() %>
                    </div>
                    <div class="ng-user-info">
                      <.link navigate={~p"/users/#{m.user.id}"} class="ng-user-email">
                        <%= m.user.email %>
                      </.link>
                      <span class={"ng-role-badge ng-role-badge--#{m.user.role}"}>
                        <%= m.user.role %>
                      </span>
                    </div>
                  </div>
                </td>
                <td>
                  <span class={"ng-source-badge ng-source-badge--#{m.source}"}>
                    <%= m.source %>
                  </span>
                </td>
                <td class="ng-td-muted">
                  <%= if m.added_by, do: m.added_by.email, else: "—" %>
                </td>
                <td
                  id={"member-#{m.user_id}-inserted-at"}
                  data-timestamp={m.inserted_at}
                  phx-hook="FormatTimestamp"
                  class="ng-td-muted"
                >
                  …
                </td>
                <%= if writable? do %>
                  <td class="ng-td-center">
                    <button
                      class="ng-dismiss-btn"
                      aria-label={"Remove #{m.user.email} from group"}
                      phx-click="confirm_remove_member"
                      phx-value-user-id={m.user_id}
                    >
                      <i class="mdi mdi-account-minus-outline"></i>
                    </button>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
<% end %>

<%= if @tab == :danger do %>
  <%# ── Danger zone (works for all sources) ─────────────────────── %>
  <div class="ng-danger-zone">
    <div class="ng-danger-zone-header">
      <i class="mdi mdi-alert-octagon"></i>
      <span>Danger zone</span>
    </div>
    <div class="ng-danger-zone-body">
      <div class="ng-danger-zone-item">
        <div>
          <div class="ng-danger-zone-label">Delete this group</div>
          <p class="ng-danger-zone-desc">
            Removes every member assignment and detaches this group from any
            application that requires it. Member accounts are not affected.
            <%= if not writable? do %>
              <br />
              <strong>Note:</strong> If the upstream
              <code><%= @group.source %></code> source still references this
              group, it may be re-created on the next sync round.
            <% end %>
          </p>
        </div>
        <button class="ng-danger-btn" phx-click="show_delete_confirm">
          <i class="mdi mdi-trash-can-outline"></i> Delete group
        </button>
      </div>
    </div>
  </div>
<% end %>
</section>
