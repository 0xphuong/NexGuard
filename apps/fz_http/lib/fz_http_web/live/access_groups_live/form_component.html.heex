<div>
  <.form
    :let={f}
    for={@changeset}
    as={:group}
    id={@form}
    phx-target={@myself}
    phx-change="validate"
    phx-submit="save"
  >
    <p class="ng-modal-form-hint">
      Groups gate which users can reach L7-managed applications.
      Members are added on the next screen.
    </p>

    <div class="ng-field">
      <%= label(f, :name, "Name", class: "ng-label") %>
      <%= text_input(f, :name,
            class: "ng-input #{input_error_class(f, :name)}",
            placeholder: "engineering, wiki-readers, security-officers",
            autocomplete: "off",
            phx_debounce: "300") %>
      <p class="ng-field-error"><%= error_tag(f, :name) %></p>
      <p class="ng-field-hint">
        Letters, numbers, spaces, dashes, dots, underscores. 2–100 chars.
        Pick a name that maps to a real team if you plan to sync from an IdP later.
      </p>
    </div>

    <div class="ng-field">
      <%= label(f, :description, "Description", class: "ng-label") %>
      <%= textarea(f, :description,
            class: "ng-input #{input_error_class(f, :description)}",
            rows: 3,
            placeholder: "Optional — what this group is for, who owns it.") %>
      <p class="ng-field-error"><%= error_tag(f, :description) %></p>
    </div>
  </.form>
</div>
