<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div>
      <h1 class="ng-page-title">WAN Connectivity</h1>
      <p class="ng-page-subtitle">Diagnostics — internet reachability checks from this server</p>
    </div>
  </div>
</div>

<section class="section is-main-section">
  <%= render(FzHttpWeb.SharedView, "flash.html", assigns) %>

  <%# ── Current state callout ─────────────────────────────────
  %# Derives from the freshest check + the rolling 20 below. Green
  %# success variant when WAN is online; amber warning when the
  %# latest check failed. Skipped entirely when no checks have
  %# been recorded yet (the empty state below covers that case). %>
  <%= if @connectivity_checks != [] do %>
    <% latest = hd(@connectivity_checks) %>
    <% online? = connectivity_check_online?(latest.response_code) %>
    <% failures_count =
         Enum.count(@connectivity_checks, &(not connectivity_check_online?(&1.response_code))) %>

    <div class={["ng-modal-callout",
                  online? && "ng-modal-callout--success",
                  not online? && "ng-modal-callout--warning"]}>
      <i class={["mdi",
                 if(online?, do: "mdi-check-circle-outline", else: "mdi-alert-circle-outline")]}></i>
      <span>
        <strong>WAN is <%= if online?, do: "online", else: "offline" %>.</strong>
        <%= if online? do %>
          Public IP <code><%= latest.response_body %></code>.
        <% end %>
        Last checked
        <span
          id="latest-check-rel"
          phx-hook="FormatTimestamp"
          data-timestamp={latest.inserted_at}
        >…</span>.
        <%= if failures_count > 0 do %>
          <span class="ng-td-muted">
            (<%= failures_count %>/<%= length(@connectivity_checks) %> failures in the last <%= length(@connectivity_checks) %> checks)
          </span>
        <% end %>
      </span>
    </div>
  <% end %>

  <div class="ng-info-banner">
    <i class="mdi mdi-information-outline"></i>
    NexGuard periodically checks for WAN connectivity and logs the result here.
    The resolved public IP is used to populate the default <strong>Endpoint</strong> field
    in generated device configurations.
  </div>

  <div class="ng-section-header">
    Recent Checks
    <span class="ng-section-badge">last 20</span>
  </div>

  <%= if Enum.empty?(@connectivity_checks) do %>
    <div class="ng-settings-card">
      <div class="ng-empty-state">
        <i class="mdi mdi-wifi-off ng-empty-state-icon"></i>
        <p class="ng-empty-state-title">No checks recorded yet</p>
        <p class="ng-empty-state-hint">Connectivity checks will appear here once the server runs its first check.</p>
      </div>
    </div>
  <% else %>
    <div class="ng-table-wrap">
      <table class="ng-table">
        <thead>
          <tr>
            <th>Checked At</th>
            <th>Resolved IP</th>
            <th>HTTP Code</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <%= for check <- @connectivity_checks do %>
            <% row_online? = connectivity_check_online?(check.response_code) %>
            <tr class={[not row_online? && "ng-row--failure"]}>
              <td
                class="ng-td-muted"
                id={"connectivity_check-#{check.id}"}
                phx-hook="FormatTimestamp"
                data-timestamp={check.inserted_at}
              >…</td>
              <td class="ng-td-mono">
                <%= if check.response_body && check.response_body != "", do: check.response_body, else: "—" %>
              </td>
              <td class="ng-td-mono ng-td-muted">
                <%= check.response_code || "—" %>
              </td>
              <td>
                <span class={connectivity_check_span_class(check.response_code)}>
                  <i class={connectivity_check_icon_class(check.response_code)}></i>
                  <%= if row_online?, do: "Online", else: "Offline" %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

</section>
