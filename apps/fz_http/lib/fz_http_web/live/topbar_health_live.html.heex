<%# Inner wrapper class is what we style; the OUTER id="topbar-health"
%# is the Phoenix live_render container (different element). Two separate
%# IDs would clash, hence using a different id here. %>
<div id="topbar-health-inner" class="ng-topbar-health-group">
  <%= for {service, label, is_last} <- [
        {:db,      "DB",     false},
        {:coredns, "DNS",    false},
        {:proxy,   "Proxy",  true}    # last → carries the divider
      ] do %>
    <% state = Map.get(@snapshot, service, :unknown) %>
    <a
      class={["navbar-item", "ng-topnav-icon-btn",
              "ng-topnav-health", "ng-topnav-health--#{state}",
              is_last && "has-divider",
              @probing && "is-probing"]}
      role="button"
      tabindex="0"
      title={health_tooltip(service, state, @snapshot)}
      phx-click="probe_now"
      phx-disable-with="…"
    >
      <%# `<a>` instead of `<button>` because Bulma's `.navbar-item`
      %# styles assume an anchor — `<button>` carries browser defaults
      %# (smaller font, no flex) that broke vertical alignment with
      %# the WS / docs / notifications icons next to it.
      %#
      %# Dot + label are siblings (no extra .icon wrapper) so we get
      %# the same visual weight as the original design but inheriting
      %# proper navbar-item padding + height. %>
      <span class="ng-status-dot" aria-hidden="true"></span>
      <span class="ng-topnav-health-label"><%= label %></span>
    </a>
  <% end %>
</div>
