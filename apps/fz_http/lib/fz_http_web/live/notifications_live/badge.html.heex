<%= live_redirect(
  to: ~p"/notifications",
  title: @title,
  class: "navbar-item has-divider is-desktop-icon-only",
  style: "height: 100%"
) do %>
  <span class="icon" style="position: relative;">
    <%= if @count == 0 do %>
      <i class="mdi mdi-bell-outline" style="color: #64748b;"></i>
    <% else %>
      <i class="mdi mdi-bell-ring" style="color: #dc2626;"></i>
      <span class="ng-notif-count"><%= @count %></span>
    <% end %>
  </span>
<% end %>
