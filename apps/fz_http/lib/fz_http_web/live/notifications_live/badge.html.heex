<%= live_redirect(
  to: ~p"/notifications",
  title: @title,
  class: "navbar-item has-divider is-desktop-icon-only",
  style: "height: 100%"
) do %>
  <%= if @count == 0 do %>
    <span class="ng-notif-badge">
      <i class="mdi mdi-bell-outline"></i>
    </span>
  <% else %>
    <span class="ng-notif-badge ng-notif-badge--active">
      <i class="mdi mdi-bell-ring"></i>
      <span class="ng-notif-count"><%= @count %></span>
    </span>
  <% end %>
<% end %>
