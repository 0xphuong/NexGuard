<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div>
      <h1 class="ng-page-title">Notifications</h1>
      <p class="ng-page-subtitle">System events and alerts requiring your attention</p>
    </div>
    <div class="ng-notif-header-actions">
      <%= if Enum.any?(@notifications) do %>
        <span class="ng-notif-page-count">
          <i class="mdi mdi-bell-ring-outline"></i>
          <%= length(@notifications) %> active
        </span>
        <%= if length(@notifications) > 1 do %>
          <button
            class="ng-secondary-btn"
            phx-click="clear_all"
            data-confirm="Dismiss all notifications?"
          >
            <i class="mdi mdi-bell-off-outline"></i> Clear all
          </button>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<section class="section is-main-section">

  <%= if Enum.any?(@notifications) do %>
    <div class="ng-table-wrap">
      <table class="ng-table">
        <thead>
          <tr>
            <th class="ng-th-narrow"></th>
            <th>Time</th>
            <th>User</th>
            <th>Message</th>
            <th class="ng-th-narrow"></th>
          </tr>
        </thead>
        <tbody>
          <%= for {notification, index} <- Enum.with_index(@notifications) do %>
            <tr class={"ng-notif-row ng-notif-row--#{notification.type}"}>
              <td class="ng-td-center">
                <%= icon(notification.type, assigns) %>
              </td>
              <td
                class="ng-td-muted ng-td-nowrap"
                id={"notification-time-#{index}"}
                phx-hook="FormatTimestamp"
                data-timestamp={notification.timestamp}
              >…</td>
              <td class="ng-td-muted"><%= notification.user %></td>
              <td><%= notification.message %></td>
              <td class="ng-td-center">
                <button
                  class="ng-dismiss-btn"
                  aria-label="Dismiss notification"
                  phx-click="clear_notification"
                  phx-value-index={index}
                >
                  <i class="mdi mdi-close"></i>
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="ng-settings-card">
      <div class="ng-empty-state">
        <i class="mdi mdi-bell-check-outline ng-empty-state-icon"></i>
        <p class="ng-empty-state-title">All clear</p>
        <p class="ng-empty-state-hint">No notifications to display. You're up to date.</p>
      </div>
    </div>
  <% end %>

</section>
