<%# ── MFA Delete Confirmation Modal ──────────────────────────────────────── %>
<%= if @pending_mfa_delete do %>
  <div class="modal is-active"
       phx-window-keydown="cancel_mfa_delete"
       phx-key="escape">
    <div class="modal-background" phx-click="cancel_mfa_delete"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">
          <i class="mdi mdi-shield-remove-outline ng-modal-title-icon"></i>
          Delete Authenticator
        </p>
        <button class="ng-modal-close" aria-label="Close" phx-click="cancel_mfa_delete">
          <i class="mdi mdi-close"></i>
        </button>
      </header>
      <section class="modal-card-body">
        <p class="ng-modal-intro">You are about to delete:</p>
        <div class="ng-modal-entity"><%= @pending_mfa_delete.name %></div>

        <%# Computed lock-out warning — replaces the previous
        %# conditional-in-prose "if this is your only MFA method
        %# and Force MFA is enabled". When both conditions hold we
        %# upgrade to a danger callout the admin can't miss. %>
        <%= cond do %>
          <% @pending_mfa_delete.is_last and @pending_mfa_delete.force_mfa -> %>
            <div class="ng-modal-callout ng-modal-callout--danger">
              <i class="mdi mdi-alert-octagon"></i>
              <span>
                <strong>This is your only MFA method and Force MFA is enabled.</strong>
                Deleting it will force you to re-enroll on next sign-in
                before you can reach the portal.
              </span>
            </div>

          <% @pending_mfa_delete.is_last -> %>
            <div class="ng-modal-callout ng-modal-callout--warning">
              <i class="mdi mdi-alert-outline"></i>
              <span>
                This is your only MFA method. You can still sign in
                without one, but the account drops to single-factor
                until you enroll another.
              </span>
            </div>

          <% true -> %>
            <p class="ng-modal-desc">
              You will still have <%= length(@methods) - 1 %> other MFA
              method(s) after this is removed.
            </p>
        <% end %>
      </section>
      <footer class="modal-card-foot">
        <button class="ng-secondary-btn" phx-click="cancel_mfa_delete">Cancel</button>
        <button
          class="ng-danger-btn ng-danger-btn--filled"
          phx-click="delete_authenticator"
          phx-value-id={@pending_mfa_delete.id}
        >
          <i class="mdi mdi-trash-can-outline"></i> Delete
        </button>
      </footer>
    </div>
  </div>
<% end %>

<%# ── API Token Delete Confirmation Modal ────────────────────────────────── %>
<%= if @pending_token_delete do %>
  <div class="modal is-active"
       phx-window-keydown="cancel_token_delete"
       phx-key="escape">
    <div class="modal-background" phx-click="cancel_token_delete"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">
          <i class="mdi mdi-key-remove ng-modal-title-icon"></i>
          Delete API Token
        </p>
        <button class="ng-modal-close" aria-label="Close" phx-click="cancel_token_delete">
          <i class="mdi mdi-close"></i>
        </button>
      </header>
      <section class="modal-card-body">
        <p class="ng-modal-intro">Delete API token:</p>
        <div class="ng-modal-entity"><%= @pending_token_delete.id %></div>
        <p class="ng-modal-desc">
          Any services or scripts using this token will immediately lose API access.
        </p>
      </section>
      <footer class="modal-card-foot">
        <button class="ng-secondary-btn" phx-click="cancel_token_delete">Cancel</button>
        <button
          class="ng-danger-btn ng-danger-btn--filled"
          phx-click="delete_api_token"
          phx-value-id={@pending_token_delete.id}
        >
          <i class="mdi mdi-key-remove"></i> Delete Token
        </button>
      </footer>
    </div>
  </div>
<% end %>

<%# ── Delete Account Confirmation Modal ──────────────────────────────────── %>
<%= if @show_account_delete_confirm do %>
  <div class="modal is-active"
       phx-window-keydown="cancel_account_delete"
       phx-key="escape">
    <div class="modal-background" phx-click="cancel_account_delete"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">
          <i class="mdi mdi-alert-octagon ng-modal-title-icon"></i>
          Delete Your Account
        </p>
        <button class="ng-modal-close" aria-label="Close" phx-click="cancel_account_delete">
          <i class="mdi mdi-close"></i>
        </button>
      </header>
      <section class="modal-card-body">
        <p class="ng-modal-intro">You are about to permanently delete:</p>
        <div class="ng-modal-entity"><%= @current_user.email %></div>
        <p class="ng-modal-cons">This will also:</p>
        <ul class="ng-modal-list">
          <li>Delete all your devices and WireGuard configurations</li>
          <li>Revoke all your API tokens</li>
          <li>Drop all active VPN sessions immediately</li>
        </ul>
        <p class="ng-modal-warn">This action cannot be undone. You will be signed out immediately.</p>
      </section>
      <footer class="modal-card-foot">
        <button class="ng-secondary-btn" phx-click="cancel_account_delete">Cancel</button>
        <%= form_for @changeset, ~p"/user", [id: "delete-account", method: :delete], fn _f -> %>
          <%= submit(class: "ng-danger-btn ng-danger-btn--filled") do %>
            <i class="mdi mdi-trash-can-outline"></i> Delete My Account
          <% end %>
        <% end %>
      </footer>
    </div>
  </div>
<% end %>

<%# ── Modal triggers ──────────────────────────────────────────────── %>
<%= if @live_action == :edit do %>
  <%= live_modal(
    FzHttpWeb.SettingLive.AccountFormComponent,
    return_to: ~p"/settings/account",
    title: "Edit Account",
    id: "user-#{@current_user.id}",
    user: @current_user,
    subject: @subject,
    action: @live_action,
    form: "account-edit",
    button_text: "Save changes"
  ) %>
<% end %>

<%= if @live_action == :new_api_token do %>
  <%= live_modal(
    FzHttpWeb.SettingLive.NewApiTokenComponent,
    return_to: ~p"/settings/account",
    title: "Add API Token",
    id: "new_api_token",
    form: "api-token-form",
    user: @current_user,
    subject: @subject,
    changeset: FzHttp.ApiTokens.new_api_token()
  ) %>
<% end %>

<%= if @live_action == :show_api_token do %>
  <%= live_modal(
    FzHttpWeb.SettingLive.ShowApiTokenComponent,
    return_to: ~p"/settings/account",
    title: "API Token #{@api_token_id}",
    id: "show_api_token",
    hide_footer_content: true,
    user: @current_user,
    subject: @subject,
    api_token: @api_token
  ) %>
<% end %>

<%= if @live_action == :register_mfa do %>
  <.live_component
    module={FzHttpWeb.MFA.RegisterComponent}
    id="register-mfa"
    user={@current_user}
    return_to={~p"/settings/account"}
    subject={@subject}
  />
<% end %>

<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div>
      <h1 class="ng-page-title">Account Settings</h1>
      <p class="ng-page-subtitle">Manage your profile, sessions, API tokens, and MFA</p>
    </div>
    <.link replace={true} patch={~p"/settings/account/edit"} class="ng-primary-btn">
      <i class="mdi mdi-pencil-outline"></i> Edit Account
    </.link>
  </div>
</div>

<section class="section is-main-section">
  <%= render(FzHttpWeb.SharedView, "flash.html", assigns) %>

  <%# ── Stats strip — own-account security pulse ───────────── %>
  <% mfa_count = length(@methods) %>
  <% token_count = length(@api_tokens) %>
  <% token_max = FzHttp.ApiTokens.ApiToken.Changeset.max_per_user() %>
  <% session_count = length(@metas) %>
  <% admin? = @current_user.role == :admin %>

  <div class="ng-stat-strip">
    <div class={["ng-stat-tile",
                  mfa_count > 0 && "ng-stat-tile--ok",
                  mfa_count == 0 && "ng-stat-tile--danger"]}>
      <div class="ng-stat-tile-value"><%= mfa_count %></div>
      <div class="ng-stat-tile-label">
        <i class={["mdi",
                   if(mfa_count > 0, do: "mdi-shield-check-outline", else: "mdi-shield-alert-outline")]}></i>
        MFA methods
      </div>
    </div>
    <div class={["ng-stat-tile",
                  token_count >= token_max && "ng-stat-tile--warn"]}>
      <div class="ng-stat-tile-value ng-stat-tile-value--sm">
        <%= token_count %><span class="ng-td-muted">/<%= token_max %></span>
      </div>
      <div class="ng-stat-tile-label">
        <i class="mdi mdi-key-outline"></i> API tokens
      </div>
    </div>
    <div class="ng-stat-tile">
      <div class="ng-stat-tile-value"><%= session_count %></div>
      <div class="ng-stat-tile-label">
        <i class="mdi mdi-monitor-cellphone"></i> Active sessions
      </div>
    </div>
    <div class="ng-stat-tile">
      <div class="ng-stat-tile-value ng-stat-tile-value--sm">
        <%= if admin?, do: "Admin", else: "Unprivileged" %>
      </div>
      <div class="ng-stat-tile-label">
        <i class={["mdi",
                   if(admin?, do: "mdi-shield-crown-outline", else: "mdi-account-outline")]}></i>
        Role
      </div>
    </div>
  </div>

  <%# ── Profile ─────────────────────────────────────────────────── %>
  <div class="ng-section-header">Profile</div>
  <div class="ng-settings-card ng-account-profile">
    <%= render(FzHttpWeb.SharedView, "user_details.html",
      user: @current_user,
      subject: @subject
    ) %>
  </div>

  <%# ── Active Sessions ──────────────────────────────────────────── %>
  <div class="ng-section-header ng-section-header--spaced">Active Sessions</div>
  <p class="ng-section-desc">
    Your active NexGuard web sessions. Each row corresponds to an open browser tab.
    Rows from your current IP are highlighted.
  </p>
  <div class="ng-table-wrap ng-section-table">
    <table class="ng-table">
      <thead>
        <tr>
          <th>Came Online</th>
          <th>Last Signed In</th>
          <th>Remote IP</th>
          <th>User Agent</th>
        </tr>
      </thead>
      <tbody>
        <%= for {meta, index} <- Enum.with_index(@metas) do %>
          <% from_my_ip? = meta.remote_ip && meta.remote_ip == assigns[:remote_ip] %>
          <tr class={[from_my_ip? && "ng-session-row--current"]}>
            <td
              data-timestamp={meta.online_at}
              phx-hook="FormatTimestamp"
              id={"meta-#{index}-online-at"}
            >…</td>
            <td
              data-timestamp={meta.last_signed_in_at}
              phx-hook="FormatTimestamp"
              id={"meta-#{index}-last-signed-in-at"}
            >…</td>
            <td class="ng-td-mono ng-td-muted">
              <%= meta.remote_ip || "—" %>
              <%= if from_my_ip? do %>
                <span class="ng-source-badge ng-source-badge--idp_sync ng-session-current-tag">
                  this device
                </span>
              <% end %>
            </td>
            <td class="ng-td-muted"><%= meta.user_agent %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# ── API Tokens ───────────────────────────────────────────────── %>
  <div class="ng-provider-section">
    <div class="ng-provider-section-header">
      <div class="ng-provider-section-title-wrap">
        <span class="ng-provider-section-icon ng-provider-section-icon--token">
          <i class="mdi mdi-key-outline"></i>
        </span>
        <span class="ng-provider-section-title">API Tokens</span>
        <span class="ng-section-badge"><%= token_count %>/<%= token_max %></span>
      </div>
      <%= if token_count < token_max do %>
        <.link patch={~p"/settings/account/api_token"} class="ng-primary-btn">
          <i class="mdi mdi-plus"></i> Add Token
        </.link>
      <% end %>
    </div>

    <%= if Enum.empty?(@api_tokens) do %>
      <div class="ng-provider-empty">
        <i class="mdi mdi-key-off-outline ng-empty-state-icon"></i>
        <p class="ng-empty-state-title">No API tokens yet</p>
        <p class="ng-empty-state-hint">
          API tokens grant programmatic access to NexGuard's REST API
          for scripts and CI. Each token gets its own expiry; the
          secret is shown ONCE at creation.
        </p>
        <.link patch={~p"/settings/account/api_token"}
               class="ng-primary-btn ng-empty-state-cta">
          <i class="mdi mdi-plus"></i> Create your first token
        </.link>
      </div>
    <% else %>
      <div class="ng-table-wrap">
        <table class="ng-table">
          <thead>
            <tr>
              <th>Created</th>
              <th>Identifier</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <%= for api_token <- @api_tokens do %>
              <tr>
                <td
                  class="ng-td-muted"
                  data-timestamp={api_token.inserted_at}
                  phx-hook="FormatTimestamp"
                  id={"inserted_at-#{api_token.id}"}
                >…</td>
                <td>
                  <.link
                    patch={~p"/settings/account/api_token/#{api_token}"}
                    class="ng-action-link"
                    aria-label={"View API token #{api_token.id}"}
                  >
                    <i class="mdi mdi-key-variant"></i>
                    <code class="ng-td-mono"><%= api_token.id %></code>
                  </.link>
                </td>
                <td>
                  <%= if ApiTokens.api_token_expired?(api_token) do %>
                    <span class="ng-status-badge ng-status-badge--disabled">
                      <i class="mdi mdi-clock-alert-outline"></i> Expired
                    </span>
                  <% else %>
                    <span class="ng-status-badge ng-status-badge--enabled">
                      <i class="mdi mdi-check-circle-outline"></i> Active
                    </span>
                  <% end %>
                  <span
                    class="ng-td-muted ng-token-expiry"
                    data-timestamp={api_token.expires_at}
                    phx-hook="FormatTimestamp"
                    id={"expired-at-#{api_token.id}"}
                  >…</span>
                </td>
                <td>
                  <button
                    class="ng-danger-link"
                    phx-click="open_token_delete"
                    phx-value-id={api_token.id}
                    aria-label={"Delete API token #{api_token.id}"}
                  >
                    <i class="mdi mdi-trash-can-outline"></i> Delete
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <%# ── Multi-Factor Authentication ─────────────────────────────── %>
  <div class="ng-provider-section ng-provider-section--mt">
    <div class="ng-provider-section-header">
      <div class="ng-provider-section-title-wrap">
        <span class="ng-provider-section-icon ng-provider-section-icon--mfa">
          <i class="mdi mdi-shield-lock-outline"></i>
        </span>
        <span class="ng-provider-section-title">Multi-Factor Authentication</span>
        <span class="ng-section-badge"><%= mfa_count %></span>
      </div>
      <.link replace={true} patch={~p"/settings/account/register_mfa"} class="ng-primary-btn">
        <i class="mdi mdi-plus"></i> Add Method
      </.link>
    </div>

    <%= if length(@methods) > 0 do %>
      <%= render(FzHttpWeb.SharedView, "mfa_methods_table.html", methods: @methods) %>
    <% else %>
      <div class="ng-provider-empty">
        <i class="mdi mdi-shield-off-outline ng-empty-state-icon"></i>
        <p class="ng-empty-state-title">No MFA methods configured</p>
        <p class="ng-empty-state-hint">
          Add a TOTP authenticator (Google Authenticator, 1Password,
          Authy, …) to require a second factor at sign-in. Strongly
          recommended for admin accounts.
        </p>
        <.link replace={true} patch={~p"/settings/account/register_mfa"}
               class="ng-primary-btn ng-empty-state-cta">
          <i class="mdi mdi-plus"></i> Enroll MFA
        </.link>
      </div>
    <% end %>
  </div>

  <%# ── Product Updates ──────────────────────────────────────────── %>
  <div class="ng-update-banner">
    <i class="mdi mdi-bell-ring-outline"></i>
    <%= link("Subscribe here", to: @subscribe_link, target: "_blank", class: "ng-action-link") %>
    to receive product and security updates from NexGuard.
  </div>

  <%# ── Danger Zone ───────────────────────────────────────────────── %>
  <div class="ng-danger-zone">
    <div class="ng-danger-zone-header">
      <i class="mdi mdi-alert-outline"></i> Danger Zone
    </div>
    <div class="ng-danger-zone-body">
      <div class="ng-danger-zone-item">
        <div>
          <div class="ng-danger-zone-label">Delete Your Account</div>
          <p class="ng-danger-zone-desc">
            Permanently delete your account and all associated data. This action cannot be undone.
            <%= unless @allow_delete do %>
              <strong>You are the only admin — add another admin first.</strong>
            <% end %>
          </p>
        </div>
        <button
          class="ng-danger-btn"
          phx-click="open_account_delete_confirm"
          disabled={!@allow_delete}
        >
          <i class="mdi mdi-trash-can-outline"></i> Delete Account
        </button>
      </div>
    </div>
  </div>

</section>
