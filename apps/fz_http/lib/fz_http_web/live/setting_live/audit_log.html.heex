<%# ── Page Header ────────────────────────────────────────────────── %>
<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div>
      <h1 class="ng-page-title">Audit Log</h1>
      <p class="ng-page-subtitle">Immutable record of all security-relevant events.</p>
    </div>
    <div class="ng-audit-header-meta">
      <span class="ng-audit-retention-badge">
        <i class="mdi mdi-clock-outline"></i>
        <%= @retention_days %>-day retention
      </span>
      <span class="ng-audit-count-badge">
        <i class="mdi mdi-format-list-bulleted"></i>
        <%= @grand_total %> events
      </span>
    </div>
  </div>
</div>

<section class="section is-main-section">
  <%= render(FzHttpWeb.SharedView, "flash.html", assigns) %>

  <%# ── Toolbar: filters + result count ────────────────────────── %>
  <div class="ng-audit-toolbar">
    <.form
      :let={_f}
      for={%{}}
      phx-change="filter"
      class="ng-audit-filters"
    >
      <select name="category" class="ng-audit-filter-select">
        <%= for {label, value} <- @categories do %>
          <option value={value} selected={value == @category}><%= label %></option>
        <% end %>
      </select>

      <select name="result" class="ng-audit-filter-select">
        <%= for {label, value} <- @results do %>
          <option value={value} selected={value == @result_filter}><%= label %></option>
        <% end %>
      </select>
    </.form>

    <span class="ng-audit-filter-count">
      <%= if @category != "" or @result_filter != "" do %>
        Showing <strong><%= @total %></strong> of <%= @grand_total %> events
      <% else %>
        <%= @grand_total %> events total
      <% end %>
    </span>
  </div>

  <%# ── Table ───────────────────────────────────────────────────── %>
  <div class="ng-table-wrap">
    <table class="ng-table ng-audit-table">
      <thead>
        <tr>
          <th>Time</th>
          <th>Actor</th>
          <th>Action</th>
          <th class="ng-audit-th-result">Result</th>
          <th>Target</th>
          <th>IP</th>
        </tr>
      </thead>
      <tbody>
        <%= if Enum.empty?(@logs) do %>
          <tr>
            <td colspan="6" class="ng-audit-empty">
              <i class="mdi mdi-clipboard-text-clock-outline"></i>
              No events match the current filters.
            </td>
          </tr>
        <% else %>
          <%= for log <- @logs do %>
            <tr>
              <%# Time %>
              <td class="ng-td-muted ng-audit-ts">
                <span
                  id={"ts-#{log.id}"}
                  phx-hook="FormatTimestamp"
                  data-timestamp={DateTime.to_iso8601(log.inserted_at)}
                >…</span>
              </td>

              <%# Actor %>
              <td class="ng-audit-actor">
                <%= format_actor(log.actor_id, log.actor_email) %>
              </td>

              <%# Action %>
              <td>
                <span class={"ng-action-badge ng-action-badge--#{action_category(log.action)}"}>
                  <%= log.action %>
                </span>
              </td>

              <%# Result — icon only %>
              <td class="ng-audit-result-cell">
                <span
                  class={"ng-result-icon ng-result-icon--#{log.result}"}
                  title={log.result}
                >
                  <%= if log.result == "success" do %>
                    <i class="mdi mdi-check-circle"></i>
                  <% else %>
                    <i class="mdi mdi-alert-circle"></i>
                  <% end %>
                </span>
              </td>

              <%# Target — type muted, label bold %>
              <td class="ng-audit-target">
                <% parts = target_parts(log.target_type, log.target_id, log.target_label) %>
                <%= if parts do %>
                  <span class="ng-audit-target-type"><%= elem(parts, 0) %></span>
                  <%= if elem(parts, 1) do %>
                    <span class="ng-audit-target-label"><%= elem(parts, 1) %></span>
                  <% end %>
                <% else %>
                  <span class="ng-td-muted">—</span>
                <% end %>
              </td>

              <%# IP %>
              <td class="ng-td-mono ng-td-muted">
                <%= log.ip_address || "—" %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# ── Pagination ───────────────────────────────────────────────── %>
  <%= if @total_pages > 1 do %>
    <div class="ng-pagination">
      <button
        class="ng-pagination-btn"
        phx-click="prev_page"
        disabled={@page <= 1}
      >
        <i class="mdi mdi-chevron-left"></i>
        Prev
      </button>
      <span class="ng-pagination-info">
        Page <%= @page %> of <%= @total_pages %>
      </span>
      <button
        class="ng-pagination-btn"
        phx-click="next_page"
        disabled={@page >= @total_pages}
      >
        Next
        <i class="mdi mdi-chevron-right"></i>
      </button>
    </div>
  <% end %>

  <%# ── Retention Policy Panel ───────────────────────────────────── %>
  <div class="ng-audit-retention-panel">
    <div class="ng-audit-retention-panel-inner">
      <div class="ng-audit-retention-panel-text">
        <p class="ng-audit-retention-panel-title">
          <i class="mdi mdi-clock-remove-outline"></i>
          Retention Policy
        </p>
        <p class="ng-audit-retention-panel-desc">
          Entries older than the configured number of days are deleted automatically each day.
        </p>
      </div>
      <form phx-submit="update_retention" class="ng-audit-retention-panel-form">
        <label class="ng-audit-retention-panel-label">
          Keep logs for
          <input
            type="number"
            name="retention[days]"
            value={@retention_days}
            min="1"
            max="3650"
            class="ng-audit-retention-panel-input"
          />
          days
        </label>
        <button type="submit" class="ng-primary-btn ng-primary-btn--sm">
          <i class="mdi mdi-check"></i>
          Save
        </button>
      </form>
    </div>
  </div>

</section>
