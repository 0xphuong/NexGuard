<div>
<.form :let={f} for={@changeset} id={@id} phx-target={@myself}
       phx-change="validate" phx-submit="save">
  <div class="ng-settings-card">

    <%# Allowed IPs %>
    <% cfg_allowed_ips = Map.fetch!(@configs, :default_client_allowed_ips) %>
    <div class="ng-setting-row">
      <div class="ng-setting-info">
        <div class="ng-setting-label-wrap">
          <span class="ng-setting-label">Allowed IPs</span>
          <%= if config_has_override?(cfg_allowed_ips) do %>
            <span class="ng-override-badge">
              <i class="mdi mdi-lock-outline"></i>
              <%= config_override_source(cfg_allowed_ips) %>
            </span>
          <% end %>
        </div>
        <p class="ng-setting-desc">
          Destination IPs routed through NexGuard. Use
          <code>0.0.0.0/0, ::/0</code> for full-tunnel or CIDR ranges for split-tunnel.
        </p>
      </div>
      <div class="ng-setting-control">
        <%= textarea(f, :default_client_allowed_ips,
          placeholder: "0.0.0.0/0, ::/0",
          class: "ng-setting-textarea #{input_error_class(f, :default_client_allowed_ips)}",
          disabled: config_has_override?(cfg_allowed_ips),
          value:
            if config_has_override?(cfg_allowed_ips) do
              Enum.join(config_value(cfg_allowed_ips), ", ")
            else
              list_value(f, :default_client_allowed_ips)
            end
        ) %>
        <p class="ng-setting-error"><%= error_tag(f, :default_client_allowed_ips) %></p>
      </div>
    </div>

    <%# DNS Servers %>
    <% cfg_dns = Map.fetch!(@configs, :default_client_dns) %>
    <div class="ng-setting-row">
      <div class="ng-setting-info">
        <div class="ng-setting-label-wrap">
          <span class="ng-setting-label">DNS Servers</span>
          <%= if config_has_override?(cfg_dns) do %>
            <span class="ng-override-badge">
              <i class="mdi mdi-lock-outline"></i>
              <%= config_override_source(cfg_dns) %>
            </span>
          <% end %>
        </div>
        <p class="ng-setting-desc">
          Comma-separated list of DNS servers for devices. Leave blank to omit
          the <code>DNS</code> field from generated configs.
        </p>
      </div>
      <div class="ng-setting-control">
        <%= text_input(f, :default_client_dns,
          placeholder: "1.1.1.1, 1.0.0.1",
          class: "ng-setting-input #{input_error_class(f, :default_client_dns)}",
          disabled: config_has_override?(cfg_dns),
          value:
            if config_has_override?(cfg_dns) do
              Enum.join(config_value(cfg_dns), ", ")
            else
              list_value(f, :default_client_dns)
            end
        ) %>
        <p class="ng-setting-error"><%= error_tag(f, :default_client_dns) %></p>
      </div>
    </div>

    <%# Endpoint %>
    <% cfg_endpoint = Map.fetch!(@configs, :default_client_endpoint) %>
    <div class="ng-setting-row">
      <div class="ng-setting-info">
        <div class="ng-setting-label-wrap">
          <span class="ng-setting-label">Endpoint</span>
          <%= if config_has_override?(cfg_endpoint) do %>
            <span class="ng-override-badge">
              <i class="mdi mdi-lock-outline"></i>
              <%= config_override_source(cfg_endpoint) %>
            </span>
          <% end %>
        </div>
        <p class="ng-setting-desc">
          IPv4, IPv6 address, or FQDN that devices connect to.
          Defaults to this server's FQDN.
        </p>
      </div>
      <div class="ng-setting-control">
        <%= text_input(f, :default_client_endpoint,
          placeholder: "vpn.example.com",
          class: "ng-setting-input #{input_error_class(f, :default_client_endpoint)}",
          disabled: config_has_override?(cfg_endpoint),
          value:
            if config_has_override?(cfg_endpoint) do
              config_value(cfg_endpoint)
            else
              input_value(f, :default_client_endpoint)
            end
        ) %>
        <p class="ng-setting-error"><%= error_tag(f, :default_client_endpoint) %></p>
      </div>
    </div>

    <%# Persistent Keepalive %>
    <% cfg_keepalive = Map.fetch!(@configs, :default_client_persistent_keepalive) %>
    <div class="ng-setting-row">
      <div class="ng-setting-info">
        <div class="ng-setting-label-wrap">
          <span class="ng-setting-label">Persistent Keepalive</span>
          <%= if config_has_override?(cfg_keepalive) do %>
            <span class="ng-override-badge">
              <i class="mdi mdi-lock-outline"></i>
              <%= config_override_source(cfg_keepalive) %>
            </span>
          <% end %>
        </div>
        <p class="ng-setting-desc">
          Interval in seconds to send keepalive packets from devices.
          Leave blank to omit from generated configs.
        </p>
      </div>
      <div class="ng-setting-control">
        <%= text_input(f, :default_client_persistent_keepalive,
          placeholder: "25",
          class: "ng-setting-input #{input_error_class(f, :default_client_persistent_keepalive)}",
          disabled: config_has_override?(cfg_keepalive),
          value:
            if config_has_override?(cfg_keepalive) do
              config_value(cfg_keepalive)
            else
              input_value(f, :default_client_persistent_keepalive)
            end
        ) %>
        <p class="ng-setting-error"><%= error_tag(f, :default_client_persistent_keepalive) %></p>
      </div>
    </div>

    <%# MTU %>
    <% cfg_mtu = Map.fetch!(@configs, :default_client_mtu) %>
    <div class="ng-setting-row">
      <div class="ng-setting-info">
        <div class="ng-setting-label-wrap">
          <span class="ng-setting-label">MTU</span>
          <%= if config_has_override?(cfg_mtu) do %>
            <span class="ng-override-badge">
              <i class="mdi mdi-lock-outline"></i>
              <%= config_override_source(cfg_mtu) %>
            </span>
          <% end %>
        </div>
        <p class="ng-setting-desc">
          WireGuard interface MTU for devices. <code>1280</code> is safe for most
          networks. Leave blank to omit from generated configs.
        </p>
      </div>
      <div class="ng-setting-control">
        <%= text_input(f, :default_client_mtu,
          placeholder: "1280",
          class: "ng-setting-input #{input_error_class(f, :default_client_mtu)}",
          disabled: config_has_override?(cfg_mtu),
          value:
            if config_has_override?(cfg_mtu) do
              config_value(cfg_mtu)
            else
              input_value(f, :default_client_mtu)
            end
        ) %>
        <p class="ng-setting-error"><%= error_tag(f, :default_client_mtu) %></p>
      </div>
    </div>

  </div>

  <div class="ng-settings-footer">
    <%= submit "Save Changes",
      class: "ng-primary-btn",
      phx_disable_with: "Saving…",
      disabled: map_size(@changeset.changes) == 0 %>
  </div>
</.form>
</div>
