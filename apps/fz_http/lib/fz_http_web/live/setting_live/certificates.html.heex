<%# ── Upload / Replace modal ───────────────────────────────────── %>
<%# The modal helper renders its own footer with a submit button     %>
<%# bound to `form=<form id>` via the `form:` opt. We pass the form  %>
<%# id our inner component uses ("certificate-form") and let the     %>
<%# modal render the submit — the inner template must NOT include    %>
<%# its own submit button, or both would render and only the first   %>
<%# would receive clicks.                                            %>
<%= if @live_action in [:new, :replace] do %>
  <%= live_modal(
    FzHttpWeb.SettingLive.CertificateFormComponent,
    return_to: ~p"/settings/certificates",
    title:
      if @live_action == :new do
        "Upload new certificate"
      else
        "Replace certificate"
      end,
    id: "certificate-form-component",
    certificate: @replace_target,
    action: @live_action,
    subject: @subject,
    remote_ip: @remote_ip,
    form: "certificate-form",
    button_text:
      if @live_action == :replace do
        "Replace certificate"
      else
        "Upload certificate"
      end
  ) %>
<% end %>

<%# ── Delete Confirmation Modal ─────────────────────────────────── %>
<%= if @delete_confirm do %>
  <div class="modal is-active" phx-window-keydown="cancel_delete" phx-key="escape">
    <div class="modal-background" phx-click="cancel_delete"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">
          <i class="mdi mdi-alert-octagon ng-modal-title-icon"></i>
          Delete Certificate
        </p>
        <button class="ng-modal-close" aria-label="Close" phx-click="cancel_delete">
          <i class="mdi mdi-close"></i>
        </button>
      </header>
      <section class="modal-card-body">
        <p class="ng-modal-intro">You are about to permanently delete:</p>
        <div class="ng-modal-entity"><%= @delete_confirm.cert.label %></div>

        <%= if @delete_confirm.affected.pinned != [] do %>
          <div class="ng-modal-callout ng-modal-callout--warning">
            <i class="mdi mdi-alert-outline"></i>
            <span>
              <strong>Delete blocked.</strong>
              This certificate is explicitly pinned by
              <%= length(@delete_confirm.affected.pinned) %> app(s).
              Reassign or unpin these apps first:
            </span>
          </div>
          <ul class="ng-modal-list">
            <%= for app <- @delete_confirm.affected.pinned do %>
              <li><code><%= app.hostname %></code></li>
            <% end %>
          </ul>
        <% else %>
          <%= if @delete_confirm.affected.auto_matched != [] do %>
            <p class="ng-modal-cons">
              The following <%= length(@delete_confirm.affected.auto_matched) %>
              app(s) currently auto-match to this cert. They'll attempt to
              re-resolve against the remaining library on the next bundle
              compile — if no other cert covers them, TLS will fail:
            </p>
            <ul class="ng-modal-list">
              <%= for app <- @delete_confirm.affected.auto_matched do %>
                <li><code><%= app.hostname %></code></li>
              <% end %>
            </ul>
          <% end %>
          <p class="ng-modal-warn">This action cannot be undone.</p>
        <% end %>
      </section>
      <footer class="modal-card-foot">
        <button class="ng-secondary-btn" phx-click="cancel_delete">Cancel</button>
        <%= if @delete_confirm.affected.pinned == [] do %>
          <button class="ng-danger-btn ng-danger-btn--filled" phx-click="delete">
            <i class="mdi mdi-delete"></i> Delete Certificate
          </button>
        <% end %>
      </footer>
    </div>
  </div>
<% end %>

<%# ── Page header ───────────────────────────────────────────────── %>
<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div>
      <h1 class="ng-page-title"><%= @page_title %></h1>
      <p class="ng-page-subtitle"><%= @page_subtitle %></p>
    </div>
    <.link replace={true} patch={~p"/settings/certificates/new"} class="ng-primary-btn">
      <i class="mdi mdi-upload"></i> Upload certificate
    </.link>
  </div>
</div>

<section class="section is-main-section">
  <%= render(FzHttpWeb.SharedView, "flash.html", assigns) %>

  <%= if @all_certificates == [] do %>
    <div class="ng-empty-state">
      <i class="mdi mdi-certificate-outline ng-empty-state-icon"></i>
      <p class="ng-empty-state-title">No certificates uploaded yet</p>
      <p class="ng-empty-state-hint">
        L7 applications terminate TLS using a cert from this library —
        without at least one cert here, no app can serve HTTPS on its
        hostname. Upload a wildcard or multi-SAN cert once and every
        matching app picks it up automatically; renewals replace in place
        with no per-app touches.
      </p>
      <.link replace={true} patch={~p"/settings/certificates/new"}
             class="ng-primary-btn ng-empty-state-cta">
        <i class="mdi mdi-upload"></i> Upload first certificate
      </.link>
    </div>
  <% else %>
    <%# ── Stats strip — org-wide pulse, derived from `@all_certificates`
    %# (unfiltered) so the strip stays accurate when the filter narrows
    %# the table. Danger / warn tiles only tint when their count is > 0
    %# so the strip stays quiet for a healthy library. %>
    <div class="ng-stat-strip">
      <div class="ng-stat-tile">
        <div class="ng-stat-tile-value"><%= @stats.total %></div>
        <div class="ng-stat-tile-label">Total certs</div>
      </div>
      <div class={["ng-stat-tile",
                    (@stats.critical + @stats.expired) > 0 && "ng-stat-tile--danger"]}>
        <div class="ng-stat-tile-value"><%= @stats.critical + @stats.expired %></div>
        <div class="ng-stat-tile-label">
          <i class="mdi mdi-alert-octagon"></i> Critical / expired
        </div>
      </div>
      <div class={["ng-stat-tile", @stats.warning > 0 && "ng-stat-tile--warn"]}>
        <div class="ng-stat-tile-value"><%= @stats.warning %></div>
        <div class="ng-stat-tile-label">
          <i class="mdi mdi-clock-alert-outline"></i> Expiring soon
        </div>
      </div>
      <div class="ng-stat-tile">
        <div class="ng-stat-tile-value"><%= @stats.apps %></div>
        <div class="ng-stat-tile-label">
          <i class="mdi mdi-application-cog-outline"></i> Apps covered
        </div>
      </div>
    </div>

    <%# ── Filter bar — search + expiry chip ──────────────────── %>
    <.form
      :let={_f}
      for={%{}}
      as={:filters}
      phx-change="filter"
      class="ng-user-filterbar"
    >
      <div class="ng-user-filterbar-search">
        <i class="mdi mdi-magnify"></i>
        <input
          type="text"
          name="filters[search]"
          value={@filters["search"]}
          placeholder="Search by label or SAN…"
          class="ng-user-filterbar-input"
          phx-debounce="200"
          autocomplete="off"
        />
      </div>

      <select name="filters[expiry]" class="ng-user-filterbar-select">
        <%= for {label, value} <- @expiry_options do %>
          <option value={value} selected={value == @filters["expiry"]}><%= label %></option>
        <% end %>
      </select>

      <%= if FzHttpWeb.SettingLive.Certificates.filters_active?(@filters) do %>
        <button type="button" phx-click="reset_filters" class="ng-user-filterbar-reset">
          <i class="mdi mdi-close"></i> Reset
        </button>
      <% end %>

      <span class="ng-user-filterbar-count">
        <%= length(@certificates) %> of <%= length(@all_certificates) %>
      </span>
    </.form>

    <%# ── Library table ─────────────────────────────────────── %>
    <%= if @certificates == [] do %>
      <div class="ng-empty-state ng-empty-state--inline">
        <p class="ng-empty-state-hint">
          No certificates match the current filters.
          <button type="button" phx-click="reset_filters" class="ng-inline-link">Reset filters</button>
        </p>
      </div>
    <% else %>
    <div class="ng-table-wrap">
      <table class="ng-table">
        <thead>
          <tr>
            <th>Label</th>
            <th>Coverage</th>
            <th>Issuer</th>
            <th>Expires</th>
            <th class="ng-th-center">Used by</th>
            <th class="ng-th-center ng-th-actions"></th>
          </tr>
        </thead>
        <tbody>
          <%= for cert <- @certificates do %>
            <%
              {status, status_label} =
                FzHttpWeb.SettingLive.Certificates.expiry_status(cert.not_after)
              total_apps = cert.pinned_count + cert.auto_matched_count
            %>
            <tr id={"certificate-#{cert.id}"}>
              <td>
                <div class="ng-user-cell">
                  <div class="ng-avatar ng-avatar--group">
                    <i class="mdi mdi-certificate-outline"></i>
                  </div>
                  <div class="ng-user-info">
                    <span class="ng-user-email"><%= cert.label %></span>
                    <span class="ng-td-muted ng-td-meta">
                      <code><%= cert.primary_san %></code>
                    </span>
                  </div>
                </div>
              </td>
              <td class="ng-td-muted">
                <div class="ng-cert-sans">
                  <%= for san <- cert.sans do %>
                    <code class="ng-cert-san"><%= san %></code>
                  <% end %>
                </div>
              </td>
              <td class="ng-td-muted">
                <%= cert.issuer || "—" %>
              </td>
              <td>
                <span class={"ng-cert-status-badge ng-cert-status-badge--#{FzHttpWeb.SettingLive.Certificates.status_badge_class(status)}"}>
                  <i class={"mdi #{FzHttpWeb.SettingLive.Certificates.status_icon(status)}"}></i>
                  <%= FzHttpWeb.SettingLive.Certificates.format_datetime(cert.not_after) %>
                  · <%= status_label %>
                </span>
              </td>
              <td class="ng-td-center">
                <%= if total_apps == 0 do %>
                  <span class="ng-td-muted">—</span>
                <% else %>
                  <details class="ng-usage-disclosure">
                    <summary>
                      <i class="mdi mdi-application-cog-outline"></i>
                      <%= total_apps %> app<%= if total_apps != 1, do: "s" %>
                    </summary>
                    <div class="ng-usage-list">
                      <%= if cert.pinned_hostnames != [] do %>
                        <div class="ng-usage-group">
                          <span class="ng-usage-group-label">Pinned</span>
                          <%= for host <- cert.pinned_hostnames do %>
                            <code><%= host %></code>
                          <% end %>
                        </div>
                      <% end %>
                      <%= if cert.auto_matched_hostnames != [] do %>
                        <div class="ng-usage-group">
                          <span class="ng-usage-group-label">Auto-matched</span>
                          <%= for host <- cert.auto_matched_hostnames do %>
                            <code><%= host %></code>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  </details>
                <% end %>
              </td>
              <td class="ng-td-center">
                <.link
                  replace={true}
                  patch={~p"/settings/certificates/#{cert.id}/replace"}
                  class="ng-dismiss-btn"
                  aria-label={"Replace certificate #{cert.label}"}
                >
                  <i class="mdi mdi-swap-horizontal"></i>
                </.link>
                <button
                  class="ng-dismiss-btn"
                  aria-label={"Delete certificate #{cert.label}"}
                  phx-click="confirm_delete"
                  phx-value-id={cert.id}
                >
                  <i class="mdi mdi-trash-can-outline"></i>
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% end %>
  <% end %>
</section>
