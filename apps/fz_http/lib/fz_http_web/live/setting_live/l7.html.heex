<%# ── Enable/Disable confirm modal ─────────────────────────────── %>
<%= if @confirm do %>
  <div class="modal is-active" phx-window-keydown="cancel" phx-key="escape">
    <div class="modal-background" phx-click="cancel"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">
          <%= case @confirm do %>
            <% :enable -> %>
              <i class="mdi mdi-power-plug ng-modal-title-icon ng-modal-title-icon--ok"></i>
              Enable L7 Enforcement
            <% :disable -> %>
              <i class="mdi mdi-power-plug-off ng-modal-title-icon"></i>
              Disable L7 Enforcement
          <% end %>
        </p>
        <button class="ng-modal-close" aria-label="Close" phx-click="cancel">
          <i class="mdi mdi-close"></i>
        </button>
      </header>
      <section class="modal-card-body">
        <%= case @confirm do %>
          <% :enable -> %>
            <p class="ng-modal-intro">You are about to turn L7 enforcement <strong>ON</strong>:</p>
            <ul class="ng-modal-list">
              <li>The nftables TPROXY chain will route VIP-bound traffic (<code>10.99.0.0/16</code>) into the L7 proxy</li>
              <li>CoreDNS will start resolving declared hostnames to their virtual IPs</li>
              <li>Every per-app rule + Allowed Group will be enforced on the next bundle reload</li>
              <li>Apps with no L7 rules will deny everything by default (implicit fall-through)</li>
            </ul>
            <p class="ng-modal-warn">
              Read <a href="https://github.com/0xphuong/nexguard-connect/blob/main/SPEC.md#8-gateway-l7-architecture" target="_blank" rel="noopener">SPEC §8</a>
              + the locked ADRs before flipping in production.
            </p>
          <% :disable -> %>
            <p class="ng-modal-intro">You are about to turn L7 enforcement <strong>OFF</strong>:</p>
            <ul class="ng-modal-list">
              <li>nftables TPROXY chain is removed — VIP traffic stops being intercepted</li>
              <li>CoreDNS stops resolving declared hostnames; clients fall back to upstream DNS</li>
              <li>Every L7 rule is bypassed — apps revert to L3/L4 enforcement only</li>
              <li>App configuration (rules, groups, certs) is preserved and re-arms when you flip back on</li>
            </ul>
            <p class="ng-modal-warn">
              Use this as a kill switch during incidents. Per-app declarations
              are <em>not</em> lost.
            </p>
        <% end %>
      </section>
      <footer class="modal-card-foot">
        <button class="ng-secondary-btn" phx-click="cancel">Cancel</button>
        <%= case @confirm do %>
          <% :enable -> %>
            <button class="ng-primary-btn" phx-click="apply">
              <i class="mdi mdi-power-plug"></i> Enable L7
            </button>
          <% :disable -> %>
            <button class="ng-danger-btn ng-danger-btn--filled" phx-click="apply">
              <i class="mdi mdi-power-plug-off"></i> Disable L7
            </button>
        <% end %>
      </footer>
    </div>
  </div>
<% end %>

<%# ── DNS save confirm modal ──────────────────────────────────── %>
<%# CoreDNS reloads `/etc/nexguard/Corefile.generated` within ~1s, %>
<%# which interrupts in-flight DNS resolution for every VPN client. %>
<%# Capture the new values + surface them before applying. %>
<%= if @pending_dns do %>
  <div class="modal is-active" phx-window-keydown="cancel_save_dns" phx-key="escape">
    <div class="modal-background" phx-click="cancel_save_dns"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">
          <i class="mdi mdi-dns-outline ng-modal-title-icon ng-modal-title-icon--warn"></i>
          Update DNS Upstreams
        </p>
        <button class="ng-modal-close" aria-label="Close" phx-click="cancel_save_dns">
          <i class="mdi mdi-close"></i>
        </button>
      </header>
      <section class="modal-card-body">
        <p class="ng-modal-intro">CoreDNS will switch to the following upstreams:</p>
        <ul class="ng-modal-list">
          <li>
            <strong>Primary:</strong>
            <%= if @pending_dns.primary == [] do %>
              <span class="ng-td-muted">(empty)</span>
            <% else %>
              <%= for ip <- @pending_dns.primary do %>
                <code><%= ip %></code>
              <% end %>
            <% end %>
          </li>
          <li>
            <strong>Fallback:</strong>
            <%= if @pending_dns.fallback == [] do %>
              <span class="ng-td-muted">none</span>
            <% else %>
              <%= for ip <- @pending_dns.fallback do %>
                <code><%= ip %></code>
              <% end %>
            <% end %>
          </li>
        </ul>
        <p class="ng-modal-warn">
          CoreDNS reloads within ~1s — in-flight DNS resolution may
          briefly interrupt for connected VPN clients. Save during a
          maintenance window if possible.
        </p>
      </section>
      <footer class="modal-card-foot">
        <button class="ng-secondary-btn" phx-click="cancel_save_dns">Cancel</button>
        <button class="ng-primary-btn" phx-click="apply_dns">
          <i class="mdi mdi-content-save-outline"></i> Save upstreams
        </button>
      </footer>
    </div>
  </div>
<% end %>

<%# ── Hero ──────────────────────────────────────────────────────── %>
<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div>
      <h1 class="ng-page-title">L7 Enforcement</h1>
      <p class="ng-page-subtitle">
        Master switch for the layer-7 ZTNA proxy. Per-app declarations
        live under <.link navigate={~p"/applications"}>Applications</.link>.
      </p>
    </div>
    <span class={["ng-source-badge",
                  if(@settings.l7_enabled, do: "ng-source-badge--idp_sync", else: "ng-source-badge--manual")]}>
      <i class={["mdi",
                 if(@settings.l7_enabled, do: "mdi-check-circle-outline", else: "mdi-pause-circle-outline")]}></i>
      <%= if @settings.l7_enabled, do: "Enabled", else: "Disabled" %>
    </span>
  </div>
</div>

<section class="section is-main-section">
  <%= render(FzHttpWeb.SharedView, "flash.html", assigns) %>

  <%# ── Stats strip — L7 control-plane pulse ───────────────────
  %# Reuses `@settings` + `@enabled_apps_count` available from mount;
  %# no new context queries. Status tile picks up green/amber from
  %# enforcement state at a glance. %>
  <div class="ng-stat-strip">
    <div class={["ng-stat-tile",
                  @settings.l7_enabled && "ng-stat-tile--ok",
                  not @settings.l7_enabled && "ng-stat-tile--muted"]}>
      <div class="ng-stat-tile-value ng-stat-tile-value--sm">
        <%= if @settings.l7_enabled, do: "Active", else: "Off" %>
      </div>
      <div class="ng-stat-tile-label">
        <i class={["mdi",
                   if(@settings.l7_enabled, do: "mdi-check-circle-outline", else: "mdi-pause-circle-outline")]}></i>
        Enforcement
      </div>
    </div>
    <div class={["ng-stat-tile",
                  @settings.l7_enabled && @enabled_apps_count == 0 && "ng-stat-tile--warn"]}>
      <div class="ng-stat-tile-value"><%= @enabled_apps_count %></div>
      <div class="ng-stat-tile-label">
        <i class="mdi mdi-application-cog-outline"></i> Enabled apps
      </div>
    </div>
    <div class="ng-stat-tile">
      <div class="ng-stat-tile-value"><%= FzHttpWeb.SettingLive.L7.dns_count(@settings) %></div>
      <div class="ng-stat-tile-label">
        <i class="mdi mdi-dns-outline"></i> DNS forwarders
      </div>
    </div>
    <div class="ng-stat-tile">
      <div class="ng-stat-tile-value ng-stat-tile-value--sm">
        <%= FzHttpWeb.SettingLive.L7.updated_at_str(@settings.updated_at) %>
      </div>
      <div class="ng-stat-tile-label">
        <i class="mdi mdi-clock-outline"></i> Last config update
      </div>
    </div>
  </div>

  <%# ── L7-active info callout — only when enabled ─────────────
  %# Previously rendered as `.ng-cert-preview` with hardcoded green
  %# hex overrides. Now uses the proper `.ng-modal-callout--success`
  %# token defined for the certs IP-update flow. %>
  <%= if @settings.l7_enabled do %>
    <div class="ng-modal-callout ng-modal-callout--success">
      <i class="mdi mdi-check-circle-outline"></i>
      <span>
        <strong>L7 stack active.</strong>
        Routing VIP traffic via <code>10.99.0.0/16</code> through the
        proxy on <code>:8443</code>.
        <%= if @enabled_apps_count == 0 do %>
          No apps published yet — the proxy is idle until you
          <.link navigate={~p"/applications"} class="ng-inline-link">declare one</.link>.
        <% end %>
      </span>
    </div>
  <% end %>

  <%# ── Master toggle ────────────────────────────────────────────── %>
  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header">
        <i class="mdi mdi-power"></i> Master toggle
      </span>
    </div>
    <div class="ng-detail-card-body">
      <div class="ng-danger-zone-item">
        <div>
          <div class="ng-danger-zone-label">
            <%= if @settings.l7_enabled do %>
              Disable L7 enforcement
            <% else %>
              Enable L7 enforcement
            <% end %>
          </div>
          <p class="ng-danger-zone-desc">
            <%= if @settings.l7_enabled do %>
              Flips off the entire L7 subsystem in one click. Per-app
              declarations are preserved; flip back on any time to
              re-arm them. Use as an incident-response kill switch.
            <% else %>
              Activates the nftables TPROXY chain + CoreDNS overrides +
              L7 proxy for every <code>enabled</code> app. The bundle
              recompiles immediately on flip; clients see the new state
              on their next request.
            <% end %>
          </p>
        </div>
        <%= if @settings.l7_enabled do %>
          <button class="ng-danger-btn" phx-click="request_disable">
            <i class="mdi mdi-power-plug-off"></i> Disable L7
          </button>
        <% else %>
          <button class="ng-primary-btn" phx-click="request_enable">
            <i class="mdi mdi-power-plug"></i> Enable L7
          </button>
        <% end %>
      </div>
    </div>
  </div>

  <%# ── DNS forward upstreams ───────────────────────────────────── %>
  <%# CoreDNS forwards everything not in the L7 hosts file to these
  %# upstreams. Phoenix writes /etc/nexguard/Corefile.generated from
  %# this DB row on save; CoreDNS's `reload 1s` plugin picks the new
  %# file up — no container restart. %>
  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header">
        <i class="mdi mdi-dns-outline"></i> DNS forward upstreams
      </span>
      <span class="ng-section-meta">
        last edited <%= FzHttpWeb.SettingLive.L7.updated_at_str(@settings.updated_at) %>
      </span>
    </div>
    <div class="ng-detail-card-body">
      <form phx-submit="request_save_dns" autocomplete="off">
        <div class="ng-field">
          <label class="ng-label" for="dns_primary">Primary upstream(s)</label>
          <input
            type="text"
            id="dns_primary"
            name="dns[primary]"
            class="ng-input ng-input--mono"
            value={FzHttpWeb.SettingLive.L7.to_csv_str(@settings.coredns_forward_to)}
            placeholder="10.0.235.250, 10.0.235.252"
            autocomplete="off"
            required
          />
          <p class="ng-field-hint">
            Comma-separated IPs or hostnames. CoreDNS uses
            <code>policy sequential</code> — sticks to the first healthy
            upstream, fails over only on health-check failure.
          </p>
        </div>

        <div class="ng-field">
          <label class="ng-label" for="dns_fallback">
            Fallback upstream(s)
            <span class="ng-label-meta">(optional)</span>
          </label>
          <input
            type="text"
            id="dns_fallback"
            name="dns[fallback]"
            class="ng-input ng-input--mono"
            value={FzHttpWeb.SettingLive.L7.to_csv_str(@settings.coredns_forward_to_fallback)}
            placeholder="10.0.250.250"
            autocomplete="off"
          />
          <p class="ng-field-hint">
            Tried only after the entire primary list fails health checks.
            Leave empty if you have no secondary DNS.
          </p>
        </div>

        <div class="ng-form-footer">
          <p class="ng-form-hint">
            <i class="mdi mdi-information-outline"></i>
            CoreDNS picks up the new Corefile within ~1s. No container restart.
          </p>
          <button type="submit" class="ng-primary-btn">
            <i class="mdi mdi-content-save-outline"></i> Save DNS upstreams
          </button>
        </div>
      </form>
    </div>
  </div>

  <%# ── How it works (always-visible hint) ────────────────────── %>
  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header">
        <i class="mdi mdi-information-outline"></i> How the kill switch behaves
      </span>
    </div>
    <div class="ng-detail-card-body">
      <p class="ng-form-hint ng-form-hint--lead">
        L7 enforcement is opt-in at <strong>two</strong> levels (ADR-014):
      </p>
      <ol class="ng-modal-list">
        <li>
          <strong>Org-wide</strong> — this page. When OFF, the L7 proxy
          + CoreDNS + TPROXY chain are dormant regardless of any app
          config. Public-internet traffic stays on L3/L4 enforcement
          via Rules.
        </li>
        <li>
          <strong>Per-app</strong> — the <code>enabled</code> toggle
          on each application's Show page. An app must be both
          <em>enabled</em> here and have <strong>≥ 1 L7 rule</strong>
          to be reachable through the proxy.
        </li>
      </ol>
      <p class="ng-form-hint">
        Both switches are audited (<code>org_settings.l7_enabled.change</code>
        + <code>application.enabled.change</code>) and broadcast on PubSub
        so the proxy hot-reloads its policy bundle without a restart.
      </p>
    </div>
  </div>
</section>
