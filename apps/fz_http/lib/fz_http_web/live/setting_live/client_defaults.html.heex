<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div>
      <h1 class="ng-page-title">Client Defaults</h1>
      <p class="ng-page-subtitle">Default values for generating WireGuard client configurations</p>
    </div>
  </div>
</div>

<section class="section is-main-section">
  <%= render(FzHttpWeb.SharedView, "flash.html", assigns) %>

  <%# Upfront disclosure — NexGuard Connect re-fetches the device
  %# config via /api/v1/devices/me/config on every sign-in, so any
  %# change here propagates automatically the next time each client
  %# connects. Sets admin expectation: not immediate, but no manual
  %# regeneration step either. %>
  <div class="ng-modal-callout">
    <i class="mdi mdi-information-outline"></i>
    <span>
      <strong>NexGuard Connect</strong> refreshes the device config on
      every sign-in. Existing clients pick up these defaults the next
      time they connect — no manual regeneration needed.
    </span>
  </div>

  <%= live_component(
    FzHttpWeb.SettingLive.ClientDefaultsFormComponent,
    subject: @subject,
    remote_ip: @remote_ip,
    changeset: @changeset,
    id: :client_defaults_form_component
  ) %>
</section>
