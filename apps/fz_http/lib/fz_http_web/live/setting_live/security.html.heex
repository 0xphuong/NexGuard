<% openid_connect_providers = Map.fetch!(@configs, :openid_connect_providers) %>
<% saml_identity_providers = Map.fetch!(@configs, :saml_identity_providers) %>

<%= if @live_action == :edit_oidc do %>
  <%= live_modal(
    FzHttpWeb.SettingLive.OIDCFormComponent,
    subject: @subject,
    return_to: ~p"/settings/security",
    title: "OIDC Configuration",
    provider: get_provider(config_value(openid_connect_providers), @id) || %{id: @id},
    id: "oidc-form-component",
    form: "oidc-form"
  ) %>
<% end %>

<%= if @live_action == :edit_saml do %>
  <%= live_modal(
    FzHttpWeb.SettingLive.SAMLFormComponent,
    subject: @subject,
    return_to: ~p"/settings/security",
    title: "SAML Configuration",
    provider: get_provider(config_value(saml_identity_providers), @id) || %{id: @id},
    id: "saml-form-component",
    form: "saml-form"
  ) %>
<% end %>

<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div>
      <h1 class="ng-page-title">Security</h1>
      <p class="ng-page-subtitle">Authentication methods and Single Sign-On configuration</p>
    </div>
  </div>
</div>

<section class="section is-main-section">
  <%= render(FzHttpWeb.SharedView, "flash.html", assigns) %>

  <%# ── Authentication ─────────────────────────────────────── %>
  <div class="ng-section-header">Authentication</div>

  <div class="ng-settings-card">

    <%# VPN Session Duration %>
    <% vpn_session_duration = Map.fetch!(@configs, :vpn_session_duration) %>
    <div class="ng-setting-row">
      <div class="ng-setting-info">
        <div class="ng-setting-label-wrap">
          <span class="ng-setting-label">Require Auth for VPN Sessions</span>
          <%= if config_has_override?(vpn_session_duration) do %>
            <span class="ng-override-badge">
              <i class="mdi mdi-lock-outline"></i>
              <%= config_override_source(vpn_session_duration) %>
            </span>
          <% end %>
        </div>
        <p class="ng-setting-desc">
          <%= if config_has_override?(vpn_session_duration) do %>
            This field is overridden and cannot be changed here.
          <% else %>
            Require users to periodically re-authenticate to keep VPN sessions active.
          <% end %>
        </p>
      </div>
      <div class="ng-setting-control">
        <.form
          :let={f}
          for={@configuration_changeset}
          phx-change="change"
          phx-submit="save_configuration"
          class="ng-inline-form"
        >
          <%= select(f, :vpn_session_duration,
            session_duration_options(vpn_session_duration),
            class: "ng-setting-input",
            disabled: config_has_override?(vpn_session_duration),
            selected: config_value(vpn_session_duration)
          ) %>
          <%= submit "Save",
            disabled: !(@form_changed and !config_has_override?(vpn_session_duration)),
            phx_disable_with: "Saving…",
            class: "ng-save-inline-btn" %>
        </.form>
      </div>
    </div>

    <%# Force MFA toggle %>
    <% require_mfa = Map.fetch!(@configs, :require_mfa) %>
    <div class="ng-setting-row">
      <div class="ng-setting-info">
        <div class="ng-setting-label-wrap">
          <span class="ng-setting-label">Force MFA for All Users</span>
          <%= if config_has_override?(require_mfa) do %>
            <span class="ng-override-badge">
              <i class="mdi mdi-lock-outline"></i>
              <%= config_override_source(require_mfa) %>
            </span>
          <% end %>
        </div>
        <p class="ng-setting-desc">
          Require every user to enroll in MFA before accessing the VPN or REST API.
          Users without an MFA method will be redirected to the enrollment page on their next sign-in.
        </p>
      </div>
      <div class="ng-setting-control ng-setting-control--toggle">
        <label class="switch is-medium">
          <input
            type="checkbox"
            phx-click="toggle"
            name="require_mfa"
            phx-value-config="require_mfa"
            disabled={config_has_override?(require_mfa)}
            checked={config_value(require_mfa)}
            value={config_toggle_status(require_mfa)}
          />
          <span class="check"></span>
        </label>
      </div>
    </div>

    <%# Local Auth toggle %>
    <% local_auth_enabled = Map.fetch!(@configs, :local_auth_enabled) %>
    <div class="ng-setting-row">
      <div class="ng-setting-info">
        <div class="ng-setting-label-wrap">
          <span class="ng-setting-label">Local Authentication</span>
          <%= if config_has_override?(local_auth_enabled) do %>
            <span class="ng-override-badge">
              <i class="mdi mdi-lock-outline"></i>
              <%= config_override_source(local_auth_enabled) %>
            </span>
          <% end %>
        </div>
        <p class="ng-setting-desc">
          Enable or disable sign-in with email and password.
        </p>
      </div>
      <div class="ng-setting-control ng-setting-control--toggle">
        <label class="switch is-medium">
          <input
            type="checkbox"
            phx-click="toggle"
            name="local_auth_enabled"
            phx-value-config="local_auth_enabled"
            disabled={config_has_override?(local_auth_enabled)}
            checked={config_value(local_auth_enabled)}
            value={config_toggle_status(local_auth_enabled)}
          />
          <span class="check"></span>
        </label>
      </div>
    </div>

    <%# Unprivileged device management %>
    <% allow_unprivileged_device_management =
      Map.fetch!(@configs, :allow_unprivileged_device_management) %>
    <div class="ng-setting-row">
      <div class="ng-setting-info">
        <div class="ng-setting-label-wrap">
          <span class="ng-setting-label">Unprivileged Device Management</span>
          <%= if config_has_override?(allow_unprivileged_device_management) do %>
            <span class="ng-override-badge">
              <i class="mdi mdi-lock-outline"></i>
              <%= config_override_source(allow_unprivileged_device_management) %>
            </span>
          <% end %>
        </div>
        <p class="ng-setting-desc">
          Allow unprivileged users to add and remove their own devices.
        </p>
      </div>
      <div class="ng-setting-control ng-setting-control--toggle">
        <label class="switch is-medium">
          <input
            type="checkbox"
            phx-click="toggle"
            name="allow_unprivileged_device_management"
            phx-value-config="allow_unprivileged_device_management"
            disabled={config_has_override?(allow_unprivileged_device_management)}
            checked={config_value(allow_unprivileged_device_management)}
            value={config_toggle_status(allow_unprivileged_device_management)}
          />
          <span class="check"></span>
        </label>
      </div>
    </div>

    <%# Unprivileged device configuration %>
    <% allow_unprivileged_device_configuration =
      Map.fetch!(@configs, :allow_unprivileged_device_configuration) %>
    <div class="ng-setting-row">
      <div class="ng-setting-info">
        <div class="ng-setting-label-wrap">
          <span class="ng-setting-label">Unprivileged Device Configuration</span>
          <%= if config_has_override?(allow_unprivileged_device_configuration) do %>
            <span class="ng-override-badge">
              <i class="mdi mdi-lock-outline"></i>
              <%= config_override_source(allow_unprivileged_device_configuration) %>
            </span>
          <% end %>
        </div>
        <p class="ng-setting-desc">
          Allow unprivileged users to modify their own device network settings.
        </p>
      </div>
      <div class="ng-setting-control ng-setting-control--toggle">
        <label class="switch is-medium">
          <input
            type="checkbox"
            phx-click="toggle"
            name="allow_unprivileged_device_configuration"
            phx-value-config="allow_unprivileged_device_configuration"
            disabled={config_has_override?(allow_unprivileged_device_configuration)}
            checked={config_value(allow_unprivileged_device_configuration)}
            value={config_toggle_status(allow_unprivileged_device_configuration)}
          />
          <span class="check"></span>
        </label>
      </div>
    </div>

  </div>

  <%# ── Single Sign-On ─────────────────────────────────────── %>
  <div class="ng-section-header ng-section-header--spaced">Single Sign-On</div>

  <div class="ng-settings-card" style="margin-bottom: 1.5rem;">
    <% disable_vpn_on_oidc_error = Map.fetch!(@configs, :disable_vpn_on_oidc_error) %>
    <div class="ng-setting-row">
      <div class="ng-setting-info">
        <div class="ng-setting-label-wrap">
          <span class="ng-setting-label">Auto-disable VPN on OIDC Error</span>
          <%= if config_has_override?(disable_vpn_on_oidc_error) do %>
            <span class="ng-override-badge">
              <i class="mdi mdi-lock-outline"></i>
              <%= config_override_source(disable_vpn_on_oidc_error) %>
            </span>
          <% end %>
        </div>
        <p class="ng-setting-desc">
          Automatically disable a user's VPN connection when their OIDC token refresh fails.
        </p>
      </div>
      <div class="ng-setting-control ng-setting-control--toggle">
        <label class="switch is-medium">
          <input
            type="checkbox"
            phx-click="toggle"
            name="disable_vpn_on_oidc_error"
            phx-value-config="disable_vpn_on_oidc_error"
            disabled={config_has_override?(disable_vpn_on_oidc_error)}
            checked={config_value(disable_vpn_on_oidc_error)}
            value={config_toggle_status(disable_vpn_on_oidc_error)}
          />
          <span class="check"></span>
        </label>
      </div>
    </div>
  </div>

  <%# OIDC Providers %>
  <div class="ng-provider-section">
    <div class="ng-provider-section-header">
      <div class="ng-provider-section-title-wrap">
        <span class="ng-provider-section-icon ng-provider-section-icon--oidc">
          <i class="mdi mdi-shield-account-outline"></i>
        </span>
        <span class="ng-provider-section-title">OpenID Connect Providers</span>
        <%= if config_has_override?(openid_connect_providers) do %>
          <span class="ng-override-badge">
            <i class="mdi mdi-lock-outline"></i>
            <%= config_override_source(openid_connect_providers) %>
          </span>
        <% end %>
      </div>
      <%= unless config_has_override?(openid_connect_providers) do %>
        <%= live_patch to: ~p"/settings/security/oidc/#{rand_string(8)}/edit",
          class: "ng-primary-btn" do %>
          <i class="mdi mdi-plus"></i> Add Provider
        <% end %>
      <% end %>
    </div>

    <%= if Enum.empty?(config_value(openid_connect_providers)) do %>
      <div class="ng-provider-empty">
        <i class="mdi mdi-shield-off-outline"></i>
        No OIDC providers configured
      </div>
    <% else %>
      <div class="ng-table-wrap">
        <table class="ng-table">
          <thead>
            <tr>
              <th>Config ID</th>
              <th>Label</th>
              <th>Client ID</th>
              <th>Discovery URI</th>
              <th>Scope</th>
              <%= unless config_has_override?(openid_connect_providers) do %>
                <th></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <%= for provider <- config_value(openid_connect_providers) do %>
              <tr>
                <td class="ng-td-mono ng-td-muted"><%= provider.id %></td>
                <td style="font-weight: 500;"><%= provider.label %></td>
                <td class="ng-td-mono ng-td-muted"><%= provider.client_id %></td>
                <td class="ng-td-muted"><%= provider.discovery_document_uri %></td>
                <td class="ng-td-muted"><%= provider.scope %></td>
                <%= unless config_has_override?(openid_connect_providers) do %>
                  <td>
                    <div class="ng-row-actions">
                      <%= live_patch to: ~p"/settings/security/oidc/#{provider.id}/edit",
                        class: "ng-action-link" do %>
                        <i class="mdi mdi-pencil-outline"></i> Edit
                      <% end %>
                      <button
                        class="ng-danger-link"
                        phx-click="delete"
                        phx-value-key={provider.id}
                        phx-value-type="openid_connect_providers"
                        data-confirm={"Delete OIDC provider \"#{provider.label}\"?"}
                      >
                        <i class="mdi mdi-trash-can-outline"></i> Delete
                      </button>
                    </div>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <%# SAML Providers %>
  <div class="ng-provider-section">
    <div class="ng-provider-section-header">
      <div class="ng-provider-section-title-wrap">
        <span class="ng-provider-section-icon ng-provider-section-icon--saml">
          <i class="mdi mdi-card-account-details-outline"></i>
        </span>
        <span class="ng-provider-section-title">SAML Identity Providers</span>
        <%= if config_has_override?(saml_identity_providers) do %>
          <span class="ng-override-badge">
            <i class="mdi mdi-lock-outline"></i>
            <%= config_override_source(saml_identity_providers) %>
          </span>
        <% end %>
      </div>
      <%= unless config_has_override?(saml_identity_providers) do %>
        <%= live_patch to: ~p"/settings/security/saml/#{rand_string(8)}/edit",
          class: "ng-primary-btn" do %>
          <i class="mdi mdi-plus"></i> Add Provider
        <% end %>
      <% end %>
    </div>

    <%= if Enum.empty?(config_value(saml_identity_providers)) do %>
      <div class="ng-provider-empty">
        <i class="mdi mdi-shield-off-outline"></i>
        No SAML providers configured
      </div>
    <% else %>
      <div class="ng-table-wrap">
        <table class="ng-table">
          <thead>
            <tr>
              <th>Config ID</th>
              <th>Label</th>
              <th>Metadata</th>
              <%= unless config_has_override?(saml_identity_providers) do %>
                <th></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <%= for provider <- config_value(saml_identity_providers) do %>
              <tr>
                <td class="ng-td-mono ng-td-muted"><%= provider.id %></td>
                <td style="font-weight: 500;"><%= provider.label %></td>
                <td class="ng-td-muted">
                  <div class="ng-metadata-preview"><%= provider.metadata %></div>
                </td>
                <%= unless config_has_override?(saml_identity_providers) do %>
                  <td>
                    <div class="ng-row-actions">
                      <%= live_patch to: ~p"/settings/security/saml/#{provider.id}/edit",
                        class: "ng-action-link" do %>
                        <i class="mdi mdi-pencil-outline"></i> Edit
                      <% end %>
                      <button
                        class="ng-danger-link"
                        phx-click="delete"
                        phx-value-key={provider.id}
                        phx-value-type="saml_identity_providers"
                        data-confirm={"Delete SAML provider \"#{provider.label}\"?"}
                      >
                        <i class="mdi mdi-trash-can-outline"></i> Delete
                      </button>
                    </div>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

</section>
