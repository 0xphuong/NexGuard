<div
  id="new-device-data"
  data-public-key={@device && @device.public_key}
  data-device-name={@device && @device.name}
  data-config={@config}
  phx-hook="RenderConfig"
>
  <%= if @device && @config do %>
    <%# ── Config result state ──────────────────────────────────────── %>
    <div class="ng-device-config">

      <div class="ng-device-config-success">
        <i class="mdi mdi-check-circle ng-device-config-success__icon"></i>
        <div>
          <strong>Device added!</strong>
          <p>Scan the QR code or download the config file into your WireGuard client.</p>
        </div>
      </div>

      <div class="ng-device-config-warning">
        <i class="mdi mdi-alert-outline"></i>
        <span>This configuration will <strong>not</strong> be shown again — save it now before closing.</span>
      </div>

      <div id="generating-config" class="ng-device-config-generating">
        <i class="mdi mdi-loading mdi-spin"></i>
        <span>Rendering configuration…</span>
      </div>

      <div class="ng-device-config-actions">
        <canvas id="qr-canvas" class="ng-device-config-qr"></canvas>
        <div class="ng-device-config-buttons">
          <a class="ng-primary-btn is-hidden" id="download-config">
            <i class="mdi mdi-download"></i> Download .conf
          </a>
          <button class="ng-secondary-btn is-hidden" id="copy-config-btn" type="button">
            <i class="mdi mdi-content-copy"></i> Copy
          </button>
        </div>
      </div>

      <div class="ng-device-config-code">
        <pre id="wg-conf-container" class="is-hidden"><code id="wg-conf" class="language-toml"></code></pre>
      </div>

      <div class="ng-device-config-footer">
        <p>
          Need help? See
          <a target="_blank" href="https://docs.nexguard.binhphuong.io.vn/user-guides/client-instructions/">
            the NexGuard setup guide
          </a>.
        </p>
        <.link patch={@return_to} class="ng-primary-btn">Done</.link>
      </div>

    </div>
  <% else %>
    <%# ── Add Device form state ─────────────────────────────────────── %>
    <div>
      <.form
        :let={f}
        for={@changeset}
        id="create-device"
        phx-change="change"
        phx-target={@myself}
        phx-submit="save"
      >
        <%= hidden_input(f, :public_key, id: "device-public-key", phx_hook: "GenerateKeyPair") %>
        <%= hidden_input(f, :preshared_key) %>

        <%= if @changeset.action do %>
          <div class="ng-flash ng-flash--error" style="margin-bottom: 1rem;">
            <i class="mdi mdi-alert-circle-outline ng-flash-icon"></i>
            <span class="ng-flash-message"><%= error_tag(f, :base) %></span>
          </div>
        <% end %>

        <div class="ng-field">
          <%= label(f, :name, class: "ng-label") %>
          <%= text_input(f, :name, class: "ng-input #{input_error_class(f, :name)}") %>
          <p class="ng-field-error"><%= error_tag(f, :name) %></p>
        </div>

        <div class="ng-field">
          <%= label(f, :description, class: "ng-label") %>
          <%= textarea(f, :description,
            placeholder: "Optional description",
            class: "pre-wrapped ng-textarea #{input_error_class(f, :description)}"
          ) %>
          <p class="ng-field-error"><%= error_tag(f, :description) %></p>
        </div>

        <%= if FzHttp.Devices.authorize_device_configuration(@subject) == :ok do %>
          <button
            type="button"
            class="ng-advanced-toggle"
            phx-click="toggle_advanced"
            phx-target={@myself}
          >
            <i class={"mdi #{if @show_advanced, do: "mdi-chevron-down", else: "mdi-chevron-right"}"}></i>
            Advanced settings
          </button>

          <%= if @show_advanced do %>
            <div class="ng-advanced-fields">

              <%# Allowed IPs %>
              <div class="ng-field ng-field--toggle">
                <div class="ng-field-toggle-header">
                  <span class="ng-label">Allowed IPs</span>
                  <label class="ng-toggle">
                    <%= checkbox(f, :use_default_allowed_ips) %>
                    <span class="ng-toggle-track"><span class="ng-toggle-thumb"></span></span>
                  </label>
                  <span class="ng-field-toggle-label">Use default</span>
                </div>
                <p class="ng-field-hint">Default: <%= Enum.join(@default_client_allowed_ips, ", ") %></p>
                <%= unless @use_default_allowed_ips do %>
                  <%= textarea(f, :allowed_ips,
                    class: "ng-textarea #{input_error_class(f, :allowed_ips)}",
                    value: list_value(f, :allowed_ips)
                  ) %>
                  <p class="ng-field-error"><%= error_tag(f, :allowed_ips) %></p>
                <% end %>
              </div>

              <%# DNS %>
              <div class="ng-field ng-field--toggle">
                <div class="ng-field-toggle-header">
                  <span class="ng-label">DNS Servers</span>
                  <label class="ng-toggle">
                    <%= checkbox(f, :use_default_dns) %>
                    <span class="ng-toggle-track"><span class="ng-toggle-thumb"></span></span>
                  </label>
                  <span class="ng-field-toggle-label">Use default</span>
                </div>
                <p class="ng-field-hint">Default: <%= Enum.join(@default_client_dns, ", ") %></p>
                <%= unless @use_default_dns do %>
                  <%= text_input(f, :dns,
                    class: "ng-input #{input_error_class(f, :dns)}",
                    value: list_value(f, :dns)
                  ) %>
                  <p class="ng-field-error"><%= error_tag(f, :dns) %></p>
                <% end %>
              </div>

              <%# Endpoint %>
              <div class="ng-field ng-field--toggle">
                <div class="ng-field-toggle-header">
                  <span class="ng-label">Server Endpoint</span>
                  <label class="ng-toggle">
                    <%= checkbox(f, :use_default_endpoint) %>
                    <span class="ng-toggle-track"><span class="ng-toggle-thumb"></span></span>
                  </label>
                  <span class="ng-field-toggle-label">Use default</span>
                </div>
                <p class="ng-field-hint">Default: <%= @default_client_endpoint %></p>
                <%= unless @use_default_endpoint do %>
                  <%= text_input(f, :endpoint,
                    class: "ng-input #{input_error_class(f, :endpoint)}"
                  ) %>
                  <p class="ng-field-error"><%= error_tag(f, :endpoint) %></p>
                <% end %>
              </div>

              <%# MTU %>
              <div class="ng-field ng-field--toggle">
                <div class="ng-field-toggle-header">
                  <span class="ng-label">Interface MTU</span>
                  <label class="ng-toggle">
                    <%= checkbox(f, :use_default_mtu) %>
                    <span class="ng-toggle-track"><span class="ng-toggle-thumb"></span></span>
                  </label>
                  <span class="ng-field-toggle-label">Use default</span>
                </div>
                <p class="ng-field-hint">Default: <%= @default_client_mtu %></p>
                <%= unless @use_default_mtu do %>
                  <%= text_input(f, :mtu,
                    class: "ng-input #{input_error_class(f, :mtu)}"
                  ) %>
                  <p class="ng-field-error"><%= error_tag(f, :mtu) %></p>
                <% end %>
              </div>

              <%# Persistent Keepalive %>
              <div class="ng-field ng-field--toggle">
                <div class="ng-field-toggle-header">
                  <span class="ng-label">Persistent Keepalive</span>
                  <label class="ng-toggle">
                    <%= checkbox(f, :use_default_persistent_keepalive) %>
                    <span class="ng-toggle-track"><span class="ng-toggle-thumb"></span></span>
                  </label>
                  <span class="ng-field-toggle-label">Use default</span>
                </div>
                <p class="ng-field-hint">Default: <%= @default_client_persistent_keepalive %>s (0 = disabled)</p>
                <%= unless @use_default_persistent_keepalive do %>
                  <%= text_input(f, :persistent_keepalive,
                    class: "ng-input #{input_error_class(f, :persistent_keepalive)}"
                  ) %>
                  <p class="ng-field-error"><%= error_tag(f, :persistent_keepalive) %></p>
                <% end %>
              </div>

              <%# Tunnel IPs %>
              <div class="ng-field">
                <%= label(f, :ipv4, "Tunnel IPv4 Address", class: "ng-label") %>
                <%= text_input(f, :ipv4,
                  placeholder: "Auto-assigned if blank",
                  class: "ng-input #{input_error_class(f, :ipv4)}"
                ) %>
                <p class="ng-field-error"><%= error_tag(f, :ipv4) %></p>
              </div>

              <div class="ng-field">
                <%= label(f, :ipv6, "Tunnel IPv6 Address", class: "ng-label") %>
                <%= text_input(f, :ipv6,
                  placeholder: "Auto-assigned if blank",
                  class: "ng-input #{input_error_class(f, :ipv6)}"
                ) %>
                <p class="ng-field-error"><%= error_tag(f, :ipv6) %></p>
              </div>

            </div>
          <% end %>
        <% end %>

        <%= if @changeset.action do %>
          <div class="ng-flash ng-flash--error" style="margin-top: 1rem;">
            <i class="mdi mdi-alert-circle-outline ng-flash-icon"></i>
            <span class="ng-flash-message">Error creating device. Check the fields above.</span>
          </div>
        <% end %>
      </.form>
    </div>
  <% end %>
</div>
