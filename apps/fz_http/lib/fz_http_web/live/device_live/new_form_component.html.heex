<div
  id="new-device-data"
  data-public-key={@device && @device.public_key}
  data-device-name={@device && @device.name}
  data-config={@config}
  phx-hook="RenderConfig"
>
  <%= if @device && @config do %>
    <div class="content">
      <p>
        <strong>Device added!</strong>
      </p>

      <p>
        To use this configuration, you'll need a WireGuard client installed
        for your device. See
        <a target="_blank" href="https://docs.nexguard.binhphuong.io.vn/user-guides/client-instructions/">
          the NexGuard documentation
        </a>
        for a step-by-step guide.
      </p>

      <p>
        <strong>NOTE:</strong>
        This configuration <strong>WILL NOT</strong>
        be viewable again. Please ensure you've downloaded the
        configuration file or copied it somewhere safe
        before closing this window.
      </p>

      <div id="generating-config">
        <p>Rendering configuration...</p>
        <i class="fa fa-spinner fa-spin"></i>
      </div>

      <p>
        <a class="ng-primary-btn is-hidden" id="download-config">
          Download WireGuard Configuration
        </a>
      </p>
      <p>
        <canvas id="qr-canvas">
          Generating QR code...
        </canvas>
      </p>
      <p>
        <pre id="wg-conf-container" class="is-hidden"><code id="wg-conf" class="language-toml"></code></pre>
      </p>
    </div>
  <% else %>
    <div>
      <.form
        :let={f}
        for={@changeset}
        id="create-device"
        phx-change="change"
        phx-target={@myself}
        phx-submit="save"
      >
        <%= hidden_input(f, :public_key, id: "device-public-key", phx_hook: "GenerateKeyPair") %>
        <%= hidden_input(f, :preshared_key) %>

        <%= if @changeset.action do %>
          <div class="ng-flash ng-flash--error" style="margin-bottom: 1rem;">
            <i class="mdi mdi-alert-circle-outline ng-flash-icon"></i>
            <span class="ng-flash-message"><%= error_tag(f, :base) %></span>
          </div>
        <% end %>

        <div class="ng-field">
          <%= label(f, :name, class: "ng-label") %>
          <%= text_input(f, :name, class: "ng-input #{input_error_class(f, :name)}") %>
          <p class="ng-field-error">
            <%= error_tag(f, :name) %>
          </p>
        </div>

        <div class="ng-field">
          <%= label(f, :description, class: "ng-label") %>
          <%= textarea(
            f,
            :description,
            placeholder: "Enter an optional description for this device",
            class: "pre-wrapped ng-textarea #{input_error_class(f, :description)}"
          ) %>
          <p class="ng-field-error">
            <%= error_tag(f, :description) %>
          </p>
        </div>

        <%= if FzHttp.Devices.authorize_device_configuration(@subject) == :ok do %>
          <div class="ng-field">
            <%= label(f, :use_default_allowed_ips, "Use Default Allowed IPs", class: "ng-label") %>
            <div>
              <label class="ng-radio">
                <%= radio_button(f, :use_default_allowed_ips, true) %> Yes
              </label>
              <label class="ng-radio">
                <%= radio_button(f, :use_default_allowed_ips, false) %> No
              </label>
            </div>
            <p class="ng-field-hint">
              Default: <%= Enum.join(@default_client_allowed_ips, ", ") %>
            </p>
          </div>

          <div class="ng-field">
            <%= label(f, :allowed_ips, "Allowed IPs", class: "ng-label") %>
            <%= textarea(f, :allowed_ips,
              class: "ng-textarea #{input_error_class(f, :allowed_ips)}",
              disabled: @use_default_allowed_ips,
              value: list_value(f, :allowed_ips)
            ) %>
            <p class="ng-field-error">
              <%= error_tag(f, :allowed_ips) %>
            </p>
          </div>

          <div class="ng-field">
            <%= label(f, :use_default_dns, "Use Default DNS Servers", class: "ng-label") %>
            <div>
              <label class="ng-radio">
                <%= radio_button(f, :use_default_dns, true) %> Yes
              </label>
              <label class="ng-radio">
                <%= radio_button(f, :use_default_dns, false) %> No
              </label>
            </div>
            <p class="ng-field-hint">
              Default: <%= Enum.join(@default_client_dns, ", ") %>
            </p>
          </div>

          <div class="ng-field">
            <%= label(f, :dns, "DNS Servers", class: "ng-label") %>
            <%= text_input(f, :dns,
              class: "ng-input #{input_error_class(f, :dns)}",
              disabled: @use_default_dns,
              value: list_value(f, :dns)
            ) %>
            <p class="ng-field-error">
              <%= error_tag(f, :dns) %>
            </p>
          </div>

          <div class="ng-field">
            <%= label(f, :use_default_endpoint, "Use Default Endpoint", class: "ng-label") %>
            <div>
              <label class="ng-radio">
                <%= radio_button(f, :use_default_endpoint, true) %> Yes
              </label>
              <label class="ng-radio">
                <%= radio_button(f, :use_default_endpoint, false) %> No
              </label>
            </div>
            <p class="ng-field-hint">
              Default: <%= @default_client_endpoint %>
            </p>
          </div>

          <div class="ng-field">
            <%= label(f, :endpoint, "Server Endpoint", class: "ng-label") %>
            <p>The IP of the server this device should connect to.</p>
            <%= text_input(f, :endpoint,
              class: "ng-input #{input_error_class(f, :endpoint)}",
              disabled: @use_default_endpoint
            ) %>
            <p class="ng-field-error">
              <%= error_tag(f, :endpoint) %>
            </p>
          </div>

          <div class="ng-field">
            <%= label(f, :use_default_mtu, "Use Default MTU", class: "ng-label") %>
            <div>
              <label class="ng-radio">
                <%= radio_button(f, :use_default_mtu, true) %> Yes
              </label>
              <label class="ng-radio">
                <%= radio_button(f, :use_default_mtu, false) %> No
              </label>
            </div>
            <p class="ng-field-hint">
              Default: <%= @default_client_mtu %>
            </p>
          </div>

          <div class="ng-field">
            <%= label(f, :mtu, "Interface MTU", class: "ng-label") %>
            <p>The WireGuard interface MTU for this Device.</p>
            <%= text_input(f, :mtu,
              class: "ng-input #{input_error_class(f, :mtu)}",
              disabled: @use_default_mtu
            ) %>
            <p class="ng-field-error">
              <%= error_tag(f, :mtu) %>
            </p>
          </div>

          <div class="ng-field">
            <%= label(f, :use_default_persistent_keepalive, "Use Default Persistent Keepalive",
              class: "ng-label"
            ) %>
            <div>
              <label class="ng-radio">
                <%= radio_button(f, :use_default_persistent_keepalive, true) %> Yes
              </label>
              <label class="ng-radio">
                <%= radio_button(f, :use_default_persistent_keepalive, false) %> No
              </label>
            </div>
            <p class="ng-field-hint">
              Default: <%= @default_client_persistent_keepalive %>
            </p>
          </div>

          <div class="ng-field">
            <%= label(f, :persistent_keepalive, "Persistent Keepalive", class: "ng-label") %>
            <p>
              Interval for WireGuard <a href="https://www.wireguard.com/quickstart/#nat-and-firewall-traversal-persistence">
                persistent keepalive</a>. A value of 0 disables this. Leave this disabled
              unless you're experiencing NAT or firewall traversal problems.
            </p>
            <%= text_input(f, :persistent_keepalive,
              class: "ng-input #{input_error_class(f, :persistent_keepalive)}",
              disabled: @use_default_persistent_keepalive
            ) %>
            <p class="ng-field-error">
              <%= error_tag(f, :persistent_keepalive) %>
            </p>
          </div>

          <div class="ng-field">
            <%= label(f, :ipv4, "Tunnel IPv4 Address", class: "ng-label") %>
            <%= text_input(
              f,
              :ipv4,
              placeholder: "Leave blank to let NexGuard assign an IPv4 address",
              class: "ng-input #{input_error_class(f, :ipv4)}"
            ) %>
            <p class="ng-field-error">
              <%= error_tag(f, :ipv4) %>
            </p>
          </div>

          <div class="ng-field">
            <%= label(f, :ipv6, "Tunnel IPv6 Address", class: "ng-label") %>
            <%= text_input(
              f,
              :ipv6,
              placeholder: "Leave blank to let NexGuard assign an IPv6 address",
              class: "ng-input #{input_error_class(f, :ipv6)}"
            ) %>
            <p class="ng-field-error">
              <%= error_tag(f, :ipv6) %>
            </p>
          </div>
        <% end %>

        <%= if @changeset.action do %>
          <div class="ng-flash ng-flash--error" style="margin-bottom: 1rem;">
            <i class="mdi mdi-alert-circle-outline ng-flash-icon"></i>
            <span class="ng-flash-message">Error creating device. Scroll up to view fields with errors.</span>
          </div>
        <% end %>
      </.form>
    </div>
  <% end %>
</div>
