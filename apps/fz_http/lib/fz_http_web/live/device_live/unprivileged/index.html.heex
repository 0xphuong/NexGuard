<%= if @live_action == :new do %>
  <%= live_modal(
    FzHttpWeb.DeviceLive.NewFormComponent,
    return_to: ~p"/user_devices",
    title: "Add Device",
    wide: true,
    current_user: @current_user,
    user: @current_user,
    id: "create-device-component",
    form: "create-device",
    button_text: "Generate Configuration",
    subject: @subject,
    remote_ip: @remote_ip
  ) %>
<% end %>

<%# ── Page Header ──────────────────────────────────────────────────────────── %>
<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div>
      <h1 class="ng-page-title"><%= @page_title %></h1>
      <p class="ng-page-subtitle"><%= @page_subtitle %></p>
    </div>
    <%= if FzHttp.Devices.authorize_user_device_management(@current_user.id, @subject) == :ok do %>
      <.link replace={true} patch={~p"/user_devices/new"} class="ng-primary-btn">
        <i class="mdi mdi-plus"></i> Add Device
      </.link>
    <% end %>
  </div>
</div>

<section class="section is-main-section">
  <%= render(FzHttpWeb.SharedView, "flash.html", assigns) %>

  <%# ── Devices Table ───────────────────────────────────────────────────────── %>
  <%= if Enum.empty?(@devices) do %>
    <div class="ng-empty-state">
      <i class="mdi mdi-laptop ng-empty-state-icon"></i>
      <p class="ng-empty-state-title">No devices yet</p>
      <p class="ng-empty-state-hint">
        Add a device to enroll a NexGuard Connect client. You'll need
        <a href="https://docs.nexguard.binhphuong.io.vn/user-guides/client-instructions/" target="_blank" class="ng-inline-link">NexGuard Connect</a>
        installed on your machine (macOS / Windows / Linux) to reach this server.
      </p>
    </div>
  <% else %>
    <div class="ng-table-wrap" style="margin-bottom:1.5rem">
      <table class="ng-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Tunnel IPv4</th>
            <th>Tunnel IPv6</th>
            <th>Public Key</th>
            <th>Created</th>
          </tr>
        </thead>
        <tbody>
          <%= for device <- @devices do %>
            <tr>
              <td>
                <.link navigate={~p"/user_devices/#{device}"} class="ng-inline-link">
                  <i class="mdi mdi-laptop" style="margin-right:0.3rem;color:#94a3b8"></i><%= device.name %>
                </.link>
              </td>
              <td class="ng-td-mono"><%= device.ipv4 %></td>
              <td class="ng-td-mono"><%= device.ipv6 %></td>
              <td class="ng-td-mono" style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title={device.public_key}>
                <%= device.public_key %>
              </td>
              <td
                class="ng-td-muted"
                id={"device-#{device.id}-inserted-at"}
                data-timestamp={device.inserted_at}
                phx-hook="FormatTimestamp"
              >…</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <%# ── VPN Session ─────────────────────────────────────────────────────────── %>
  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header" style="margin:0">
        <i class="mdi mdi-shield-check"></i> VPN Session
      </span>
    </div>
    <dl class="ng-details-list">
      <div class="ng-details-row">
        <dt class="ng-details-label">Signed in as</dt>
        <dd class="ng-details-value"><%= @current_user.email %></dd>
      </div>
      <div class="ng-details-row">
        <dt class="ng-details-label">Session</dt>
        <dd class="ng-details-value">
          <%= if vpn_sessions_expire?() do %>
            <%= if vpn_expired?(@current_user) do %>
              <span class="ng-status-badge ng-status-badge--expired">
                <i class="mdi mdi-clock-alert"></i> Expired at
                <span id="vpn-expires" phx-hook="FormatTimestamp" data-timestamp={vpn_expires_at(@current_user)}>…</span>
              </span>
            <% else %>
              <span class="ng-status-badge ng-status-badge--enabled">
                <i class="mdi mdi-check-circle"></i> Active — expires
                <span id="vpn-expires" phx-hook="FormatTimestamp" data-timestamp={vpn_expires_at(@current_user)}>…</span>
              </span>
            <% end %>
          <% else %>
            <span class="ng-status-badge ng-status-badge--enabled">
              <i class="mdi mdi-check-circle"></i> Active indefinitely
            </span>
          <% end %>
        </dd>
      </div>
      <div class="ng-details-row">
        <dt class="ng-details-label">Actions</dt>
        <dd class="ng-details-value" style="display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center">
          <.link navigate={~p"/user_account"} class="ng-inline-link">
            <i class="mdi mdi-account-cog"></i> My Account
          </.link>
          <%= link to: ~p"/sign_out", method: :delete, class: "ng-inline-link" do %>
            <i class="mdi mdi-logout"></i> Sign out
          <% end %>
          <%= if vpn_sessions_expire?() && vpn_expired?(@current_user) do %>
            <%= link to: ~p"/sign_out", method: :delete, class: "ng-primary-btn ng-btn--sm" do %>
              <i class="mdi mdi-refresh"></i> Reauthenticate
            <% end %>
          <% end %>
        </dd>
      </div>
      <div class="ng-details-row">
        <dt class="ng-details-label">Support</dt>
        <dd class="ng-details-value">
          <a href={"mailto:#{admin_email()}"} class="ng-inline-link">
            <i class="mdi mdi-email-outline"></i> Contact administrator
          </a>
        </dd>
      </div>
    </dl>
  </div>
</section>
