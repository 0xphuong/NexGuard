<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div>
      <h1 class="ng-page-title">Devices</h1>
      <p class="ng-page-subtitle"><%= length(@devices) %> device<%= if length(@devices) != 1, do: "s" %> — managed via user profiles</p>
    </div>
    <.link navigate={~p"/users"} class="ng-secondary-btn">
      <i class="mdi mdi-account-group"></i> Go to Users
    </.link>
  </div>
</div>

<section class="section is-main-section">
  <%= render(FzHttpWeb.SharedView, "flash.html", assigns) %>

  <%= if @devices == [] do %>
    <div class="ng-empty-state">
      <i class="mdi mdi-laptop ng-empty-state-icon"></i>
      <p class="ng-empty-state-title">No devices yet</p>
      <p class="ng-empty-state-hint">
        Devices are added from within a user's profile.
        <.link navigate={~p"/users"} class="ng-inline-link">Go to Users</.link>
      </p>
    </div>
  <% else %>
    <div class="ng-table-wrap">
      <%= render(FzHttpWeb.SharedView, "devices_table.html",
        devices: @devices,
        show_user: true,
        socket: @socket
      ) %>
    </div>
  <% end %>
</section>
