<%# Compact page header — dashboard doesn't need the full hero
%# treatment; vertical space is for content. %>
<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div>
      <h1 class="ng-page-title"><%= @page_title %></h1>
      <p class="ng-page-subtitle">Health, identity, and L7 ZTNA at a glance.</p>
    </div>
  </div>
</div>

<section class="section is-main-section">
  <%= render(FzHttpWeb.SharedView, "flash.html", assigns) %>

  <%# ── Zone 1: Hero status ─────────────────────────────────────
  %# Single-glance "are we healthy?" banner. Severity derived from
  %# the highest alert in @alerts. Empty alerts list → green "all
  %# operational"; anything else lists the issues with deep links
  %# to the page that fixes each one.
  %#
  %# Design principle (frontend-design-direction): the first
  %# viewport must immediately answer the dashboard's job.
  %# %>
  <% hero = FzHttpWeb.DashboardLive.Index.hero_severity(@alerts) %>
  <div class={["ng-hero-status", FzHttpWeb.DashboardLive.Index.severity_class(hero)]}>
    <div class="ng-hero-status-main">
      <i class={["mdi", FzHttpWeb.DashboardLive.Index.severity_icon(hero), "ng-hero-status-icon"]}></i>
      <div class="ng-hero-status-text">
        <div class="ng-hero-status-headline">
          <%= case hero do %>
            <% :ok       -> %>All systems operational
            <% :info     -> %><%= length(@alerts) %> item<%= if length(@alerts) > 1, do: "s" %> need review
            <% :warn     -> %><%= length(@alerts) %> item<%= if length(@alerts) > 1, do: "s" %> need attention
            <% :critical -> %><%= length(@alerts) %> issue<%= if length(@alerts) > 1, do: "s" %> require immediate action
          <% end %>
        </div>
        <div class="ng-hero-status-sub">
          L7 <%= if @l7_enabled?, do: "ON", else: "OFF" %>
          · <%= @apps_count %> app<%= if @apps_count != 1, do: "s" %>
          · <%= @enabled_apps_count %> enabled
          · <%= FzHttpWeb.DashboardLive.Index.bundle_label(@bundle) %>
        </div>
      </div>
    </div>

    <%= if @alerts != [] do %>
      <ul class="ng-alert-list">
        <%= for alert <- @alerts do %>
          <li class={["ng-alert-row", FzHttpWeb.DashboardLive.Index.alert_severity_class(alert.severity)]}>
            <i class={["mdi", alert.icon]}></i>
            <span class="ng-alert-label"><%= alert.label %></span>
            <.link navigate={alert.href} class="ng-alert-action">Review →</.link>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <%# ── Zone 2: Domain-grouped stat strip ───────────────────────
  %# 4 tiles, each carrying 3 metrics (one headline + two sub).
  %# Grouped by domain rather than per-entity so an admin sees the
  %# whole product surface in one pass instead of 8 isolated cards.
  %# %>
  <div class="ng-domain-grid">

    <%# Identity %>
    <.link navigate={~p"/users"} class="ng-domain-tile">
      <div class="ng-domain-tile-head">
        <i class="mdi mdi-account-group-outline"></i>
        <span>Identity</span>
      </div>
      <div class="ng-domain-tile-headline"><%= @user_count %></div>
      <div class="ng-domain-tile-headline-label">total users</div>
      <ul class="ng-domain-tile-sub">
        <li>
          <span class={["ng-domain-tile-dot", if(@mfa_pct >= 80, do: "ok", else: "warn")]}></span>
          <%= @mfa_pct %>% MFA enrolled
        </li>
        <li>
          <span class="ng-domain-tile-dot info"></span>
          <%= @admin_count %> admin<%= if @admin_count != 1, do: "s" %>
        </li>
      </ul>
    </.link>

    <%# Network / Devices %>
    <.link navigate={~p"/devices"} class="ng-domain-tile">
      <div class="ng-domain-tile-head">
        <i class="mdi mdi-laptop"></i>
        <span>Network</span>
      </div>
      <div class="ng-domain-tile-headline"><%= @device_count %></div>
      <div class="ng-domain-tile-headline-label">total devices</div>
      <ul class="ng-domain-tile-sub">
        <li>
          <span class="ng-domain-tile-dot ok"></span>
          <%= @active_24h %> active 24h
        </li>
        <li>
          <span class={["ng-domain-tile-dot", if(@pending_device_count > 0, do: "warn", else: "info")]}></span>
          <%= @pending_device_count %> pending approval
        </li>
      </ul>
    </.link>

    <%# L7 ZTNA %>
    <.link navigate={~p"/applications"} class="ng-domain-tile">
      <div class="ng-domain-tile-head">
        <i class="mdi mdi-shield-key-outline"></i>
        <span>L7 ZTNA</span>
      </div>
      <div class="ng-domain-tile-headline"><%= @enabled_apps_count %><span class="ng-domain-tile-headline-divider">/<%= @apps_count %></span></div>
      <div class="ng-domain-tile-headline-label">apps enabled</div>
      <ul class="ng-domain-tile-sub">
        <li>
          <span class={["ng-domain-tile-dot", if(@l7_enabled?, do: "ok", else: "warn")]}></span>
          enforcement <%= if @l7_enabled?, do: "ON", else: "OFF" %>
        </li>
        <li>
          <span class={["ng-domain-tile-dot",
                if(@cert_critical_count > 0, do: "critical",
                   else: (if @cert_warn_count > 0, do: "warn", else: "ok"))]}></span>
          <%= @cert_count %> cert<%= if @cert_count != 1, do: "s" %>
          <%= cond do
                @cert_critical_count > 0 -> "(#{@cert_critical_count} <7d)"
                @cert_warn_count > 0     -> "(#{@cert_warn_count} <30d)"
                true                      -> ""
              end %>
        </li>
      </ul>
    </.link>

    <%# Activity %>
    <.link navigate={~p"/settings/audit_log"} class="ng-domain-tile">
      <div class="ng-domain-tile-head">
        <i class="mdi mdi-pulse"></i>
        <span>Activity</span>
      </div>
      <div class="ng-domain-tile-headline"><%= @active_3min %></div>
      <div class="ng-domain-tile-headline-label">VPN connected now</div>
      <ul class="ng-domain-tile-sub">
        <li>
          <span class="ng-domain-tile-dot info"></span>
          <%= @today_audit_count %> audit event<%= if @today_audit_count != 1, do: "s" %> today
        </li>
        <li>
          <span class="ng-domain-tile-dot info"></span>
          <%= @group_count %> access group<%= if @group_count != 1, do: "s" %>
        </li>
      </ul>
    </.link>
  </div>

  <%# ── Zone 3: Recent activity feed ─────────────────────────────
  %# Last 8 audit events. Click row → audit log page; click "View
  %# all" → audit log full table. We deliberately do NOT inline
  %# the diff viewer here — it'd compete for vertical space with
  %# the rest of the dashboard.
  %# %>
  <div class="ng-detail-card">
    <div class="ng-detail-card-header">
      <span class="ng-section-header" style="margin:0">
        <i class="mdi mdi-history"></i> Recent activity
      </span>
      <.link navigate={~p"/settings/audit_log"} class="ng-section-link">
        View full audit log <i class="mdi mdi-arrow-right"></i>
      </.link>
    </div>

    <%= if @recent_audit == [] do %>
      <div style="padding: 1.25rem 1.5rem;">
        <p class="ng-td-muted" style="margin:0;">
          <i class="mdi mdi-information-outline"></i>
          No audit events yet — admin actions land here as you configure the system.
        </p>
      </div>
    <% else %>
      <ul class="ng-activity-feed">
        <%= for log <- @recent_audit do %>
          <li class="ng-activity-row">
            <span class="ng-activity-time" title={DateTime.to_iso8601(log.inserted_at)}>
              <%= FzHttpWeb.DashboardLive.Index.relative_time(log.inserted_at) %>
            </span>
            <span class={["ng-action-badge", "ng-action-badge--#{FzHttpWeb.DashboardLive.Index.action_category(log.action)}"]}>
              <%= FzHttpWeb.DashboardLive.Index.short_action(log.action) %>
            </span>
            <span class="ng-activity-target">
              <%= cond do
                    log.target_label && log.target_label != "" -> log.target_label
                    log.target_type                            -> log.target_type
                    true                                        -> "—"
                  end %>
            </span>
            <span class="ng-activity-actor">
              <%= log.actor_email || "system" %>
            </span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <%# ── Zone 4 + Zone 5 — side-by-side on desktop, stack on mobile ─
  %# Zone 4 = always-visible compliance scorecard (different from
  %# the hero alerts: shows passes too, so admins get confidence
  %# the baseline is met).
  %# Zone 5 = live VPN sessions — who's connected RIGHT NOW.
  %# %>
  <div class="ng-dashboard-bottom-grid">

    <%# ── Zone 4: Security compliance ─────────────────────────── %>
    <div class="ng-detail-card">
      <div class="ng-detail-card-header">
        <span class="ng-section-header" style="margin:0">
          <i class="mdi mdi-clipboard-check-outline"></i> Security compliance
        </span>
        <.link navigate={~p"/settings/security"} class="ng-section-link">
          Configure <i class="mdi mdi-arrow-right"></i>
        </.link>
      </div>
      <ul class="ng-compliance-list">
        <%= for row <- @compliance do %>
          <li class={["ng-compliance-row",
                      FzHttpWeb.DashboardLive.Index.compliance_status_class(row.status)]}>
            <i class={["mdi", FzHttpWeb.DashboardLive.Index.compliance_status_icon(row.status),
                       "ng-compliance-row-icon"]}></i>
            <div class="ng-compliance-row-text">
              <div class="ng-compliance-row-label"><%= row.label %></div>
              <div class="ng-compliance-row-detail"><%= row.detail %></div>
            </div>
            <span class={["ng-compliance-row-badge",
                          "ng-compliance-row-badge--#{row.status}"]}>
              <%= FzHttpWeb.DashboardLive.Index.compliance_status_label(row.status) %>
            </span>
          </li>
        <% end %>
      </ul>
    </div>

    <%# ── Zone 5: Live VPN sessions ───────────────────────────── %>
    <div class="ng-detail-card">
      <div class="ng-detail-card-header">
        <span class="ng-section-header" style="margin:0">
          <i class="mdi mdi-vpn"></i> Live VPN sessions
          <span class="ng-section-badge"><%= length(@live_sessions) %></span>
        </span>
        <.link navigate={~p"/devices"} class="ng-section-link">
          All devices <i class="mdi mdi-arrow-right"></i>
        </.link>
      </div>

      <%= if @live_sessions == [] do %>
        <div style="padding: 1.25rem 1.5rem;">
          <p class="ng-td-muted" style="margin:0;">
            <i class="mdi mdi-information-outline"></i>
            No devices connected in the last 3 minutes.
          </p>
        </div>
      <% else %>
        <ul class="ng-live-sessions">
          <%= for device <- @live_sessions do %>
            <li class="ng-live-session-row">
              <span class="ng-live-session-dot" title="Active in last 3 minutes"></span>
              <div class="ng-live-session-info">
                <.link navigate={~p"/devices/#{device}"} class="ng-live-session-device">
                  <%= device.name %>
                </.link>
                <span class="ng-live-session-user">
                  <%= if device.user, do: device.user.email, else: "—" %>
                </span>
              </div>
              <span class="ng-live-session-meta">
                <code><%= device.ipv4 %></code>
                <span class="ng-live-session-when">
                  <%= FzHttpWeb.DashboardLive.Index.relative_time(device.latest_handshake) %>
                </span>
              </span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>
</section>
