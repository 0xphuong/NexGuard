<div class="ng-page-header">
  <div class="ng-page-header-inner">
    <div>
      <h1 class="ng-page-title">Egress Rules</h1>
      <p class="ng-page-subtitle">Firewall rules applied to the kernel's forward chain</p>
    </div>
  </div>
</div>

<section class="section is-main-section">
  <%= render(FzHttpWeb.SharedView, "flash.html", assigns) %>

  <div class="ng-info-banner">
    <i class="mdi mdi-information-outline"></i>
    Rules apply to all devices by default. User-scoped rules apply only to devices belonging to that particular user.
  </div>

  <div class="ng-rules-grid">
    <div>
      <%= live_component(
        FzHttpWeb.RuleLive.RuleListComponent,
        title: "Allowlist",
        header_icon: "mdi mdi-check-circle-outline",
        id: :allowlist,
        subject: @subject,
        remote_ip: @remote_ip
      ) %>
    </div>
    <div>
      <%= live_component(
        FzHttpWeb.RuleLive.RuleListComponent,
        title: "Denylist",
        header_icon: "mdi mdi-cancel",
        id: :denylist,
        subject: @subject,
        remote_ip: @remote_ip
      ) %>
    </div>
  </div>
</section>
