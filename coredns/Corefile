# NexGuard L7 ZTNA CoreDNS configuration (ADR-012).
#
# Resolution order for VPN clients pointing their DNS at the gateway:
#   1. Declared L7 application hostnames → VIP from the hosts file
#      generated by `FzHttp.L7.CoreDnsHosts` (1 s reload, ttl 30 s).
#   2. Everything else → forwarded to the operator's upstream DNS
#      via the COREDNS_FORWARD_TO env var (typically the internal
#      DNS, e.g. 10.0.235.250 — set in .env). The internal resolver
#      handles other internal names AND forwards public queries
#      upstream, so VPN clients keep working for both worlds.
#
# Bind to all interfaces inside the shared nexguard net namespace
# so the wg-nexguard tunnel sees us (VPN clients send DNS queries
# to the gateway's WG-side IP).

. {
  hosts /etc/nexguard/internal-hosts {
    reload 1s
    ttl 30
    fallthrough
  }
  forward . {$COREDNS_FORWARD_TO} {
    max_concurrent 1000
  }
  cache 30
  errors
  log . "{remote}:{port} {>id} {type} {name} -> {rcode} {>rflags} {rsize} {duration}"
}
